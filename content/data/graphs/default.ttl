	<http://www.w3.org/2004/02/skos/core#definition> "classifier for various roles that are relevant to how the contract is processed by a particular contract party" ;
	<https://www.omg.org/spec/Commons/AnnotationVocabulary/abbreviation> "CNTRL" ;
	<https://www.omg.org/spec/Commons/AnnotationVocabulary/synonym> "Contract Role" , "contractRole" .

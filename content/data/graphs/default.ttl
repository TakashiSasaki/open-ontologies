	<http://www.w3.org/2000/01/rdf-schema#subPropertyOf> <https://www.omg.org/spec/Commons/PartiesAndSituations/experiencesDirectly> ;
	<http://www.w3.org/2004/02/skos/core#definition> "indicates something that someone owns" .
<https://spec.edmcouncil.org/fibo/ontology/FND/OwnershipAndControl/Ownership/isOwningParty> a <http://www.w3.org/2002/07/owl#ObjectProperty> ;
	<http://www.w3.org/2000/01/rdf-schema#domain> <https://spec.edmcouncil.org/fibo/ontology/FND/OwnershipAndControl/Ownership/Owner> ;
	<http://www.w3.org/2000/01/rdf-schema#label> "is owning party" ;
	<http://www.w3.org/2000/01/rdf-schema#range> <https://spec.edmcouncil.org/fibo/ontology/FND/OwnershipAndControl/Ownership/Ownership> ;
	<http://www.w3.org/2000/01/rdf-schema#subPropertyOf> <https://www.omg.org/spec/Commons/PartiesAndSituations/actsIn> ;
	<http://www.w3.org/2004/02/skos/core#definition> "indicates the context of ownership in which the party plays the role of owner" .
<https://spec.edmcouncil.org/fibo/ontology/FND/OwnershipAndControl/Ownership/owns> a <http://www.w3.org/2002/07/owl#ObjectProperty> ;
	<http://www.w3.org/2000/01/rdf-schema#domain> <https://www.omg.org/spec/Commons/PartiesAndSituations/Party> ;
	<http://www.w3.org/2000/01/rdf-schema#label> "owns" ;
	<http://www.w3.org/2000/01/rdf-schema#subPropertyOf> <https://www.omg.org/spec/Commons/PartiesAndSituations/playsActiveRoleThatDirectlyAffects> ;
	<http://www.w3.org/2004/02/skos/core#definition> "indicates something that a party holds title to and may possess" .

	<http://www.w3.org/2004/02/skos/core#definition> "a system for allocating identifiers to objects" .
<https://www.omg.org/spec/LCC/Languages/LanguageRepresentation/Identifier> <http://purl.org/dc/terms/source> "ISO/IEC 11179-3 Information technology - Metadata registries (MDR) - Part 3: Registry metamodel and basic attributes, Third edition, 2013-02-15" ;
	a <http://www.w3.org/2002/07/owl#Class> ;
	<http://www.w3.org/2000/01/rdf-schema#isDefinedBy> <https://www.omg.org/spec/LCC/Languages/LanguageRepresentation/> ;
	<http://www.w3.org/2000/01/rdf-schema#label> "identifier" ;
	<http://www.w3.org/2000/01/rdf-schema#subClassOf> _:c14n1273 , _:c14n1460 , _:c14n1601 ;
	<http://www.w3.org/2004/02/skos/core#definition> "a sequence of characters uniquely identifying something that it is associated with for some purpose and within a specified context" ;
	<http://www.w3.org/2004/02/skos/core#note> "Text-valued tags are included here as they may be useful for automated transformation or encoding systems, such as those used to produce IETF compliant language tags in XML." .
<https://www.omg.org/spec/LCC/Languages/LanguageRepresentation/IndividualLanguage> <http://purl.org/dc/terms/source> "Section 3.7, ISO 639-4" ;
	a <http://www.w3.org/2002/07/owl#Class> ;
	<http://www.w3.org/2000/01/rdf-schema#isDefinedBy> <https://www.omg.org/spec/LCC/Languages/LanguageRepresentation/> ;
	<http://www.w3.org/2000/01/rdf-schema#label> "individual language" ;
	<http://www.w3.org/2000/01/rdf-schema#subClassOf> <https://www.omg.org/spec/LCC/Languages/LanguageRepresentation/Language> ;
	<http://www.w3.org/2004/02/skos/core#definition> "a language that can be distinguished from another language by some set of rules" ;
	<http://www.w3.org/2004/02/skos/core#note> "Identifiers in Parts 1, 2, and 3 of ISO 639 are assumed to denote distinct individual languages, unless the language name explicitly refers to a language group.  See section 4.2 in ISO 639-4 for a detailed explanation of the definition of individual language in the context of the ISO 639 standard." .
<https://www.omg.org/spec/LCC/Languages/LanguageRepresentation/IndividualLanguageIdentifier> <http://purl.org/dc/terms/source> "Section 3.7, ISO 639-3" ;
	a <http://www.w3.org/2002/07/owl#Class> ;
	<http://www.w3.org/2000/01/rdf-schema#isDefinedBy> <https://www.omg.org/spec/LCC/Languages/LanguageRepresentation/> ;
	<http://www.w3.org/2000/01/rdf-schema#label> "individual language identifier" ;
	<http://www.w3.org/2000/01/rdf-schema#subClassOf> <https://www.omg.org/spec/LCC/Languages/LanguageRepresentation/LanguageIdentifier> , _:c14n2167 , _:c14n273 ;
	<http://www.w3.org/2002/07/owl#disjointWith> <https://www.omg.org/spec/LCC/Languages/LanguageRepresentation/MacrolanguageIdentifier> ;
	<http://www.w3.org/2004/02/skos/core#definition> "a language identifier whose scope is that of an individual (distinct) language" .
<https://www.omg.org/spec/LCC/Languages/LanguageRepresentation/Language> <http://purl.org/dc/terms/source> "Section 3.6, ISO 639-4" ;
	a <http://www.w3.org/2002/07/owl#Class> ;
	<http://www.w3.org/2000/01/rdf-schema#isDefinedBy> <https://www.omg.org/spec/LCC/Languages/LanguageRepresentation/> ;
	<http://www.w3.org/2000/01/rdf-schema#label> "language" ;

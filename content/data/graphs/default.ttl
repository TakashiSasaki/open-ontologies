	<https://www.omg.org/spec/Commons/Classifiers/isClassifiedBy> <https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSContractTerms/ACTUSContractTermGroup-ContractIdentification> ;
	<https://www.omg.org/spec/Commons/Designators/hasDescription> "A structure identifying individual or sets of underlying contracts. E.g. for FUTUR, this structure identifies the single underlying contract, for SWAPS, the FirstLeg and SecondLeg are identified, or for CEG, CEC the structure identifies Covered and Covering contracts." ;
	<https://www.omg.org/spec/Commons/Designators/hasTag> "CTS" ;
	<https://www.omg.org/spec/Commons/Designators/hasTextualName> "Contract Structure" .
<https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSContractTerms/ACTUSContractTerm-CUR2> a <http://www.w3.org/2002/07/owl#NamedIndividual> , <https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSContractTerms/ACTUSContractTerm> ;
	<http://www.w3.org/2000/01/rdf-schema#label> "ACTUS contract term - CUR2" ;
	<https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSContractTerms/hasParameterName> "currency2" ;
	<https://www.omg.org/spec/Commons/Classifiers/isClassifiedBy> <https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSContractTerms/ACTUSContractTermGroup-NotionalPrincipal> ;
	<https://www.omg.org/spec/Commons/Designators/hasDescription> "The currency of the cash flows of the second leg (if not defined, main currency applies)" ;
	<https://www.omg.org/spec/Commons/Designators/hasTag> "CUR2" ;
	<https://www.omg.org/spec/Commons/Designators/hasTextualName> "Currency 2" .
<https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSContractTerms/ACTUSContractTerm-CUR> a <http://www.w3.org/2002/07/owl#NamedIndividual> , <https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSContractTerms/ACTUSContractTerm> ;
	<http://www.w3.org/2000/01/rdf-schema#label> "ACTUS contract term - CUR" ;
	<https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSContractTerms/hasParameterName> "currency" ;
	<https://www.omg.org/spec/Commons/Classifiers/isClassifiedBy> <https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSContractTerms/ACTUSContractTermGroup-NotionalPrincipal> ;
	<https://www.omg.org/spec/Commons/Designators/hasDescription> "The currency of the cash flows." ;
	<https://www.omg.org/spec/Commons/Designators/hasTag> "CUR" ;
	<https://www.omg.org/spec/Commons/Designators/hasTextualName> "Currency" .
<https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSContractTerms/ACTUSContractTerm-CURS> a <http://www.w3.org/2002/07/owl#NamedIndividual> , <https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSContractTerms/ACTUSContractTerm> ;
	<http://www.w3.org/2000/01/rdf-schema#label> "ACTUS contract term - CURS" ;
	<https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSContractTerms/hasParameterName> "settlementCurrency" ;
	<https://www.omg.org/spec/Commons/Classifiers/isClassifiedBy> <https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSContractTerms/ACTUSContractTermGroup-Settlement> ;
	<https://www.omg.org/spec/Commons/Designators/hasDescription> "The currency in which cash flows are settled. This currency can be different from the currency (CUR) in which cash flows or the contract, respectively, is denominated in which case the respective FX-rate applies at settlement time.\n\nIf no settlement currency is defined the cash flows are settled in the currency in which they are denominated." ;
	<https://www.omg.org/spec/Commons/Designators/hasTag> "CURS" ;
	<https://www.omg.org/spec/Commons/Designators/hasTextualName> "Settlement Currency" .
<https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSContractTerms/ACTUSContractTerm-DQP> a <http://www.w3.org/2002/07/owl#NamedIndividual> , <https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSContractTerms/ACTUSContractTerm> ;
	<http://www.w3.org/2000/01/rdf-schema#label> "ACTUS contract term - DQP" ;
	<https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSContractTerms/hasParameterName> "delinquencyPeriod" ;
	<https://www.omg.org/spec/Commons/Classifiers/isClassifiedBy> <https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSContractTerms/ACTUSContractTermGroup-Counterparty> ;
	<https://www.omg.org/spec/Commons/Designators/hasDescription> "If real payment happens after scheduled payment date plus DLP, then the counterparty is in technical default. This means that the creditor legally has the right to declare default of the debtor." ;
	<https://www.omg.org/spec/Commons/Designators/hasTag> "DQP" ;
	<https://www.omg.org/spec/Commons/Designators/hasTextualName> "Delinquency Period" .
<https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSContractTerms/ACTUSContractTerm-DQR> a <http://www.w3.org/2002/07/owl#NamedIndividual> , <https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSContractTerms/ACTUSContractTerm> ;
	<http://www.w3.org/2000/01/rdf-schema#label> "ACTUS contract term - DQR" ;
	<https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSContractTerms/hasParameterName> "delinquencyRate" ;
	<https://www.omg.org/spec/Commons/Classifiers/isClassifiedBy> <https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSContractTerms/ACTUSContractTermGroup-Counterparty> ;
	<https://www.omg.org/spec/Commons/Designators/hasDescription> "Rate at which Delinquency Payments accrue on NT (in addition to the interest rate) during the DelinquencyPeriod" ;
	<https://www.omg.org/spec/Commons/Designators/hasTag> "DQR" ;
	<https://www.omg.org/spec/Commons/Designators/hasTextualName> "Delinquency Rate" .
<https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSContractTerms/ACTUSContractTerm-DS> a <http://www.w3.org/2002/07/owl#NamedIndividual> , <https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSContractTerms/ACTUSContractTerm> ;
	<http://www.w3.org/2000/01/rdf-schema#label> "ACTUS contract term - DS" ;
	<https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSContractTerms/hasParameterName> "deliverySettlement" ;
	<https://www.omg.org/spec/Commons/Classifiers/isClassifiedBy> <https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSContractTerms/ACTUSContractTermGroup-Settlement> ;
	<https://www.omg.org/spec/Commons/Designators/hasDescription> "Indicates whether the contract is settled in cash or physical delivery.\n\nIn case of physical delivery, the underlying contract and associated (future) cash flows are effectively exchanged. In case of cash settlement, the current market value of the underlying contract determines the cash flow exchanged." ;
	<https://www.omg.org/spec/Commons/Designators/hasTag> "DS" ;
	<https://www.omg.org/spec/Commons/Designators/hasTextualName> "Delivery Settlement" .
<https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSContractTerms/ACTUSContractTerm-DVANX> a <http://www.w3.org/2002/07/owl#NamedIndividual> , <https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSContractTerms/ACTUSContractTerm> ;
	<http://www.w3.org/2000/01/rdf-schema#label> "ACTUS contract term - DVANX" ;
	<https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSContractTerms/hasParameterName> "cycleAnchorDateOfDividend" ;
	<https://www.omg.org/spec/Commons/Classifiers/isClassifiedBy> <https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSContractTerms/ACTUSContractTermGroup-Dividend> ;
	<https://www.omg.org/spec/Commons/Designators/hasDescription> "Date from which the dividend payment date schedule is calculated according to the cycle length. The first dividend payment event takes place on this anchor." ;
	<https://www.omg.org/spec/Commons/Designators/hasTag> "DVANX" ;
	<https://www.omg.org/spec/Commons/Designators/hasTextualName> "Cycle Anchor Date Of Dividend" .
<https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSContractTerms/ACTUSContractTerm-DVCL> a <http://www.w3.org/2002/07/owl#NamedIndividual> , <https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSContractTerms/ACTUSContractTerm> ;
	<http://www.w3.org/2000/01/rdf-schema#label> "ACTUS contract term - DVCL" ;
	<https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSContractTerms/hasParameterName> "cycleOfDividend" ;
	<https://www.omg.org/spec/Commons/Classifiers/isClassifiedBy> <https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSContractTerms/ACTUSContractTermGroup-Dividend> ;
	<https://www.omg.org/spec/Commons/Designators/hasDescription> "Defines in combination with DVANX the payment points of dividends. The dividend payment schedule will start at DVANX and end at MaximumProjectionPeriod (cf. sheet Modeling Parameters)." ;
	<https://www.omg.org/spec/Commons/Designators/hasTag> "DVCL" ;
	<https://www.omg.org/spec/Commons/Designators/hasTextualName> "Cycle Of Dividend" .
<https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSContractTerms/ACTUSContractTerm-DVEX> a <http://www.w3.org/2002/07/owl#NamedIndividual> , <https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSContractTerms/ACTUSContractTerm> ;
	<http://www.w3.org/2000/01/rdf-schema#label> "ACTUS contract term - DVEX" ;
	<https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSContractTerms/hasParameterName> "exDividendDate" ;
	<https://www.omg.org/spec/Commons/Classifiers/isClassifiedBy> <https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSContractTerms/ACTUSContractTermGroup-Dividend> ;
	<https://www.omg.org/spec/Commons/Designators/hasDescription> "In case contract is traded between DVEX and next DV payment date (i.e. PRD>DVEX & PRD<next DV payment date), then the old holder of the contract (previous to the trade) receives the next DV payment. In other words, the next DV payment is cancelled for the new (after the trade) holder of the contract." ;
	<https://www.omg.org/spec/Commons/Designators/hasTag> "DVEX" ;
	<https://www.omg.org/spec/Commons/Designators/hasTextualName> "Ex Dividend Date" .
<https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSContractTerms/ACTUSContractTerm-DVNP> a <http://www.w3.org/2002/07/owl#NamedIndividual> , <https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSContractTerms/ACTUSContractTerm> ;
	<http://www.w3.org/2000/01/rdf-schema#label> "ACTUS contract term - DVNP" ;
	<https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSContractTerms/hasParameterName> "nextDividendPaymentAmount" ;
	<https://www.omg.org/spec/Commons/Classifiers/isClassifiedBy> <https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSContractTerms/ACTUSContractTermGroup-Dividend> ;
	<https://www.omg.org/spec/Commons/Designators/hasDescription> "Defines the next dividend payment (amount) whereas the date of dividend payment is defined through the DVANX/DVCL pair. \n If DVCL is defined, then this amount will be used as dividend payment for each future dividend payment date." ;
	<https://www.omg.org/spec/Commons/Designators/hasTag> "DVNP" ;
	<https://www.omg.org/spec/Commons/Designators/hasTextualName> "Next Dividend Payment Amount" .
<https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSContractTerms/ACTUSContractTerm-EOMC> a <http://www.w3.org/2002/07/owl#NamedIndividual> , <https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSContractTerms/ACTUSContractTerm> ;
	<http://www.w3.org/2000/01/rdf-schema#label> "ACTUS contract term - EOMC" ;
	<https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSContractTerms/hasParameterName> "endOfMonthConvention" ;
	<https://www.omg.org/spec/Commons/Classifiers/isClassifiedBy> <https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSContractTerms/ACTUSContractTermGroup-Calendar> ;
	<https://www.omg.org/spec/Commons/Designators/hasDescription> "When computing schedules a special problem arises if an anchor date is at the end of a month and a cycle of monthly or quarterly is applied (yearly in the case of leap years only). How do we have to interpret an anchor date April 30 plus 1M cycles? In case where EOM is selected, it will jump to the 31st of May, then June 30, July 31 and so on. If SM is selected, it will jump to the 30st always with of course an exception in February. \n\nThis logic applies for all months having 30 or less days and an anchor date at the last day. Month with 31 days will at any rate jump to the last of the month if anchor date is on the last day." ;
	<https://www.omg.org/spec/Commons/Designators/hasTag> "EOMC" ;
	<https://www.omg.org/spec/Commons/Designators/hasTextualName> "End Of Month Convention" .
<https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSContractTerms/ACTUSContractTerm-FEAC> a <http://www.w3.org/2002/07/owl#NamedIndividual> , <https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSContractTerms/ACTUSContractTerm> ;
	<http://www.w3.org/2000/01/rdf-schema#label> "ACTUS contract term - FEAC" ;
	<https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSContractTerms/hasParameterName> "feeAccrued" ;
	<https://www.omg.org/spec/Commons/Classifiers/isClassifiedBy> <https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSContractTerms/ACTUSContractTermGroup-Fees> ;
	<https://www.omg.org/spec/Commons/Designators/hasDescription> "Accrued fees as per SD" ;
	<https://www.omg.org/spec/Commons/Designators/hasTag> "FEAC" ;
	<https://www.omg.org/spec/Commons/Designators/hasTextualName> "Fee Accrued" .
<https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSContractTerms/ACTUSContractTerm-FEANX> a <http://www.w3.org/2002/07/owl#NamedIndividual> , <https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSContractTerms/ACTUSContractTerm> ;
	<http://www.w3.org/2000/01/rdf-schema#label> "ACTUS contract term - FEANX" ;
	<https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSContractTerms/hasParameterName> "cycleAnchorDateOfFee" ;
	<https://www.omg.org/spec/Commons/Classifiers/isClassifiedBy> <https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSContractTerms/ACTUSContractTermGroup-Fees> ;
	<https://www.omg.org/spec/Commons/Designators/hasDescription> "Date from which the fee payment date schedule is calculated according to the cycle length. The first fee payment event takes place on this anchor." ;
	<https://www.omg.org/spec/Commons/Designators/hasTag> "FEANX" ;
	<https://www.omg.org/spec/Commons/Designators/hasTextualName> "Cycle Anchor Date Of Fee" .
<https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSContractTerms/ACTUSContractTerm-FEB> a <http://www.w3.org/2002/07/owl#NamedIndividual> , <https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSContractTerms/ACTUSContractTerm> ;
	<http://www.w3.org/2000/01/rdf-schema#label> "ACTUS contract term - FEB" ;
	<https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSContractTerms/hasParameterName> "feeBasis" ;
	<https://www.omg.org/spec/Commons/Classifiers/isClassifiedBy> <https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSContractTerms/ACTUSContractTermGroup-Fees> ;
	<https://www.omg.org/spec/Commons/Designators/hasDescription> "Basis, on which Fee is calculated. For FEB='A', FER is interpreted as an absolute amount to be paid at every FP event and for FEB='N', FER represents a rate at which FP amounts accrue on the basis of the contract's NT." ;
	<https://www.omg.org/spec/Commons/Designators/hasTag> "FEB" ;
	<https://www.omg.org/spec/Commons/Designators/hasTextualName> "Fee Basis" .
<https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSContractTerms/ACTUSContractTerm-FECL> a <http://www.w3.org/2002/07/owl#NamedIndividual> , <https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSContractTerms/ACTUSContractTerm> ;
	<http://www.w3.org/2000/01/rdf-schema#label> "ACTUS contract term - FECL" ;
	<https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSContractTerms/hasParameterName> "cycleOfFee" ;
	<https://www.omg.org/spec/Commons/Classifiers/isClassifiedBy> <https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSContractTerms/ACTUSContractTermGroup-Fees> ;
	<https://www.omg.org/spec/Commons/Designators/hasDescription> "Defines in combination with FEANX the payment points of fees" ;
	<https://www.omg.org/spec/Commons/Designators/hasTag> "FECL" ;
	<https://www.omg.org/spec/Commons/Designators/hasTextualName> "Cycle Of Fee" .
<https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSContractTerms/ACTUSContractTerm-FER> a <http://www.w3.org/2002/07/owl#NamedIndividual> , <https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSContractTerms/ACTUSContractTerm> ;
	<http://www.w3.org/2000/01/rdf-schema#label> "ACTUS contract term - FER" ;
	<https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSContractTerms/hasParameterName> "feeRate" ;
	<https://www.omg.org/spec/Commons/Classifiers/isClassifiedBy> <https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSContractTerms/ACTUSContractTermGroup-Fees> ;
	<https://www.omg.org/spec/Commons/Designators/hasDescription> "Rate of Fee which is a percentage of the underlying or FER is an absolute amount. For all contracts where FEB does not apply (cf. business rules), FER is interpreted as an absolute amount." ;
	<https://www.omg.org/spec/Commons/Designators/hasTag> "FER" ;
	<https://www.omg.org/spec/Commons/Designators/hasTextualName> "Fee Rate" .
<https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSContractTerms/ACTUSContractTerm-GRP> a <http://www.w3.org/2002/07/owl#NamedIndividual> , <https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSContractTerms/ACTUSContractTerm> ;
	<http://www.w3.org/2000/01/rdf-schema#label> "ACTUS contract term - GRP" ;
	<https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSContractTerms/hasParameterName> "gracePeriod" ;
	<https://www.omg.org/spec/Commons/Classifiers/isClassifiedBy> <https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSContractTerms/ACTUSContractTermGroup-Counterparty> ;
	<https://www.omg.org/spec/Commons/Designators/hasDescription> "If real payment happens after scheduled payment date plus GRP, then the payment is in delay." ;
	<https://www.omg.org/spec/Commons/Designators/hasTag> "GRP" ;
	<https://www.omg.org/spec/Commons/Designators/hasTextualName> "Grace Period" .
<https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSContractTerms/ACTUSContractTerm-IED> a <http://www.w3.org/2002/07/owl#NamedIndividual> , <https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSContractTerms/ACTUSContractTerm> ;
	<http://www.w3.org/2000/01/rdf-schema#label> "ACTUS contract term - IED" ;
	<https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSContractTerms/hasParameterName> "initialExchangeDate" ;
	<https://www.omg.org/spec/Commons/Classifiers/isClassifiedBy> <https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSContractTerms/ACTUSContractTermGroup-NotionalPrincipal> ;
	<https://www.omg.org/spec/Commons/Designators/hasDescription> "Date of the initial cash flow for Maturity and Non-Maturity CT's. It also coincides with the beginning of interest accrual calculation." ;
	<https://www.omg.org/spec/Commons/Designators/hasTag> "IED" ;
	<https://www.omg.org/spec/Commons/Designators/hasTextualName> "Initial Exchange Date" .
<https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSContractTerms/ACTUSContractTerm-IPAC> a <http://www.w3.org/2002/07/owl#NamedIndividual> , <https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSContractTerms/ACTUSContractTerm> ;
	<http://www.w3.org/2000/01/rdf-schema#label> "ACTUS contract term - IPAC" ;
	<https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSContractTerms/hasParameterName> "accruedInterest" ;
	<https://www.omg.org/spec/Commons/Classifiers/isClassifiedBy> <https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSContractTerms/ACTUSContractTermGroup-Interest> ;
	<https://www.omg.org/spec/Commons/Designators/hasDescription> "Accrued interest as per SD. In case of NULL, this value will be recalculated using IPANX, IPCL and IPNR information. Can be used to represent irregular next IP payments." ;
	<https://www.omg.org/spec/Commons/Designators/hasTag> "IPAC" ;
	<https://www.omg.org/spec/Commons/Designators/hasTextualName> "Accrued Interest" .
<https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSContractTerms/ACTUSContractTerm-IPANX> a <http://www.w3.org/2002/07/owl#NamedIndividual> , <https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSContractTerms/ACTUSContractTerm> ;
	<http://www.w3.org/2000/01/rdf-schema#label> "ACTUS contract term - IPANX" ;
	<https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSContractTerms/hasParameterName> "cycleAnchorDateOfInterestPayment" ;
	<https://www.omg.org/spec/Commons/Classifiers/isClassifiedBy> <https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSContractTerms/ACTUSContractTermGroup-Interest> ;
	<https://www.omg.org/spec/Commons/Designators/hasDescription> "Date from which the interest payment date schedule is calculated according to the cycle length. The first interest payment event takes place on this anchor." ;
	<https://www.omg.org/spec/Commons/Designators/hasTag> "IPANX" ;
	<https://www.omg.org/spec/Commons/Designators/hasTextualName> "Cycle Anchor Date Of Interest Payment" .
<https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSContractTerms/ACTUSContractTerm-IPCB> a <http://www.w3.org/2002/07/owl#NamedIndividual> , <https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSContractTerms/ACTUSContractTerm> ;
	<http://www.w3.org/2000/01/rdf-schema#label> "ACTUS contract term - IPCB" ;
	<https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSContractTerms/hasParameterName> "interestCalculationBase" ;
	<https://www.omg.org/spec/Commons/Classifiers/isClassifiedBy> <https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSContractTerms/ACTUSContractTermGroup-Interest> ;
	<https://www.omg.org/spec/Commons/Designators/hasDescription> "This is important for amortizing instruments. The basis of interest calculation is normally the notional outstanding amount as per SD. This is considered the fair basis and in many countries the only legal basis. If NULL or NTSD is selected, this is the case. \n\nAlternative bases (normally in order to favor the lending institution) are found. In the extreme case the original balance (PCDD=NT+PDCDD) never gets adjusted. In this case PCDD must be chosen. \n\nAn intermediate case exist wherre balances do get adjusted, however with lags. In this case NTL mut be selected and anchor dates and cycles must be set." ;
	<https://www.omg.org/spec/Commons/Designators/hasTag> "IPCB" ;
	<https://www.omg.org/spec/Commons/Designators/hasTextualName> "Interest Calculation Base" .
<https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSContractTerms/ACTUSContractTerm-IPCBA> a <http://www.w3.org/2002/07/owl#NamedIndividual> , <https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSContractTerms/ACTUSContractTerm> ;
	<http://www.w3.org/2000/01/rdf-schema#label> "ACTUS contract term - IPCBA" ;
	<https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSContractTerms/hasParameterName> "interestCalculationBaseAmount" ;
	<https://www.omg.org/spec/Commons/Classifiers/isClassifiedBy> <https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSContractTerms/ACTUSContractTermGroup-Interest> ;
	<https://www.omg.org/spec/Commons/Designators/hasDescription> "This is the amount used for the calculation of interest. Calculation base per SD." ;
	<https://www.omg.org/spec/Commons/Designators/hasTag> "IPCBA" ;
	<https://www.omg.org/spec/Commons/Designators/hasTextualName> "Interest Calculation Base Amount" .
<https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSContractTerms/ACTUSContractTerm-IPCBANX> a <http://www.w3.org/2002/07/owl#NamedIndividual> , <https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSContractTerms/ACTUSContractTerm> ;
	<http://www.w3.org/2000/01/rdf-schema#label> "ACTUS contract term - IPCBANX" ;
	<https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSContractTerms/hasParameterName> "cycleAnchorDateOfInterestCalculationBase" ;
	<https://www.omg.org/spec/Commons/Classifiers/isClassifiedBy> <https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSContractTerms/ACTUSContractTermGroup-Interest> ;
	<https://www.omg.org/spec/Commons/Designators/hasDescription> "Date from which the interest calculation base date schedule is calculated according to the cycle length. The first interest calculation base event takes place on this anchor." ;
	<https://www.omg.org/spec/Commons/Designators/hasTag> "IPCBANX" ;
	<https://www.omg.org/spec/Commons/Designators/hasTextualName> "Cycle Anchor Date Of Interest Calculation Base" .
<https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSContractTerms/ACTUSContractTerm-IPCBCL> a <http://www.w3.org/2002/07/owl#NamedIndividual> , <https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSContractTerms/ACTUSContractTerm> ;
	<http://www.w3.org/2000/01/rdf-schema#label> "ACTUS contract term - IPCBCL" ;
	<https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSContractTerms/hasParameterName> "cycleOfInterestCalculationBase" ;
	<https://www.omg.org/spec/Commons/Classifiers/isClassifiedBy> <https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSContractTerms/ACTUSContractTermGroup-Interest> ;
	<https://www.omg.org/spec/Commons/Designators/hasDescription> "Concerning the format see PRCL. \n\nDefines the subsequent adjustment points to NT of the interest payment calculation base." ;
	<https://www.omg.org/spec/Commons/Designators/hasTag> "IPCBCL" ;
	<https://www.omg.org/spec/Commons/Designators/hasTextualName> "Cycle Of Interest Calculation Base" .
<https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSContractTerms/ACTUSContractTerm-IPCED> a <http://www.w3.org/2002/07/owl#NamedIndividual> , <https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSContractTerms/ACTUSContractTerm> ;
	<http://www.w3.org/2000/01/rdf-schema#label> "ACTUS contract term - IPCED" ;
	<https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSContractTerms/hasParameterName> "capitalizationEndDate" ;
	<https://www.omg.org/spec/Commons/Classifiers/isClassifiedBy> <https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSContractTerms/ACTUSContractTermGroup-Interest> ;
	<https://www.omg.org/spec/Commons/Designators/hasDescription> "If IPCED is set, then interest is not paid or received but added to the balance (NT) until IPCED. If IPCED does not coincide with an IP cycle, one additional interest payment gets calculated at IPCED and capitalized. Thereafter normal interest payments occur." ;
	<https://www.omg.org/spec/Commons/Designators/hasTag> "IPCED" ;
	<https://www.omg.org/spec/Commons/Designators/hasTextualName> "Capitalization End Date" .
<https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSContractTerms/ACTUSContractTerm-IPCL> a <http://www.w3.org/2002/07/owl#NamedIndividual> , <https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSContractTerms/ACTUSContractTerm> ;
	<http://www.w3.org/2000/01/rdf-schema#label> "ACTUS contract term - IPCL" ;
	<https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSContractTerms/hasParameterName> "cycleOfInterestPayment" ;
	<https://www.omg.org/spec/Commons/Classifiers/isClassifiedBy> <https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSContractTerms/ACTUSContractTermGroup-Interest> ;
	<https://www.omg.org/spec/Commons/Designators/hasDescription> "Cycle according to which the interest payment date schedule will be calculated.\n\nIn case IPCL is not set, then there will only be an interest payment event at MD (and possibly at IPANX if set).\n\nThe interval will be adjusted yet by EOMC and BDC." ;
	<https://www.omg.org/spec/Commons/Designators/hasTag> "IPCL" ;
	<https://www.omg.org/spec/Commons/Designators/hasTextualName> "Cycle Of Interest Payment" .
<https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSContractTerms/ACTUSContractTerm-IPDC> a <http://www.w3.org/2002/07/owl#NamedIndividual> , <https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSContractTerms/ACTUSContractTerm> ;
	<http://www.w3.org/2000/01/rdf-schema#label> "ACTUS contract term - IPDC" ;
	<https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSContractTerms/hasParameterName> "dayCountConvention" ;
	<https://www.omg.org/spec/Commons/Classifiers/isClassifiedBy> <https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSContractTerms/ACTUSContractTermGroup-Interest> ;
	<https://www.omg.org/spec/Commons/Designators/hasDescription> "Method defining how days are counted between two dates. This finally defines the year fraction in accrual calculations." ;
	<https://www.omg.org/spec/Commons/Designators/hasTag> "IPDC" ;
	<https://www.omg.org/spec/Commons/Designators/hasTextualName> "Day Count Convention" .
<https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSContractTerms/ACTUSContractTerm-IPNR2> a <http://www.w3.org/2002/07/owl#NamedIndividual> , <https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSContractTerms/ACTUSContractTerm> ;
	<http://www.w3.org/2000/01/rdf-schema#label> "ACTUS contract term - IPNR2" ;
	<https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSContractTerms/hasParameterName> "nominalInterestRate2" ;
	<https://www.omg.org/spec/Commons/Classifiers/isClassifiedBy> <https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSContractTerms/ACTUSContractTermGroup-Interest> ;
	<https://www.omg.org/spec/Commons/Designators/hasDescription> "The nominal interest rate which will be used to calculate accruals and the next interest payment at the next IP date on the second leg (the one not mentioned in CNTRL) of a plain vanilla swap. The relevant time period is a function of IPDC. \n\nIt is periodically updated per SD." ;
	<https://www.omg.org/spec/Commons/Designators/hasTag> "IPNR2" ;
	<https://www.omg.org/spec/Commons/Designators/hasTextualName> "Nominal Interest Rate 2" .
<https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSContractTerms/ACTUSContractTerm-IPNR> a <http://www.w3.org/2002/07/owl#NamedIndividual> , <https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSContractTerms/ACTUSContractTerm> ;
	<http://www.w3.org/2000/01/rdf-schema#label> "ACTUS contract term - IPNR" ;
	<https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSContractTerms/hasParameterName> "nominalInterestRate" ;
	<https://www.omg.org/spec/Commons/Classifiers/isClassifiedBy> <https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSContractTerms/ACTUSContractTermGroup-Interest> ;
	<https://www.omg.org/spec/Commons/Designators/hasDescription> "The nominal interest rate which will be used to calculate accruals and the next interest payment at the next IP date. NT multiplied with IPNR is the base for the interest payment calculation. The relevant time period is a function of IPDC. \n\nIf the contract is variable (RRANX set) this field is periodically updated per SD. \n\nIn the case of plan vanilla interest rate swaps (IRSPV) this defines the rate of fixed leg." ;
	<https://www.omg.org/spec/Commons/Designators/hasTag> "IPNR" ;
	<https://www.omg.org/spec/Commons/Designators/hasTextualName> "Nominal Interest Rate" .
<https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSContractTerms/ACTUSContractTerm-IPPNT> a <http://www.w3.org/2002/07/owl#NamedIndividual> , <https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSContractTerms/ACTUSContractTerm> ;
	<http://www.w3.org/2000/01/rdf-schema#label> "ACTUS contract term - IPPNT" ;
	<https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSContractTerms/hasParameterName> "cyclePointOfInterestPayment" ;
	<https://www.omg.org/spec/Commons/Classifiers/isClassifiedBy> <https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSContractTerms/ACTUSContractTermGroup-Interest> ;
	<https://www.omg.org/spec/Commons/Designators/hasDescription> "Usually, interest is paid at the end of each IPCL which corresponds to a IPPNT value of E which is also the default. If interest payment occurs at the beginning of the cycle, the value is B." ;
	<https://www.omg.org/spec/Commons/Designators/hasTag> "IPPNT" ;
	<https://www.omg.org/spec/Commons/Designators/hasTextualName> "Cycle Point Of Interest Payment" .
<https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSContractTerms/ACTUSContractTerm-MD> a <http://www.w3.org/2002/07/owl#NamedIndividual> , <https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSContractTerms/ACTUSContractTerm> ;
	<http://www.w3.org/2000/01/rdf-schema#label> "ACTUS contract term - MD" ;
	<https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSContractTerms/hasParameterName> "maturityDate" ;
	<https://www.omg.org/spec/Commons/Classifiers/isClassifiedBy> <https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSContractTerms/ACTUSContractTermGroup-NotionalPrincipal> ;
	<https://www.omg.org/spec/Commons/Designators/hasDescription> "Marks the contractual end of the lifecycle of a CT. Generally, date of the last cash flows. \n\nThis includes normally a principal and an interest payment. Some Maturity CTs as perpetuals (PBN) do not have such a date. For variable amortizing contracts of the ANN CT, this date might be less than the scheduled end of the contract (which is deduced from the periodic payment amount \n\nPRNXT). In this case it balloons." ;
	<https://www.omg.org/spec/Commons/Designators/hasTag> "MD" ;
	<https://www.omg.org/spec/Commons/Designators/hasTextualName> "Maturity Date" .
<https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSContractTerms/ACTUSContractTerm-MOC> a <http://www.w3.org/2002/07/owl#NamedIndividual> , <https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSContractTerms/ACTUSContractTerm> ;
	<http://www.w3.org/2000/01/rdf-schema#label> "ACTUS contract term - MOC" ;
	<https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSContractTerms/hasParameterName> "marketObjectCode" ;
	<https://www.omg.org/spec/Commons/Classifiers/isClassifiedBy> <https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSContractTerms/ACTUSContractTermGroup-ContractIdentification> ;
	<https://www.omg.org/spec/Commons/Designators/hasDescription> "Is pointing to the market value at SD (MarketObject).\n\nUnique codes for market objects must be used." ;
	<https://www.omg.org/spec/Commons/Designators/hasTag> "MOC" ;
	<https://www.omg.org/spec/Commons/Designators/hasTextualName> "Market Object Code" .
<https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSContractTerms/ACTUSContractTerm-MPFD> a <http://www.w3.org/2002/07/owl#NamedIndividual> , <https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSContractTerms/ACTUSContractTerm> ;
	<http://www.w3.org/2000/01/rdf-schema#label> "ACTUS contract term - MPFD" ;
	<https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSContractTerms/hasParameterName> "maximumPenaltyFreeDisbursement" ;
	<https://www.omg.org/spec/Commons/Classifiers/isClassifiedBy> <https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSContractTerms/ACTUSContractTermGroup-Optionality> ;
	<https://www.omg.org/spec/Commons/Designators/hasDescription> "Defines the notional amount which can be withdrawn before XDN without penalty" ;
	<https://www.omg.org/spec/Commons/Designators/hasTag> "MPFD" ;
	<https://www.omg.org/spec/Commons/Designators/hasTextualName> "Maximum Penalty Free Disbursement" .
<https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSContractTerms/ACTUSContractTerm-MRANX> a <http://www.w3.org/2002/07/owl#NamedIndividual> , <https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSContractTerms/ACTUSContractTerm> ;
	<http://www.w3.org/2000/01/rdf-schema#label> "ACTUS contract term - MRANX" ;
	<https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSContractTerms/hasParameterName> "cycleAnchorDateOfMargining" ;
	<https://www.omg.org/spec/Commons/Classifiers/isClassifiedBy> <https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSContractTerms/ACTUSContractTermGroup-Margining> ;
	<https://www.omg.org/spec/Commons/Designators/hasDescription> "Date from which the margin call date schedule is calculated according to the cycle length. The first margin call event takes place on this anchor." ;
	<https://www.omg.org/spec/Commons/Designators/hasTag> "MRANX" ;
	<https://www.omg.org/spec/Commons/Designators/hasTextualName> "Cycle Anchor Date Of Margining" .
<https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSContractTerms/ACTUSContractTerm-MRCL> a <http://www.w3.org/2002/07/owl#NamedIndividual> , <https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSContractTerms/ACTUSContractTerm> ;
	<http://www.w3.org/2000/01/rdf-schema#label> "ACTUS contract term - MRCL" ;
	<https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSContractTerms/hasParameterName> "cycleOfMargining" ;
	<https://www.omg.org/spec/Commons/Classifiers/isClassifiedBy> <https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSContractTerms/ACTUSContractTermGroup-Margining> ;
	<https://www.omg.org/spec/Commons/Designators/hasDescription> "Defines together with MRANX the points where margins can be called." ;
	<https://www.omg.org/spec/Commons/Designators/hasTag> "MRCL" ;
	<https://www.omg.org/spec/Commons/Designators/hasTextualName> "Cycle Of Margining" .
<https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSContractTerms/ACTUSContractTerm-MRCLH> a <http://www.w3.org/2002/07/owl#NamedIndividual> , <https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSContractTerms/ACTUSContractTerm> ;
	<http://www.w3.org/2000/01/rdf-schema#label> "ACTUS contract term - MRCLH" ;
	<https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSContractTerms/hasParameterName> "clearingHouse" ;
	<https://www.omg.org/spec/Commons/Classifiers/isClassifiedBy> <https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSContractTerms/ACTUSContractTermGroup-Margining> ;
	<https://www.omg.org/spec/Commons/Designators/hasDescription> "Indicates wheter CRID takes a clearing house function or not. In other word, whether CRID receive margins (MRIM, MRVM)." ;
	<https://www.omg.org/spec/Commons/Designators/hasTag> "MRCLH" ;
	<https://www.omg.org/spec/Commons/Designators/hasTextualName> "Clearing House" .
<https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSContractTerms/ACTUSContractTerm-MRIM> a <http://www.w3.org/2002/07/owl#NamedIndividual> , <https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSContractTerms/ACTUSContractTerm> ;
	<http://www.w3.org/2000/01/rdf-schema#label> "ACTUS contract term - MRIM" ;
	<https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSContractTerms/hasParameterName> "initialMargin" ;
	<https://www.omg.org/spec/Commons/Classifiers/isClassifiedBy> <https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSContractTerms/ACTUSContractTermGroup-Margining> ;
	<https://www.omg.org/spec/Commons/Designators/hasDescription> "Margin to cover losses which may be incurred as a result of market fluctuations. \n\nUpon contract closing or maturity, the MRIM is reimbursed." ;
	<https://www.omg.org/spec/Commons/Designators/hasTag> "MRIM" ;
	<https://www.omg.org/spec/Commons/Designators/hasTextualName> "Initial Margin" .
<https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSContractTerms/ACTUSContractTerm-MRMML> a <http://www.w3.org/2002/07/owl#NamedIndividual> , <https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSContractTerms/ACTUSContractTerm> ;
	<http://www.w3.org/2000/01/rdf-schema#label> "ACTUS contract term - MRMML" ;
	<https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSContractTerms/hasParameterName> "maintenanceMarginLowerBound" ;
	<https://www.omg.org/spec/Commons/Classifiers/isClassifiedBy> <https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSContractTerms/ACTUSContractTermGroup-Margining> ;
	<https://www.omg.org/spec/Commons/Designators/hasDescription> "Defines the lower bound of the Maintenance Margin. If MRVM falls below MRMML, then capital must be added to reach the original MRIM." ;
	<https://www.omg.org/spec/Commons/Designators/hasTag> "MRMML" ;
	<https://www.omg.org/spec/Commons/Designators/hasTextualName> "Maintenance Margin Lower Bound" .
<https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSContractTerms/ACTUSContractTerm-MRMMU> a <http://www.w3.org/2002/07/owl#NamedIndividual> , <https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSContractTerms/ACTUSContractTerm> ;
	<http://www.w3.org/2000/01/rdf-schema#label> "ACTUS contract term - MRMMU" ;
	<https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSContractTerms/hasParameterName> "maintenanceMarginUpperBound" ;
	<https://www.omg.org/spec/Commons/Classifiers/isClassifiedBy> <https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSContractTerms/ACTUSContractTermGroup-Margining> ;
	<https://www.omg.org/spec/Commons/Designators/hasDescription> "Defines the upper bound of the Maintenance Margin. If MRVM falls above MRMMU, then capital is refunded to reach the original MRIM." ;
	<https://www.omg.org/spec/Commons/Designators/hasTag> "MRMMU" ;
	<https://www.omg.org/spec/Commons/Designators/hasTextualName> "Maintenance Margin Upper Bound" .
<https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSContractTerms/ACTUSContractTerm-MRVM> a <http://www.w3.org/2002/07/owl#NamedIndividual> , <https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSContractTerms/ACTUSContractTerm> ;
	<http://www.w3.org/2000/01/rdf-schema#label> "ACTUS contract term - MRVM" ;
	<https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSContractTerms/hasParameterName> "variationMargin" ;
	<https://www.omg.org/spec/Commons/Classifiers/isClassifiedBy> <https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSContractTerms/ACTUSContractTermGroup-Margining> ;
	<https://www.omg.org/spec/Commons/Designators/hasDescription> "MRVM reflects the accrued but not yet paid margin as per SD. \n\nOpen traded positions are revalued by the exchange at the end of every trading day using mark-to-market valuation. Often clearing members do not credit or debit their clients daily with MRVM, but rather use a Maintenance Margin. If the balance falls outside MRMML (and MRMMU), then capital must be added (is refunded) to reach the original margin amount MRIM. We can also say that MVO+MRVM is equal to the reference value as per last margin update." ;
	<https://www.omg.org/spec/Commons/Designators/hasTag> "MRVM" ;
	<https://www.omg.org/spec/Commons/Designators/hasTextualName> "Variation Margin" .
<https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSContractTerms/ACTUSContractTerm-MVO> a <http://www.w3.org/2002/07/owl#NamedIndividual> , <https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSContractTerms/ACTUSContractTerm> ;
	<http://www.w3.org/2000/01/rdf-schema#label> "ACTUS contract term - MVO" ;
	<https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSContractTerms/hasParameterName> "marketValueObserved" ;
	<https://www.omg.org/spec/Commons/Classifiers/isClassifiedBy> <https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSContractTerms/ACTUSContractTermGroup-NotionalPrincipal> ;
	<https://www.omg.org/spec/Commons/Designators/hasDescription> "Value as observed in the market at SD per unit. Incase of fixed income instruments it is a fraction." ;
	<https://www.omg.org/spec/Commons/Designators/hasTag> "MVO" ;
	<https://www.omg.org/spec/Commons/Designators/hasTextualName> "Market Value Observed" .
<https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSContractTerms/ACTUSContractTerm-NPD> a <http://www.w3.org/2002/07/owl#NamedIndividual> , <https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSContractTerms/ACTUSContractTerm> ;
	<http://www.w3.org/2000/01/rdf-schema#label> "ACTUS contract term - NPD" ;
	<https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSContractTerms/hasParameterName> "nonPerformingDate" ;
	<https://www.omg.org/spec/Commons/Classifiers/isClassifiedBy> <https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSContractTerms/ACTUSContractTermGroup-Counterparty> ;
	<https://www.omg.org/spec/Commons/Designators/hasDescription> "The date of the (uncovered) payment event responsible for the current value of the Contract Performance attribute." ;
	<https://www.omg.org/spec/Commons/Designators/hasTag> "NPD" ;
	<https://www.omg.org/spec/Commons/Designators/hasTextualName> "Non Performing Date" .
<https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSContractTerms/ACTUSContractTerm-NT2> a <http://www.w3.org/2002/07/owl#NamedIndividual> , <https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSContractTerms/ACTUSContractTerm> ;
	<http://www.w3.org/2000/01/rdf-schema#label> "ACTUS contract term - NT2" ;
	<https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSContractTerms/hasParameterName> "notionalPrincipal2" ;
	<https://www.omg.org/spec/Commons/Classifiers/isClassifiedBy> <https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSContractTerms/ACTUSContractTermGroup-NotionalPrincipal> ;
	<https://www.omg.org/spec/Commons/Designators/hasDescription> "Notional amount of the second currency to be exchanged in an FXOUT CT." ;
	<https://www.omg.org/spec/Commons/Designators/hasTag> "NT2" ;
	<https://www.omg.org/spec/Commons/Designators/hasTextualName> "Notional Principal 2" .
<https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSContractTerms/ACTUSContractTerm-NT> a <http://www.w3.org/2002/07/owl#NamedIndividual> , <https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSContractTerms/ACTUSContractTerm> ;
	<http://www.w3.org/2000/01/rdf-schema#label> "ACTUS contract term - NT" ;
	<https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSContractTerms/hasParameterName> "notionalPrincipal" ;
	<https://www.omg.org/spec/Commons/Classifiers/isClassifiedBy> <https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSContractTerms/ACTUSContractTermGroup-NotionalPrincipal> ;
	<https://www.omg.org/spec/Commons/Designators/hasDescription> "Current nominal value of the contract. For debt instrument this is the current remaining notional outstanding. \n\nNT is generally the basis on which interest payments are calculated. If IPCBS is set, IPCBS may introduce a different basis for interest payment calculation." ;
	<https://www.omg.org/spec/Commons/Designators/hasTag> "NT" ;
	<https://www.omg.org/spec/Commons/Designators/hasTextualName> "Notional Principal" .
<https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSContractTerms/ACTUSContractTerm-OPANX> a <http://www.w3.org/2002/07/owl#NamedIndividual> , <https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSContractTerms/ACTUSContractTerm> ;
	<http://www.w3.org/2000/01/rdf-schema#label> "ACTUS contract term - OPANX" ;
	<https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSContractTerms/hasParameterName> "cycleAnchorDateOfOptionality" ;
	<https://www.omg.org/spec/Commons/Classifiers/isClassifiedBy> <https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSContractTerms/ACTUSContractTermGroup-Optionality> ;
	<https://www.omg.org/spec/Commons/Designators/hasDescription> "Used for Basic Maturities (such as PAM, RGM, ANN, NGM and their Step-up versions) and American and Bermudan style options. \n\n- Basic Maturities: Within the group of these Maturities, it indicates the possibility of prepayments. Prepayment features are controlled by Behavior. \n\n- American and Bermudan style Options: Begin of exercise period." ;
	<https://www.omg.org/spec/Commons/Designators/hasTag> "OPANX" ;
	<https://www.omg.org/spec/Commons/Designators/hasTextualName> "Cycle Anchor Date Of Optionality" .
<https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSContractTerms/ACTUSContractTerm-OPCL> a <http://www.w3.org/2002/07/owl#NamedIndividual> , <https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSContractTerms/ACTUSContractTerm> ;
	<http://www.w3.org/2000/01/rdf-schema#label> "ACTUS contract term - OPCL" ;
	<https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSContractTerms/hasParameterName> "cycleOfOptionality" ;
	<https://www.omg.org/spec/Commons/Classifiers/isClassifiedBy> <https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSContractTerms/ACTUSContractTermGroup-Optionality> ;
	<https://www.omg.org/spec/Commons/Designators/hasDescription> "Cycle according to which the option exercise date schedule will be calculated.\n\nOPCL can be NULL for American Options or Prepayment Optionality in which case the optionality period starts at OPANX and ends at OPXED (for american options) or MD (in case of prepayment optionality).\n\nThe interval will be adjusted yet by EOMC and BDC." ;
	<https://www.omg.org/spec/Commons/Designators/hasTag> "OPCL" ;
	<https://www.omg.org/spec/Commons/Designators/hasTextualName> "Cycle Of Optionality" .
<https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSContractTerms/ACTUSContractTerm-OPS1> a <http://www.w3.org/2002/07/owl#NamedIndividual> , <https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSContractTerms/ACTUSContractTerm> ;
	<http://www.w3.org/2000/01/rdf-schema#label> "ACTUS contract term - OPS1" ;
	<https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSContractTerms/hasParameterName> "optionStrike1" ;
	<https://www.omg.org/spec/Commons/Classifiers/isClassifiedBy> <https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSContractTerms/ACTUSContractTermGroup-Optionality> ;
	<https://www.omg.org/spec/Commons/Designators/hasDescription> "Strike price of the option. Whether it is a call/put is determined by the attribute OPTP, i.e a call or a put (or a combination of call/put).\n\nThis attribute is used for price related options such as options on bonds, stocks or FX. Interest rate related options (caps/floos) are handled within th RatReset group." ;
	<https://www.omg.org/spec/Commons/Designators/hasTag> "OPS1" ;
	<https://www.omg.org/spec/Commons/Designators/hasTextualName> "Option Strike 1" .
<https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSContractTerms/ACTUSContractTerm-OPS2> a <http://www.w3.org/2002/07/owl#NamedIndividual> , <https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSContractTerms/ACTUSContractTerm> ;
	<http://www.w3.org/2000/01/rdf-schema#label> "ACTUS contract term - OPS2" ;
	<https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSContractTerms/hasParameterName> "optionStrike2" ;
	<https://www.omg.org/spec/Commons/Classifiers/isClassifiedBy> <https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSContractTerms/ACTUSContractTermGroup-Optionality> ;
	<https://www.omg.org/spec/Commons/Designators/hasDescription> "Put price in case of call/put." ;
	<https://www.omg.org/spec/Commons/Designators/hasTag> "OPS2" ;
	<https://www.omg.org/spec/Commons/Designators/hasTextualName> "Option Strike 2" .
<https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSContractTerms/ACTUSContractTerm-OPTP> a <http://www.w3.org/2002/07/owl#NamedIndividual> , <https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSContractTerms/ACTUSContractTerm> ;
	<http://www.w3.org/2000/01/rdf-schema#label> "ACTUS contract term - OPTP" ;
	<https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSContractTerms/hasParameterName> "optionType" ;
	<https://www.omg.org/spec/Commons/Classifiers/isClassifiedBy> <https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSContractTerms/ACTUSContractTermGroup-Optionality> ;
	<https://www.omg.org/spec/Commons/Designators/hasDescription> "Defines whether the option is a call or put or a combination of it. This field has to be seen in combination with CNTRL where it is defined whether CRID is the buyer or the seller." ;
	<https://www.omg.org/spec/Commons/Designators/hasTag> "OPTP" ;
	<https://www.omg.org/spec/Commons/Designators/hasTextualName> "Option Type" .
<https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSContractTerms/ACTUSContractTerm-OPXED> a <http://www.w3.org/2002/07/owl#NamedIndividual> , <https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSContractTerms/ACTUSContractTerm> ;
	<http://www.w3.org/2000/01/rdf-schema#label> "ACTUS contract term - OPXED" ;
	<https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSContractTerms/hasParameterName> "optionExerciseEndDate" ;
	<https://www.omg.org/spec/Commons/Classifiers/isClassifiedBy> <https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSContractTerms/ACTUSContractTermGroup-Optionality> ;
	<https://www.omg.org/spec/Commons/Designators/hasDescription> "Final exercise date for American and Bermudan options, expiry date for European options." ;
	<https://www.omg.org/spec/Commons/Designators/hasTag> "OPXED" ;
	<https://www.omg.org/spec/Commons/Designators/hasTextualName> "Option Exercise End Date" .
<https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSContractTerms/ACTUSContractTerm-OPXT> a <http://www.w3.org/2002/07/owl#NamedIndividual> , <https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSContractTerms/ACTUSContractTerm> ;
	<http://www.w3.org/2000/01/rdf-schema#label> "ACTUS contract term - OPXT" ;
	<https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSContractTerms/hasParameterName> "optionExerciseType" ;
	<https://www.omg.org/spec/Commons/Classifiers/isClassifiedBy> <https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSContractTerms/ACTUSContractTermGroup-Optionality> ;
	<https://www.omg.org/spec/Commons/Designators/hasDescription> "Defines whether the option is European (exercised at a specific date), American (exercised during a span of time) or Bermudan (exercised at certain points during a span of time)." ;
	<https://www.omg.org/spec/Commons/Designators/hasTag> "OPXT" ;
	<https://www.omg.org/spec/Commons/Designators/hasTextualName> "Option Exercise Type" .
<https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSContractTerms/ACTUSContractTerm-PDIED> a <http://www.w3.org/2002/07/owl#NamedIndividual> , <https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSContractTerms/ACTUSContractTerm> ;
	<http://www.w3.org/2000/01/rdf-schema#label> "ACTUS contract term - PDIED" ;
	<https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSContractTerms/hasParameterName> "premiumDiscountAtIED" ;
	<https://www.omg.org/spec/Commons/Classifiers/isClassifiedBy> <https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSContractTerms/ACTUSContractTermGroup-NotionalPrincipal> ;
	<https://www.omg.org/spec/Commons/Designators/hasDescription> "Total original premium or discount that has been set at CDD and will be added to the (notional) cash flow at IED (cash flow at IED = NT+PDIED, w.r.t. an RPA CT). \n\nNegative value for discount and positive for premium.\n\nNote, similar to interest the PDIED portion is part of P&L." ;
	<https://www.omg.org/spec/Commons/Designators/hasTag> "PDIED" ;
	<https://www.omg.org/spec/Commons/Designators/hasTextualName> "Premium Discount At IED" .
<https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSContractTerms/ACTUSContractTerm-PFUT> a <http://www.w3.org/2002/07/owl#NamedIndividual> , <https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSContractTerms/ACTUSContractTerm> ;
	<http://www.w3.org/2000/01/rdf-schema#label> "ACTUS contract term - PFUT" ;
	<https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSContractTerms/hasParameterName> "futuresPrice" ;
	<https://www.omg.org/spec/Commons/Classifiers/isClassifiedBy> <https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSContractTerms/ACTUSContractTermGroup-Settlement> ;
	<https://www.omg.org/spec/Commons/Designators/hasDescription> "The price the counterparties agreed upon at which the underlying contract (of a FUTUR) is exchanged/settled at STD. Quoting is different for different types of underlyings: Fixed Income = in percentage, all others in nominal terms." ;
	<https://www.omg.org/spec/Commons/Designators/hasTag> "PFUT" ;
	<https://www.omg.org/spec/Commons/Designators/hasTextualName> "Futures Price" .
<https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSContractTerms/ACTUSContractTerm-PPEF> a <http://www.w3.org/2002/07/owl#NamedIndividual> , <https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSContractTerms/ACTUSContractTerm> ;
	<http://www.w3.org/2000/01/rdf-schema#label> "ACTUS contract term - PPEF" ;
	<https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSContractTerms/hasParameterName> "prepaymentEffect" ;
	<https://www.omg.org/spec/Commons/Classifiers/isClassifiedBy> <https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSContractTerms/ACTUSContractTermGroup-Optionality> ;
	<https://www.omg.org/spec/Commons/Designators/hasDescription> "This attribute defines whether or not the right of prepayment exists and if yes, how prepayment affects the remaining principal redemption schedule of the contract" ;
	<https://www.omg.org/spec/Commons/Designators/hasTag> "PPEF" ;
	<https://www.omg.org/spec/Commons/Designators/hasTextualName> "Prepayment Effect" .
<https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSContractTerms/ACTUSContractTerm-PPP> a <http://www.w3.org/2002/07/owl#NamedIndividual> , <https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSContractTerms/ACTUSContractTerm> ;
	<http://www.w3.org/2000/01/rdf-schema#label> "ACTUS contract term - PPP" ;
	<https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSContractTerms/hasParameterName> "prepaymentPeriod" ;
	<https://www.omg.org/spec/Commons/Classifiers/isClassifiedBy> <https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSContractTerms/ACTUSContractTermGroup-Counterparty> ;
	<https://www.omg.org/spec/Commons/Designators/hasDescription> "If real payment happens before scheduled payment date minus PPP, then it is considered a prepayment. Effect of prepayments are further described in PPEF and related fields." ;
	<https://www.omg.org/spec/Commons/Designators/hasTag> "PPP" ;
	<https://www.omg.org/spec/Commons/Designators/hasTextualName> "Prepayment Period" .
<https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSContractTerms/ACTUSContractTerm-PPRD> a <http://www.w3.org/2002/07/owl#NamedIndividual> , <https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSContractTerms/ACTUSContractTerm> ;
	<http://www.w3.org/2000/01/rdf-schema#label> "ACTUS contract term - PPRD" ;
	<https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSContractTerms/hasParameterName> "priceAtPurchaseDate" ;
	<https://www.omg.org/spec/Commons/Classifiers/isClassifiedBy> <https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSContractTerms/ACTUSContractTermGroup-NotionalPrincipal> ;
	<https://www.omg.org/spec/Commons/Designators/hasDescription> "Purchase price exchanged at PRD. \n\nPPRD represents a clean price (includes premium/discount but not IPAC)." ;
	<https://www.omg.org/spec/Commons/Designators/hasTag> "PPRD" ;
	<https://www.omg.org/spec/Commons/Designators/hasTextualName> "Price At Purchase Date" .
<https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSContractTerms/ACTUSContractTerm-PRANX> a <http://www.w3.org/2002/07/owl#NamedIndividual> , <https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSContractTerms/ACTUSContractTerm> ;
	<http://www.w3.org/2000/01/rdf-schema#label> "ACTUS contract term - PRANX" ;
	<https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSContractTerms/hasParameterName> "cycleAnchorDateOfPrincipalRedemption" ;
	<https://www.omg.org/spec/Commons/Classifiers/isClassifiedBy> <https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSContractTerms/ACTUSContractTermGroup-NotionalPrincipal> ;
	<https://www.omg.org/spec/Commons/Designators/hasDescription> "Date from which the principal payment date schedule is calculated according to the cycle length. The first principal payment event takes place on this anchor." ;
	<https://www.omg.org/spec/Commons/Designators/hasTag> "PRANX" ;
	<https://www.omg.org/spec/Commons/Designators/hasTextualName> "Cycle Anchor Date Of Principal Redemption" .
<https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSContractTerms/ACTUSContractTerm-PRCL> a <http://www.w3.org/2002/07/owl#NamedIndividual> , <https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSContractTerms/ACTUSContractTerm> ;
	<http://www.w3.org/2000/01/rdf-schema#label> "ACTUS contract term - PRCL" ;
	<https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSContractTerms/hasParameterName> "cycleOfPrincipalRedemption" ;
	<https://www.omg.org/spec/Commons/Classifiers/isClassifiedBy> <https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSContractTerms/ACTUSContractTermGroup-NotionalPrincipal> ;
	<https://www.omg.org/spec/Commons/Designators/hasDescription> "Cycle according to which the interest payment date schedule will be calculated.\n\nIn case PRCL is not set, then there will only be one principal payment event at MD (and possibly at PRANX if set).\n\nThe interval will be adjusted yet by EOMC and BDC." ;
	<https://www.omg.org/spec/Commons/Designators/hasTag> "PRCL" ;
	<https://www.omg.org/spec/Commons/Designators/hasTextualName> "Cycle Of Principal Redemption" .
<https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSContractTerms/ACTUSContractTerm-PRD> a <http://www.w3.org/2002/07/owl#NamedIndividual> , <https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSContractTerms/ACTUSContractTerm> ;
	<http://www.w3.org/2000/01/rdf-schema#label> "ACTUS contract term - PRD" ;
	<https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSContractTerms/hasParameterName> "purchaseDate" ;
	<https://www.omg.org/spec/Commons/Classifiers/isClassifiedBy> <https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSContractTerms/ACTUSContractTermGroup-NotionalPrincipal> ;
	<https://www.omg.org/spec/Commons/Designators/hasDescription> "If a contract is bought after initiation (for example a bond on the secondary market) this date has to be set. It refers to the date at which the payment (of PPRD) and transfer of the security happens. In other words, PRD - if set - takes the role otherwise IED has from a cash flow perspective.\n\nNote, CPID of the CT is not the counterparty of the transaction." ;
	<https://www.omg.org/spec/Commons/Designators/hasTag> "PRD" ;
	<https://www.omg.org/spec/Commons/Designators/hasTextualName> "Purchase Date" .
<https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSContractTerms/ACTUSContractTerm-PRF> a <http://www.w3.org/2002/07/owl#NamedIndividual> , <https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSContractTerms/ACTUSContractTerm> ;
	<http://www.w3.org/2000/01/rdf-schema#label> "ACTUS contract term - PRF" ;
	<https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSContractTerms/hasParameterName> "contractPerformance" ;
	<https://www.omg.org/spec/Commons/Classifiers/isClassifiedBy> <https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSContractTerms/ACTUSContractTermGroup-Counterparty> ;
	<https://www.omg.org/spec/Commons/Designators/hasDescription> "Indicates the current contract performance status. Different states of the contract range from performing to default." ;
	<https://www.omg.org/spec/Commons/Designators/hasTag> "PRF" ;
	<https://www.omg.org/spec/Commons/Designators/hasTextualName> "Contract Performance" .
<https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSContractTerms/ACTUSContractTerm-PRNXT> a <http://www.w3.org/2002/07/owl#NamedIndividual> , <https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSContractTerms/ACTUSContractTerm> ;
	<http://www.w3.org/2000/01/rdf-schema#label> "ACTUS contract term - PRNXT" ;
	<https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSContractTerms/hasParameterName> "nextPrincipalRedemptionPayment" ;
	<https://www.omg.org/spec/Commons/Classifiers/isClassifiedBy> <https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSContractTerms/ACTUSContractTermGroup-NotionalPrincipal> ;
	<https://www.omg.org/spec/Commons/Designators/hasDescription> "Amount of principal that will be paid during the redemption cycle at the next payment date. For amortizing contracts like ANN, NAM, ANX, and NAX this is the total periodic payment amount (sum of interest and principal)." ;
	<https://www.omg.org/spec/Commons/Designators/hasTag> "PRNXT" ;
	<https://www.omg.org/spec/Commons/Designators/hasTextualName> "Next Principal Redemption Payment" .
<https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSContractTerms/ACTUSContractTerm-PTD> a <http://www.w3.org/2002/07/owl#NamedIndividual> , <https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSContractTerms/ACTUSContractTerm> ;
	<http://www.w3.org/2000/01/rdf-schema#label> "ACTUS contract term - PTD" ;
	<https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSContractTerms/hasParameterName> "priceAtTerminationDate" ;
	<https://www.omg.org/spec/Commons/Classifiers/isClassifiedBy> <https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSContractTerms/ACTUSContractTermGroup-NotionalPrincipal> ;
	<https://www.omg.org/spec/Commons/Designators/hasDescription> "Sellingprice exchanged at PTD PTDrepresents a clean price (includes premium/discount but not IPAC" ;
	<https://www.omg.org/spec/Commons/Designators/hasTag> "PTD" ;
	<https://www.omg.org/spec/Commons/Designators/hasTextualName> "Price At Termination Date" .
<https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSContractTerms/ACTUSContractTerm-PYRT> a <http://www.w3.org/2002/07/owl#NamedIndividual> , <https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSContractTerms/ACTUSContractTerm> ;
	<http://www.w3.org/2000/01/rdf-schema#label> "ACTUS contract term - PYRT" ;
	<https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSContractTerms/hasParameterName> "penaltyRate" ;
	<https://www.omg.org/spec/Commons/Classifiers/isClassifiedBy> <https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSContractTerms/ACTUSContractTermGroup-Optionality> ;
	<https://www.omg.org/spec/Commons/Designators/hasDescription> "Either the rate or the absolute amount of the prepayment." ;
	<https://www.omg.org/spec/Commons/Designators/hasTag> "PYRT" ;
	<https://www.omg.org/spec/Commons/Designators/hasTextualName> "Penalty Rate" .
<https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSContractTerms/ACTUSContractTerm-PYTP> a <http://www.w3.org/2002/07/owl#NamedIndividual> , <https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSContractTerms/ACTUSContractTerm> ;
	<http://www.w3.org/2000/01/rdf-schema#label> "ACTUS contract term - PYTP" ;
	<https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSContractTerms/hasParameterName> "penaltyType" ;
	<https://www.omg.org/spec/Commons/Classifiers/isClassifiedBy> <https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSContractTerms/ACTUSContractTermGroup-Optionality> ;
	<https://www.omg.org/spec/Commons/Designators/hasDescription> "Defines whether prepayment is linked to a penalty and of which kind." ;
	<https://www.omg.org/spec/Commons/Designators/hasTag> "PYTP" ;
	<https://www.omg.org/spec/Commons/Designators/hasTextualName> "Penalty Type" .
<https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSContractTerms/ACTUSContractTerm-QT> a <http://www.w3.org/2002/07/owl#NamedIndividual> , <https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSContractTerms/ACTUSContractTerm> ;
	<http://www.w3.org/2000/01/rdf-schema#label> "ACTUS contract term - QT" ;
	<https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSContractTerms/hasParameterName> "quantity" ;
	<https://www.omg.org/spec/Commons/Classifiers/isClassifiedBy> <https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSContractTerms/ACTUSContractTermGroup-NotionalPrincipal> ;
	<https://www.omg.org/spec/Commons/Designators/hasDescription> "This attribute relates either to physical contracts (COM) or underlyings of traded contracts. \n\nIn case of physical contracts it holds the number of underlying units of the specific good (e.g. number of barrels of oil). \n\nIn case of well defined traded contracts it holds the number of defined underlying instruments. Example: QT of STK CTs underlying a FUTUR indicates the number of those specific STK CTs which underlie the FUTUR." ;
	<https://www.omg.org/spec/Commons/Designators/hasTag> "QT" ;
	<https://www.omg.org/spec/Commons/Designators/hasTextualName> "Quantity" .
<https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSContractTerms/ACTUSContractTerm-RRANX> a <http://www.w3.org/2002/07/owl#NamedIndividual> , <https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSContractTerms/ACTUSContractTerm> ;
	<http://www.w3.org/2000/01/rdf-schema#label> "ACTUS contract term - RRANX" ;
	<https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSContractTerms/hasParameterName> "cycleAnchorDateOfRateReset" ;
	<https://www.omg.org/spec/Commons/Classifiers/isClassifiedBy> <https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSContractTerms/ACTUSContractTermGroup-RateReset> ;
	<https://www.omg.org/spec/Commons/Designators/hasDescription> "Date from which the rate reset date schedule is calculated according to the cycle length. The first rate reset event takes place on this anchor." ;
	<https://www.omg.org/spec/Commons/Designators/hasTag> "RRANX" ;
	<https://www.omg.org/spec/Commons/Designators/hasTextualName> "Cycle Anchor Date Of Rate Reset" .
<https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSContractTerms/ACTUSContractTerm-RRCL> a <http://www.w3.org/2002/07/owl#NamedIndividual> , <https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSContractTerms/ACTUSContractTerm> ;
	<http://www.w3.org/2000/01/rdf-schema#label> "ACTUS contract term - RRCL" ;
	<https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSContractTerms/hasParameterName> "cycleOfRateReset" ;
	<https://www.omg.org/spec/Commons/Classifiers/isClassifiedBy> <https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSContractTerms/ACTUSContractTermGroup-RateReset> ;
	<https://www.omg.org/spec/Commons/Designators/hasDescription> "Cycle according to which the rate reset date schedule will be calculated.\n\nIn case RRCL is not set, then there will only be one rate reset event at RRANX given RRANX if set.\n\nThe interval will be adjusted yet by EOMC and BDC." ;
	<https://www.omg.org/spec/Commons/Designators/hasTag> "RRCL" ;
	<https://www.omg.org/spec/Commons/Designators/hasTextualName> "Cycle Of Rate Reset" .
<https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSContractTerms/ACTUSContractTerm-RRFIX> a <http://www.w3.org/2002/07/owl#NamedIndividual> , <https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSContractTerms/ACTUSContractTerm> ;
	<http://www.w3.org/2000/01/rdf-schema#label> "ACTUS contract term - RRFIX" ;
	<https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSContractTerms/hasParameterName> "fixingPeriod" ;
	<https://www.omg.org/spec/Commons/Classifiers/isClassifiedBy> <https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSContractTerms/ACTUSContractTermGroup-RateReset> ;
	<https://www.omg.org/spec/Commons/Designators/hasDescription> "Interest rate resets (adjustments) are usually fixed one or two days (usually Business Days) before the new rate applies (defined by the rate reset schedule). This field holds the period between fixing and application of a rate." ;
	<https://www.omg.org/spec/Commons/Designators/hasTag> "RRFIX" ;
	<https://www.omg.org/spec/Commons/Designators/hasTextualName> "Fixing Period" .
<https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSContractTerms/ACTUSContractTerm-RRLC> a <http://www.w3.org/2002/07/owl#NamedIndividual> , <https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSContractTerms/ACTUSContractTerm> ;
	<http://www.w3.org/2000/01/rdf-schema#label> "ACTUS contract term - RRLC" ;
	<https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSContractTerms/hasParameterName> "lifeCap" ;
	<https://www.omg.org/spec/Commons/Classifiers/isClassifiedBy> <https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSContractTerms/ACTUSContractTermGroup-RateReset> ;
	<https://www.omg.org/spec/Commons/Designators/hasDescription> "For variable rate basic CTs this represents a cap on the interest rate that applies during the entire lifetime of the contract.\n\nFor CAPFL CTs this represents the cap strike rate." ;
	<https://www.omg.org/spec/Commons/Designators/hasTag> "RRLC" ;
	<https://www.omg.org/spec/Commons/Designators/hasTextualName> "Life Cap" .
<https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSContractTerms/ACTUSContractTerm-RRLF> a <http://www.w3.org/2002/07/owl#NamedIndividual> , <https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSContractTerms/ACTUSContractTerm> ;
	<http://www.w3.org/2000/01/rdf-schema#label> "ACTUS contract term - RRLF" ;
	<https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSContractTerms/hasParameterName> "lifeFloor" ;
	<https://www.omg.org/spec/Commons/Classifiers/isClassifiedBy> <https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSContractTerms/ACTUSContractTermGroup-RateReset> ;
	<https://www.omg.org/spec/Commons/Designators/hasDescription> "For variable rate basic CTs this represents a floor on the interest rate that applies during the entire lifetime of the contract.\n\nFor CAPFL CTs this represents the floor strike rate." ;
	<https://www.omg.org/spec/Commons/Designators/hasTag> "RRLF" ;
	<https://www.omg.org/spec/Commons/Designators/hasTextualName> "Life Floor" .
<https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSContractTerms/ACTUSContractTerm-RRMLT> a <http://www.w3.org/2002/07/owl#NamedIndividual> , <https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSContractTerms/ACTUSContractTerm> ;
	<http://www.w3.org/2000/01/rdf-schema#label> "ACTUS contract term - RRMLT" ;
	<https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSContractTerms/hasParameterName> "rateMultiplier" ;
	<https://www.omg.org/spec/Commons/Classifiers/isClassifiedBy> <https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSContractTerms/ACTUSContractTermGroup-RateReset> ;
	<https://www.omg.org/spec/Commons/Designators/hasDescription> "Interest rate multiplier. A typical rate resetting rule is LIBOR plus x basis point where x represents the interest rate spread.\n\nHowever, in some cases like reverse or super floater contracts an additional rate multiplier applies. In this case, the new rate is determined as: IPNR after rate reset = Rate selected from the market object * RRMLT + RRSP." ;
	<https://www.omg.org/spec/Commons/Designators/hasTag> "RRMLT" ;
	<https://www.omg.org/spec/Commons/Designators/hasTextualName> "Rate Multiplier" .
<https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSContractTerms/ACTUSContractTerm-RRMO> a <http://www.w3.org/2002/07/owl#NamedIndividual> , <https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSContractTerms/ACTUSContractTerm> ;
	<http://www.w3.org/2000/01/rdf-schema#label> "ACTUS contract term - RRMO" ;
	<https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSContractTerms/hasParameterName> "marketObjectCodeOfRateReset" ;
	<https://www.omg.org/spec/Commons/Classifiers/isClassifiedBy> <https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSContractTerms/ACTUSContractTermGroup-RateReset> ;
	<https://www.omg.org/spec/Commons/Designators/hasDescription> "Is pointing to the interest rate driver (MarketObject) used for rate reset uniquely.\n\nUnique codes for market objects must be used." ;
	<https://www.omg.org/spec/Commons/Designators/hasTag> "RRMO" ;
	<https://www.omg.org/spec/Commons/Designators/hasTextualName> "Market Object Code Of Rate Reset" .
<https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSContractTerms/ACTUSContractTerm-RRNXT> a <http://www.w3.org/2002/07/owl#NamedIndividual> , <https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSContractTerms/ACTUSContractTerm> ;
	<http://www.w3.org/2000/01/rdf-schema#label> "ACTUS contract term - RRNXT" ;
	<https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSContractTerms/hasParameterName> "nextResetRate" ;
	<https://www.omg.org/spec/Commons/Classifiers/isClassifiedBy> <https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSContractTerms/ACTUSContractTermGroup-RateReset> ;
	<https://www.omg.org/spec/Commons/Designators/hasDescription> "Holds the new rate that has been fixed already (cf. attribute FixingDays) but not applied. This new rate will be applied at the next rate reset event (after SD and according to the rate reset schedule). Attention, RRNXT must be set to NULL after it is applied." ;
	<https://www.omg.org/spec/Commons/Designators/hasTag> "RRNXT" ;
	<https://www.omg.org/spec/Commons/Designators/hasTextualName> "Next Reset Rate" .
<https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSContractTerms/ACTUSContractTerm-RRPC> a <http://www.w3.org/2002/07/owl#NamedIndividual> , <https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSContractTerms/ACTUSContractTerm> ;
	<http://www.w3.org/2000/01/rdf-schema#label> "ACTUS contract term - RRPC" ;
	<https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSContractTerms/hasParameterName> "periodCap" ;
	<https://www.omg.org/spec/Commons/Classifiers/isClassifiedBy> <https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSContractTerms/ACTUSContractTermGroup-RateReset> ;
	<https://www.omg.org/spec/Commons/Designators/hasDescription> "For variable rate basic CTs this represents the maximum positive rate change per rate reset cycle." ;
	<https://www.omg.org/spec/Commons/Designators/hasTag> "RRPC" ;
	<https://www.omg.org/spec/Commons/Designators/hasTextualName> "Period Cap" .
<https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSContractTerms/ACTUSContractTerm-RRPF> a <http://www.w3.org/2002/07/owl#NamedIndividual> , <https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSContractTerms/ACTUSContractTerm> ;
	<http://www.w3.org/2000/01/rdf-schema#label> "ACTUS contract term - RRPF" ;
	<https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSContractTerms/hasParameterName> "periodFloor" ;
	<https://www.omg.org/spec/Commons/Classifiers/isClassifiedBy> <https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSContractTerms/ACTUSContractTermGroup-RateReset> ;
	<https://www.omg.org/spec/Commons/Designators/hasDescription> "For variable rate basic CTs this represents the maximum negative rate change per rate reset cycle." ;
	<https://www.omg.org/spec/Commons/Designators/hasTag> "RRPF" ;
	<https://www.omg.org/spec/Commons/Designators/hasTextualName> "Period Floor" .
<https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSContractTerms/ACTUSContractTerm-RRPNT> a <http://www.w3.org/2002/07/owl#NamedIndividual> , <https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSContractTerms/ACTUSContractTerm> ;
	<http://www.w3.org/2000/01/rdf-schema#label> "ACTUS contract term - RRPNT" ;
	<https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSContractTerms/hasParameterName> "cyclePointOfRateReset" ;
	<https://www.omg.org/spec/Commons/Classifiers/isClassifiedBy> <https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSContractTerms/ACTUSContractTermGroup-RateReset> ;
	<https://www.omg.org/spec/Commons/Designators/hasDescription> "Normally rates get reset at the beginning of any resetting cycles. There are contracts where the rate is not set at the beginning but at the end of the cycle and then applied to the previous cycle (post-fixing); in other words the rate applies before it is fixed. Hence, the new rate is not known during the entire cycle where it applies. Therefore, the rate will be applied backwards at the end of the cycle. This happens through a correction of interest accrued." ;
	<https://www.omg.org/spec/Commons/Designators/hasTag> "RRPNT" ;
	<https://www.omg.org/spec/Commons/Designators/hasTextualName> "Cycle Point Of Rate Reset" .
<https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSContractTerms/ACTUSContractTerm-RRSP> a <http://www.w3.org/2002/07/owl#NamedIndividual> , <https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSContractTerms/ACTUSContractTerm> ;
	<http://www.w3.org/2000/01/rdf-schema#label> "ACTUS contract term - RRSP" ;
	<https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSContractTerms/hasParameterName> "rateSpread" ;
	<https://www.omg.org/spec/Commons/Classifiers/isClassifiedBy> <https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSContractTerms/ACTUSContractTermGroup-RateReset> ;
	<https://www.omg.org/spec/Commons/Designators/hasDescription> "Interest rate spread. A typical rate resetting rule is LIBOR plus x basis point where x represents the interest rate spread. \n\nThe following equation can be taken if RRMLT is not set: IPNR after rate reset = Rate selected from the market object + RRSP." ;
	<https://www.omg.org/spec/Commons/Designators/hasTag> "RRSP" ;
	<https://www.omg.org/spec/Commons/Designators/hasTextualName> "Rate Spread" .
<https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSContractTerms/ACTUSContractTerm-SCANX> a <http://www.w3.org/2002/07/owl#NamedIndividual> , <https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSContractTerms/ACTUSContractTerm> ;
	<http://www.w3.org/2000/01/rdf-schema#label> "ACTUS contract term - SCANX" ;
	<https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSContractTerms/hasParameterName> "cycleAnchorDateOfScalingIndex" ;
	<https://www.omg.org/spec/Commons/Classifiers/isClassifiedBy> <https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSContractTerms/ACTUSContractTermGroup-NotionalPrincipal> ;
	<https://www.omg.org/spec/Commons/Designators/hasDescription> "Date from which the scaling date schedule is calculated according to the cycle length. The first scaling event takes place on this anchor." ;
	<https://www.omg.org/spec/Commons/Designators/hasTag> "SCANX" ;
	<https://www.omg.org/spec/Commons/Designators/hasTextualName> "Cycle Anchor Date Of Scaling Index" .
<https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSContractTerms/ACTUSContractTerm-SCCDD> a <http://www.w3.org/2002/07/owl#NamedIndividual> , <https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSContractTerms/ACTUSContractTerm> ;
	<http://www.w3.org/2000/01/rdf-schema#label> "ACTUS contract term - SCCDD" ;
	<https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSContractTerms/hasParameterName> "scalingIndexAtContractDealDate" ;
	<https://www.omg.org/spec/Commons/Classifiers/isClassifiedBy> <https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSContractTerms/ACTUSContractTermGroup-NotionalPrincipal> ;
	<https://www.omg.org/spec/Commons/Designators/hasDescription> "The value of the Scaling Index as per Contract Deal Date." ;
	<https://www.omg.org/spec/Commons/Designators/hasTag> "SCCDD" ;
	<https://www.omg.org/spec/Commons/Designators/hasTextualName> "Scaling Index At Contract Deal Date" .
<https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSContractTerms/ACTUSContractTerm-SCCL> a <http://www.w3.org/2002/07/owl#NamedIndividual> , <https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSContractTerms/ACTUSContractTerm> ;
	<http://www.w3.org/2000/01/rdf-schema#label> "ACTUS contract term - SCCL" ;
	<https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSContractTerms/hasParameterName> "cycleOfScalingIndex" ;
	<https://www.omg.org/spec/Commons/Classifiers/isClassifiedBy> <https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSContractTerms/ACTUSContractTermGroup-NotionalPrincipal> ;
	<https://www.omg.org/spec/Commons/Designators/hasDescription> "Cycle according to which the scaling date schedule will be calculated.\n\nIn case SCCL is not set, then there will only be one scaling event at SCANX given SCANX is set.\n\nThe interval will be adjusted yet by EOMC and BDC." ;
	<https://www.omg.org/spec/Commons/Designators/hasTag> "SCCL" ;
	<https://www.omg.org/spec/Commons/Designators/hasTextualName> "Cycle Of Scaling Index" .
<https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSContractTerms/ACTUSContractTerm-SCEF> a <http://www.w3.org/2002/07/owl#NamedIndividual> , <https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSContractTerms/ACTUSContractTerm> ;
	<http://www.w3.org/2000/01/rdf-schema#label> "ACTUS contract term - SCEF" ;
	<https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSContractTerms/hasParameterName> "scalingEffect" ;
	<https://www.omg.org/spec/Commons/Classifiers/isClassifiedBy> <https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSContractTerms/ACTUSContractTermGroup-NotionalPrincipal> ;
	<https://www.omg.org/spec/Commons/Designators/hasDescription> "Indicates which payments are scaled. I = Interest payments, N = Nominal payments and M = Maximum deferred interest amount. They can be scaled in any combination." ;
	<https://www.omg.org/spec/Commons/Designators/hasTag> "SCEF" ;
	<https://www.omg.org/spec/Commons/Designators/hasTextualName> "Scaling Effect" .
<https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSContractTerms/ACTUSContractTerm-SCIP> a <http://www.w3.org/2002/07/owl#NamedIndividual> , <https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSContractTerms/ACTUSContractTerm> ;
	<http://www.w3.org/2000/01/rdf-schema#label> "ACTUS contract term - SCIP" ;
	<https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSContractTerms/hasParameterName> "interestScalingMultiplier" ;
	<https://www.omg.org/spec/Commons/Classifiers/isClassifiedBy> <https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSContractTerms/ACTUSContractTermGroup-NotionalPrincipal> ;
	<https://www.omg.org/spec/Commons/Designators/hasDescription> "The multiplier being applied to interest cash flows" ;
	<https://www.omg.org/spec/Commons/Designators/hasTag> "SCIP" ;
	<https://www.omg.org/spec/Commons/Designators/hasTextualName> "Interest Scaling Multiplier" .
<https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSContractTerms/ACTUSContractTerm-SCMO> a <http://www.w3.org/2002/07/owl#NamedIndividual> , <https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSContractTerms/ACTUSContractTerm> ;
	<http://www.w3.org/2000/01/rdf-schema#label> "ACTUS contract term - SCMO" ;
	<https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSContractTerms/hasParameterName> "marketObjectCodeOfScalingIndex" ;
	<https://www.omg.org/spec/Commons/Classifiers/isClassifiedBy> <https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSContractTerms/ACTUSContractTermGroup-NotionalPrincipal> ;
	<https://www.omg.org/spec/Commons/Designators/hasDescription> "" ;
	<https://www.omg.org/spec/Commons/Designators/hasTag> "SCMO" ;
	<https://www.omg.org/spec/Commons/Designators/hasTextualName> "Market Object Code Of Scaling Index" .
<https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSContractTerms/ACTUSContractTerm-SCNT> a <http://www.w3.org/2002/07/owl#NamedIndividual> , <https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSContractTerms/ACTUSContractTerm> ;
	<http://www.w3.org/2000/01/rdf-schema#label> "ACTUS contract term - SCNT" ;
	<https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSContractTerms/hasParameterName> "notionalScalingMultiplier" ;
	<https://www.omg.org/spec/Commons/Classifiers/isClassifiedBy> <https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSContractTerms/ACTUSContractTermGroup-NotionalPrincipal> ;
	<https://www.omg.org/spec/Commons/Designators/hasDescription> "The multiplier being applied to principal cash flows" ;
	<https://www.omg.org/spec/Commons/Designators/hasTag> "SCNT" ;
	<https://www.omg.org/spec/Commons/Designators/hasTextualName> "Notional Scaling Multiplier" .
<https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSContractTerms/ACTUSContractTerm-SD> a <http://www.w3.org/2002/07/owl#NamedIndividual> , <https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSContractTerms/ACTUSContractTerm> ;
	<http://www.w3.org/2000/01/rdf-schema#label> "ACTUS contract term - SD" ;
	<https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSContractTerms/hasParameterName> "statusDate" ;
	<https://www.omg.org/spec/Commons/Classifiers/isClassifiedBy> <https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSContractTerms/ACTUSContractTermGroup-ContractIdentification> ;
	<https://www.omg.org/spec/Commons/Designators/hasDescription> "SD holds the date per which all attributes of the record were updated. This is especially important for the highly dynamic attributes like Accruals, Notional, interest rates in variable instruments etc." ;
	<https://www.omg.org/spec/Commons/Designators/hasTag> "SD" ;
	<https://www.omg.org/spec/Commons/Designators/hasTextualName> "Status Date" .
<https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSContractTerms/ACTUSContractTerm-SEN> a <http://www.w3.org/2002/07/owl#NamedIndividual> , <https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSContractTerms/ACTUSContractTerm> ;
	<http://www.w3.org/2000/01/rdf-schema#label> "ACTUS contract term - SEN" ;
	<https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSContractTerms/hasParameterName> "seniority" ;
	<https://www.omg.org/spec/Commons/Classifiers/isClassifiedBy> <https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSContractTerms/ACTUSContractTermGroup-Counterparty> ;
	<https://www.omg.org/spec/Commons/Designators/hasDescription> "Refers to the order of repayment in the event of a sale or default of the issuer." ;
	<https://www.omg.org/spec/Commons/Designators/hasTag> "SEN" ;
	<https://www.omg.org/spec/Commons/Designators/hasTextualName> "Seniority" .
<https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSContractTerms/ACTUSContractTerm-STP> a <http://www.w3.org/2002/07/owl#NamedIndividual> , <https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSContractTerms/ACTUSContractTerm> ;
	<http://www.w3.org/2000/01/rdf-schema#label> "ACTUS contract term - STP" ;
	<https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSContractTerms/hasParameterName> "settlementPeriod" ;
	<https://www.omg.org/spec/Commons/Classifiers/isClassifiedBy> <https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSContractTerms/ACTUSContractTermGroup-Settlement> ;
	<https://www.omg.org/spec/Commons/Designators/hasDescription> "Defines the period from fixing of a contingent event/obligation (Exercise Date) to settlement of the obligation." ;
	<https://www.omg.org/spec/Commons/Designators/hasTag> "STP" ;
	<https://www.omg.org/spec/Commons/Designators/hasTextualName> "Settlement Period" .
<https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSContractTerms/ACTUSContractTerm-TD> a <http://www.w3.org/2002/07/owl#NamedIndividual> , <https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSContractTerms/ACTUSContractTerm> ;
	<http://www.w3.org/2000/01/rdf-schema#label> "ACTUS contract term - TD" ;
	<https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSContractTerms/hasParameterName> "terminationDate" ;
	<https://www.omg.org/spec/Commons/Classifiers/isClassifiedBy> <https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSContractTerms/ACTUSContractTermGroup-NotionalPrincipal> ;
	<https://www.omg.org/spec/Commons/Designators/hasDescription> "If a contract is sold before MD (for example a bond on the secondary market) this date has to be set. It refers to the date at which the payment (of PTD) and transfer of the security happens. In other words, TD - if set - takes the role otherwise MD has from a cash flow perspective.\n\nNote, CPID of the CT is not the counterparty of the transaction." ;
	<https://www.omg.org/spec/Commons/Designators/hasTag> "TD" ;
	<https://www.omg.org/spec/Commons/Designators/hasTextualName> "Termination Date" .
<https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSContractTerms/ACTUSContractTerm-UT> a <http://www.w3.org/2002/07/owl#NamedIndividual> , <https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSContractTerms/ACTUSContractTerm> ;
	<http://www.w3.org/2000/01/rdf-schema#label> "ACTUS contract term - UT" ;
	<https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSContractTerms/hasParameterName> "unit" ;
	<https://www.omg.org/spec/Commons/Classifiers/isClassifiedBy> <https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSContractTerms/ACTUSContractTermGroup-NotionalPrincipal> ;
	<https://www.omg.org/spec/Commons/Designators/hasDescription> "The physical unit of the contract. Example: Barrels for an Oil COM CT." ;
	<https://www.omg.org/spec/Commons/Designators/hasTag> "UT" ;
	<https://www.omg.org/spec/Commons/Designators/hasTextualName> "Unit" .
<https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSContractTerms/ACTUSContractTerm-XA> a <http://www.w3.org/2002/07/owl#NamedIndividual> , <https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSContractTerms/ACTUSContractTerm> ;
	<http://www.w3.org/2000/01/rdf-schema#label> "ACTUS contract term - XA" ;
	<https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSContractTerms/hasParameterName> "exerciseAmount" ;
	<https://www.omg.org/spec/Commons/Classifiers/isClassifiedBy> <https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSContractTerms/ACTUSContractTermGroup-Settlement> ;
	<https://www.omg.org/spec/Commons/Designators/hasDescription> "The amount fixed at Exercise Date for a contingent event/obligation such as a forward condition, optionality etc. The Exercise Amount is fixed at Exercise Date but not settled yet." ;
	<https://www.omg.org/spec/Commons/Designators/hasTag> "XA" ;
	<https://www.omg.org/spec/Commons/Designators/hasTextualName> "Exercise Amount" .
<https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSContractTerms/ACTUSContractTerm-XD> a <http://www.w3.org/2002/07/owl#NamedIndividual> , <https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSContractTerms/ACTUSContractTerm> ;
	<http://www.w3.org/2000/01/rdf-schema#label> "ACTUS contract term - XD" ;
	<https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSContractTerms/hasParameterName> "exerciseDate" ;
	<https://www.omg.org/spec/Commons/Classifiers/isClassifiedBy> <https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSContractTerms/ACTUSContractTermGroup-Settlement> ;
	<https://www.omg.org/spec/Commons/Designators/hasDescription> "Date of exercising a contingent event/obligation such as a forward condition, optionality etc. The Exercise date marks the observed timestamp of fixing the contingent event and respective payment obligation not necessarily the timestamp of settling the obligation." ;
	<https://www.omg.org/spec/Commons/Designators/hasTag> "XD" ;
	<https://www.omg.org/spec/Commons/Designators/hasTextualName> "Exercise Date" .
<https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSContractTerms/ACTUSContractTerm-XDN> a <http://www.w3.org/2002/07/owl#NamedIndividual> , <https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSContractTerms/ACTUSContractTerm> ;
	<http://www.w3.org/2000/01/rdf-schema#label> "ACTUS contract term - XDN" ;
	<https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSContractTerms/hasParameterName> "xDayNotice" ;
	<https://www.omg.org/spec/Commons/Classifiers/isClassifiedBy> <https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSContractTerms/ACTUSContractTermGroup-NotionalPrincipal> ;
	<https://www.omg.org/spec/Commons/Designators/hasDescription> "Used as rolling attribute with the callable CT's UMP and CLM uniquely. CLM's and UMP's will not be settled (MD not set) until the client uses his option to call the contract X_Day_Notice after Current Date. As long as MD or TD is not set, the client postpones his right to call to the future. The cycle is normally defined in number of business days." ;
	<https://www.omg.org/spec/Commons/Designators/hasTag> "XDN" ;
	<https://www.omg.org/spec/Commons/Designators/hasTextualName> "X Day Notice" .
<https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSContractTerms/ACTUSContractTerm> a <http://www.w3.org/2002/07/owl#Class> ;
	<http://www.w3.org/2000/01/rdf-schema#label> "ACTUS contract term" ;
	<http://www.w3.org/2000/01/rdf-schema#subClassOf> <https://www.omg.org/spec/Commons/CodesAndCodeSets/CodeElement> , <https://www.omg.org/spec/MVF/MultipleVocabularyFacility/VocabularyEntry> , _:c14n1494 , _:c14n1730 , _:c14n1789 , _:c14n1948 , _:c14n1967 , _:c14n3079 , _:c14n940 ;
	<http://www.w3.org/2004/02/skos/core#definition> "code denoting a term describing an aspect of one or more ACTUS contract type(s)" .
<https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSContractTerms/ACTUSContractTermGroup-Boundary> a <http://www.w3.org/2002/07/owl#NamedIndividual> , <https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSContractTerms/ACTUSContractTermGroup> ;
	<http://www.w3.org/2000/01/rdf-schema#label> "ACTUS dictionary term group - boundary" ;
	<https://www.omg.org/spec/Commons/Designators/hasDescription> "name for a collection of parameters related to the concept boundary (or boundary condition) in relation to a contract" ;
	<https://www.omg.org/spec/Commons/Designators/hasTextualName> "Boundary" .
<https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSContractTerms/ACTUSContractTermGroup-Calendar> a <http://www.w3.org/2002/07/owl#NamedIndividual> , <https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSContractTerms/ACTUSContractTermGroup> ;
	<http://www.w3.org/2000/01/rdf-schema#label> "ACTUS dictionary term group - calendar" ;
	<https://www.omg.org/spec/Commons/Designators/hasDescription> "name for a collection of parameters related to the concept of a calendar" ;
	<https://www.omg.org/spec/Commons/Designators/hasTextualName> "Calendar" .
<https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSContractTerms/ACTUSContractTermGroup-ContractIdentification> a <http://www.w3.org/2002/07/owl#NamedIndividual> , <https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSContractTerms/ACTUSContractTermGroup> ;
	<http://www.w3.org/2000/01/rdf-schema#label> "ACTUS dictionary term group - contract identification" ;
	<https://www.omg.org/spec/Commons/Designators/hasDescription> "name for a collection of parameters related to the concept of identifying a contract" ;
	<https://www.omg.org/spec/Commons/Designators/hasTextualName> "Contract Identification" .
<https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSContractTerms/ACTUSContractTermGroup-Counterparty> a <http://www.w3.org/2002/07/owl#NamedIndividual> , <https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSContractTerms/ACTUSContractTermGroup> ;
	<http://www.w3.org/2000/01/rdf-schema#label> "ACTUS dictionary term group - counterparty" ;
	<https://www.omg.org/spec/Commons/Designators/hasDescription> "name for a collection of parameters related to the concept of a counterparty to a contract" ;
	<https://www.omg.org/spec/Commons/Designators/hasTextualName> "Counterparty" .
<https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSContractTerms/ACTUSContractTermGroup-Dividend> a <http://www.w3.org/2002/07/owl#NamedIndividual> , <https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSContractTerms/ACTUSContractTermGroup> ;
	<http://www.w3.org/2000/01/rdf-schema#label> "ACTUS dictionary term group - dividend" ;
	<https://www.omg.org/spec/Commons/Designators/hasDescription> "name for a collection of parameters related to the concept of a dividend" ;
	<https://www.omg.org/spec/Commons/Designators/hasTextualName> "Dividend" .
<https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSContractTerms/ACTUSContractTermGroup-Fees> a <http://www.w3.org/2002/07/owl#NamedIndividual> , <https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSContractTerms/ACTUSContractTermGroup> ;
	<http://www.w3.org/2000/01/rdf-schema#label> "ACTUS dictionary term group - fees" ;

	<http://www.w3.org/2000/01/rdf-schema#label> "has option sequence number" ;
	<http://www.w3.org/2000/01/rdf-schema#range> <http://www.w3.org/2001/XMLSchema#nonNegativeInteger> ;
	<http://www.w3.org/2000/01/rdf-schema#subPropertyOf> <https://www.omg.org/spec/Commons/QuantitiesAndUnits/hasNumericValue> ;
	<http://www.w3.org/2004/02/skos/core#definition> "specifies the order of occurance of an optional element in an enumerated list" .
<https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSContractTerms/hasParameterMapping> a <http://www.w3.org/2002/07/owl#DatatypeProperty> ;
	<http://www.w3.org/2000/01/rdf-schema#label> "has parameter mapping" ;
	<http://www.w3.org/2000/01/rdf-schema#subPropertyOf> <https://www.omg.org/spec/Commons/TextDatatype/hasTextValue> ;
	<http://www.w3.org/2004/02/skos/core#definition> "maps a quantitative or qualitative parameter defined in the ACTUS data dictionary with something else, such as a property specified in FIBO" .
<https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSContractTerms/hasParameterName> a <http://www.w3.org/2002/07/owl#DatatypeProperty> ;
	<http://www.w3.org/2000/01/rdf-schema#label> "has parameter name" ;
	<http://www.w3.org/2000/01/rdf-schema#subPropertyOf> <https://www.omg.org/spec/Commons/TextDatatype/hasTextValue> ;
	<http://www.w3.org/2004/02/skos/core#definition> "associates a name with a quantitative or qualitative factor defined in the ACTUS data dictionary used as a condition for classification of one or more contract type" ;
	<http://www.w3.org/2004/02/skos/core#note> "This property is explicitly not a subproperty of hasTextualName due to the requirement that any individual can have only one textual name in MVF, which may be loosened in MVF 1.2." .
<https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSTaxonomy/ACTUSContractType-Annuity> <http://purl.org/dc/terms/source> "https://www.actusfrf.org/taxonomy" ;
	a <http://www.w3.org/2002/07/owl#NamedIndividual> , <https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSTaxonomy/ACTUSContractType> ;
	<http://www.w3.org/2000/01/rdf-schema#label> "ACTUS contract type - annuity" ;
	<http://www.w3.org/2004/02/skos/core#definition> "cashflow classifier that applies to contracts whose principal is paid fully at the initial exchange date and principal plus interest is repaid periodically in constant amounts until maturity" ;
	<https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSTaxonomy/hasCoverageDescription> "Classical level payment mortgages, leasing contracts etc." ;
	<https://www.omg.org/spec/Commons/Designators/hasDescription> "Principal payment fully at IED and interest plus principal repaid periodically in constant amounts till MD. If variable rate, total amount for interest and principal is recalculated to be fully matured at MD." ;
	<https://www.omg.org/spec/Commons/Designators/hasTextualName> "Annuity" ;
	<https://www.omg.org/spec/Commons/TextDatatype/hasTextValue> "ANN" ;
	<https://www.omg.org/spec/MVF/MultipleVocabularyFacility/hasNarrowerEntry> <https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSTaxonomy/AlgorithmicContractCategory-FixedIncome> .
<https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSTaxonomy/ACTUSContractType-BondWithWarrant> <http://purl.org/dc/terms/source> "https://www.actusfrf.org/taxonomy" ;
	a <http://www.w3.org/2002/07/owl#NamedIndividual> , <https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSTaxonomy/ACTUSContractType> ;
	<http://www.w3.org/2000/01/rdf-schema#label> "ACTUS contract type - bond with warrant" ;
	<http://www.w3.org/2004/02/skos/core#definition> "cashflow classifier that applies to bonds with attached warrants" ;
	<https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSTaxonomy/hasCoverageDescription> "Warrants." ;
	<https://www.omg.org/spec/Commons/Designators/hasDescription> "Bonds with a warrant. If option is exercised, underlying bond continues to exist." ;
	<https://www.omg.org/spec/Commons/Designators/hasTextualName> "Warrant" ;
	<https://www.omg.org/spec/Commons/TextDatatype/hasTextValue> "BNDWR" ;
	<https://www.omg.org/spec/MVF/MultipleVocabularyFacility/hasNarrowerEntry> <https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSTaxonomy/AlgorithmicContractCategory-Options> .
<https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSTaxonomy/ACTUSContractType-BoundaryControlledSwitch> <http://purl.org/dc/terms/source> "https://www.actusfrf.org/taxonomy" ;
	a <http://www.w3.org/2002/07/owl#NamedIndividual> , <https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSTaxonomy/ACTUSContractType> ;
	<http://www.w3.org/2000/01/rdf-schema#label> "ACTUS contract type - boundary controlled switch" ;
	<http://www.w3.org/2004/02/skos/core#definition> "cashflow classifier that applies to derivative contracts with subcontract legs which can be activated (knocked in) or extinguished (knocked out) when the underlying asset price reaches a specified value" ;
	<https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSTaxonomy/hasCoverageDescription> "Knock-in and Knock-out barrier options with a single boundary. Bonus contracts with payout when underlying asset price remains above or below a specified level for specified period." ;
	<https://www.omg.org/spec/Commons/Designators/hasDescription> "A boundary controlled switch is a derivative contract with subcontract legs which can be activated (knocked in) or extinguished (knocked out) when the underlying asset price reaches a specified value. The underlying asset may be a stock, index, or exchange-traded fund. Boundary controlled switch contracts with a single boundary are currently defined." ;
	<https://www.omg.org/spec/Commons/Designators/hasTextualName> "Boundary Controlled Switch" ;
	<https://www.omg.org/spec/Commons/TextDatatype/hasTextValue> "BCS" ;
	<https://www.omg.org/spec/MVF/MultipleVocabularyFacility/hasNarrowerEntry> <https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSTaxonomy/AlgorithmicContractCategory-Options> .
<https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSTaxonomy/ACTUSContractType-CallMoney> <http://purl.org/dc/terms/source> "https://www.actusfrf.org/taxonomy" ;
	a <http://www.w3.org/2002/07/owl#NamedIndividual> , <https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSTaxonomy/ACTUSContractType> ;
	<http://www.w3.org/2000/01/rdf-schema#label> "ACTUS contract type - call money" ;
	<http://www.w3.org/2004/02/skos/core#definition> "cashflow classifier that applies to loans that are rolled over as long as they are not called" ;
	<https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSTaxonomy/hasCoverageDescription> "Interbank loans with call features." ;
	<https://www.omg.org/spec/Commons/Designators/hasDescription> "Loans that are rolled over as long as they are not called. Once called it has to be paid back after the stipulated notice period." ;
	<https://www.omg.org/spec/Commons/Designators/hasTextualName> "Call Money" ;
	<https://www.omg.org/spec/Commons/TextDatatype/hasTextValue> "CLM" ;
	<https://www.omg.org/spec/MVF/MultipleVocabularyFacility/hasNarrowerEntry> <https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSTaxonomy/AlgorithmicContractCategory-FixedIncome> .
<https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSTaxonomy/ACTUSContractType-CapFloorOption> <http://purl.org/dc/terms/source> "https://www.actusfrf.org/taxonomy" ;
	a <http://www.w3.org/2002/07/owl#NamedIndividual> , <https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSTaxonomy/ACTUSContractType> ;
	<http://www.w3.org/2000/01/rdf-schema#label> "ACTUS contract type - cap floor option" ;
	<http://www.w3.org/2004/02/skos/core#definition> "cashflow classifier that applies to interest rate options expressed with a maximum or minimum interest rate" ;
	<https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSTaxonomy/hasCoverageDescription> "Cap and floor options." ;
	<https://www.omg.org/spec/Commons/Designators/hasDescription> "Interest rate option expressed in a maximum or minimum interest rate." ;
	<https://www.omg.org/spec/Commons/Designators/hasTextualName> "Cap Floors" ;
	<https://www.omg.org/spec/Commons/TextDatatype/hasTextValue> "CAPFL" ;
	<https://www.omg.org/spec/MVF/MultipleVocabularyFacility/hasNarrowerEntry> <https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSTaxonomy/AlgorithmicContractCategory-Options> .
<https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSTaxonomy/ACTUSContractType-Cash> <http://purl.org/dc/terms/source> "https://www.actusfrf.org/taxonomy" ;
	a <http://www.w3.org/2002/07/owl#NamedIndividual> , <https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSTaxonomy/ACTUSContractType> ;
	<http://www.w3.org/2000/01/rdf-schema#label> "ACTUS contract type - cash" ;
	<http://www.w3.org/2004/02/skos/core#definition> "cashflow classifier that applies to cash or cash equivalent positions" ;
	<https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSTaxonomy/hasCoverageDescription> "Cash, deposits at central bank" ;
	<https://www.omg.org/spec/Commons/Designators/hasDescription> "Cash or cash equivalent position" ;
	<https://www.omg.org/spec/Commons/Designators/hasTextualName> "Cash" ;
	<https://www.omg.org/spec/Commons/TextDatatype/hasTextValue> "CSH" ;
	<https://www.omg.org/spec/MVF/MultipleVocabularyFacility/hasNarrowerEntry> <https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSTaxonomy/AlgorithmicContractCategory-FixedIncome> .
<https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSTaxonomy/ACTUSContractType-Collateral> <http://purl.org/dc/terms/source> "https://www.actusfrf.org/taxonomy" ;
	a <http://www.w3.org/2002/07/owl#NamedIndividual> , <https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSTaxonomy/ACTUSContractType> ;
	<http://www.w3.org/2000/01/rdf-schema#label> "ACTUS contract type - collateral" ;
	<http://www.w3.org/2004/02/skos/core#definition> "cashflow classifier that applies to relationships between collateral, an obligee and a debtor, covering the exposure from the debtor with the collateral" ;
	<https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSTaxonomy/hasCoverageDescription> "Mortgages include a collateral contract. Any coverage with financial or physical collateral." ;
	<https://www.omg.org/spec/Commons/Designators/hasDescription> "Collateral creates a relationship between a collateral an obligee and a debtor, covering the exposure from the debtor with the collateral." ;
	<https://www.omg.org/spec/Commons/Designators/hasTextualName> "Collateral" ;
	<https://www.omg.org/spec/Commons/TextDatatype/hasTextValue> "CEC" ;
	<https://www.omg.org/spec/MVF/MultipleVocabularyFacility/hasNarrowerEntry> <https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSTaxonomy/AlgorithmicContractCategory-CreditEnhancement> .
<https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSTaxonomy/ACTUSContractType-Commodity> <http://purl.org/dc/terms/source> "https://www.actusfrf.org/taxonomy" ;
	a <http://www.w3.org/2002/07/owl#NamedIndividual> , <https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSTaxonomy/ACTUSContractType> ;
	<http://www.w3.org/2000/01/rdf-schema#label> "ACTUS contract type - commodity" ;
	<http://www.w3.org/2004/02/skos/core#definition> "cashflow classifier that applies to movements of commodities such as oil, gas or even houses that can serve as underlyings of commodity futures, guarantees or simply asset positions" ;
	<https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSTaxonomy/hasCoverageDescription> "Oil, gas, electricity, houses etc." ;
	<https://www.omg.org/spec/Commons/Designators/hasDescription> "This is not a financial contract in its propper sense. However it tracks movements of commodities such as oil, gas or even houses. Such commodities can serve as underlyings of commodity futures, guarantees or simply asset positions." ;
	<https://www.omg.org/spec/Commons/Designators/hasTextualName> "Commodity" ;
	<https://www.omg.org/spec/Commons/TextDatatype/hasTextValue> "COM" ;
	<https://www.omg.org/spec/MVF/MultipleVocabularyFacility/hasNarrowerEntry> <https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSTaxonomy/AlgorithmicContractCategory-ExchangeTraded> .
<https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSTaxonomy/ACTUSContractType-ConvertibleNote> a <http://www.w3.org/2002/07/owl#NamedIndividual> , <https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSTaxonomy/ACTUSContractType> ;
	<http://www.w3.org/2000/01/rdf-schema#label> "ACTUS contract type - convertible note" ;
	<http://www.w3.org/2004/02/skos/core#definition> "cashflow classifier that applies to bonds with a call or put option" ;
	<https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSTaxonomy/hasCoverageDescription> "Callable and puttable bonds or loans." ;
	<https://www.omg.org/spec/Commons/Designators/hasDescription> "Bonds with a call or put option. If option is exercised, underlying bond ceases to exist." ;
	<https://www.omg.org/spec/Commons/Designators/hasTextualName> "Convertible Note" ;
	<https://www.omg.org/spec/Commons/TextDatatype/hasTextValue> "BNDCP" ;
	<https://www.omg.org/spec/MVF/MultipleVocabularyFacility/hasNarrowerEntry> <https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSTaxonomy/AlgorithmicContractCategory-Options> .
<https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSTaxonomy/ACTUSContractType-CreditDefaultSwap> a <http://www.w3.org/2002/07/owl#NamedIndividual> , <https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSTaxonomy/ACTUSContractType> ;
	<http://www.w3.org/2000/01/rdf-schema#label> "ACTUS contract type - credit default swap" ;
	<http://www.w3.org/2004/02/skos/core#definition> "cashflow classifier that applies to contracts for which a payment is triggered if one or more of the underlying counterparties defaults" ;
	<https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSTaxonomy/hasCoverageDescription> "All sorts of credit default swaps." ;
	<https://www.omg.org/spec/Commons/Designators/hasDescription> "A payment is triggered if one or more of the underlying counterparties defaults." ;
	<https://www.omg.org/spec/Commons/Designators/hasTextualName> "Credit Default Swap" ;
	<https://www.omg.org/spec/Commons/TextDatatype/hasTextValue> "CDSWP" ;
	<https://www.omg.org/spec/MVF/MultipleVocabularyFacility/hasNarrowerEntry> <https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSTaxonomy/AlgorithmicContractCategory-Securitization> .
<https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSTaxonomy/ACTUSContractType-CreditLinkedNote> a <http://www.w3.org/2002/07/owl#NamedIndividual> , <https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSTaxonomy/ACTUSContractType> ;
	<http://www.w3.org/2000/01/rdf-schema#label> "ACTUS contract type - credit linked note" ;
	<http://www.w3.org/2004/02/skos/core#definition> "cashflow classifier that applies to securities with an embedded credit default swap, linking the credit risk of a reference entity to the note's performance" ;
	<https://www.omg.org/spec/Commons/Designators/hasDescription> "A credit linked note is a security with an embedded CDSWP" ;
	<https://www.omg.org/spec/Commons/Designators/hasTextualName> "Credit Linked Note" ;
	<https://www.omg.org/spec/Commons/TextDatatype/hasTextValue> "CLNTE" ;
	<https://www.omg.org/spec/MVF/MultipleVocabularyFacility/hasNarrowerEntry> <https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSTaxonomy/AlgorithmicContractCategory-Securitization> .
<https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSTaxonomy/ACTUSContractType-ExoticAnnuity> <http://purl.org/dc/terms/source> "https://www.actusfrf.org/taxonomy" ;
	a <http://www.w3.org/2002/07/owl#NamedIndividual> , <https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSTaxonomy/ACTUSContractType> ;
	<http://www.w3.org/2000/01/rdf-schema#label> "ACTUS contract type - exotic annuity" ;
	<http://www.w3.org/2004/02/skos/core#definition> "cashflow classifier that applies to contracts whose principal is paid fully at the initial exchange date and principal plus interest payments may include step ups in principal and/or interest until maturity" ;
	<https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSTaxonomy/hasCoverageDescription> "A special version of this kind are teaser rate loans and mortgages with annuity features." ;
	<https://www.omg.org/spec/Commons/Designators/hasDescription> "Exotic version of ANN. However step ups with respect to (i) Principal, (ii) Interest rates are possible. Highly flexible to match totally irregular principal payments. Principal can also be paid out in steps." ;
	<https://www.omg.org/spec/Commons/Designators/hasTextualName> "Exotic Annuity" ;
	<https://www.omg.org/spec/Commons/TextDatatype/hasTextValue> "ANX" ;
	<https://www.omg.org/spec/MVF/MultipleVocabularyFacility/hasNarrowerEntry> <https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSTaxonomy/AlgorithmicContractCategory-FixedIncome> .
<https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSTaxonomy/ACTUSContractType-ExoticLinearAmortizer> <http://purl.org/dc/terms/source> "https://www.actusfrf.org/taxonomy" ;
	a <http://www.w3.org/2002/07/owl#NamedIndividual> , <https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSTaxonomy/ACTUSContractType> ;
	<http://www.w3.org/2000/01/rdf-schema#label> "ACTUS contract type - exotic linear amortizer" ;
	<http://www.w3.org/2004/02/skos/core#definition> "cashflow classifier that applies to contracts whose principal is typically, but not always, paid fully at the initial exchange date and where the principal is typically repaid in equal amounts until a step change or maturity, with interest payments decreasing accordingly until a step change in the interest amount" ;
	<https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSTaxonomy/hasCoverageDescription> "A special version of this kind are teaser rate loans and mortgages." ;
	<https://www.omg.org/spec/Commons/Designators/hasDescription> "Exotic version of LAM. However step ups with respect to (i) Principal, (ii) Interest rates are possible. Highly flexible to match totally irregular principal payments. Principal can also be paid out in steps." ;
	<https://www.omg.org/spec/Commons/Designators/hasTextualName> "Exotic Linear Amortizer" ;
	<https://www.omg.org/spec/Commons/TextDatatype/hasTextValue> "LAX" ;
	<https://www.omg.org/spec/MVF/MultipleVocabularyFacility/hasNarrowerEntry> <https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSTaxonomy/AlgorithmicContractCategory-FixedIncome> .
<https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSTaxonomy/ACTUSContractType-ExoticNegativeAmortizer> <http://purl.org/dc/terms/source> "https://www.actusfrf.org/taxonomy" ;
	a <http://www.w3.org/2002/07/owl#NamedIndividual> , <https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSTaxonomy/ACTUSContractType> ;
	<http://www.w3.org/2000/01/rdf-schema#label> "ACTUS contract type - exotic negative amortizer" ;
	<http://www.w3.org/2004/02/skos/core#definition> "cashflow classifier that applies to negative amortizing contracts but allowing step ups in principal and interest" ;
	<https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSTaxonomy/hasCoverageDescription> "A special version of this kind are teaser rate loans and mortgages with a variable maturity date." ;
	<https://www.omg.org/spec/Commons/Designators/hasDescription> "Exotic version of NAM. However step ups with respect to (i) Principal, (ii) Interest rates are possible. Highly flexible to match totally irregular principal payments. Principal can also be paid out in steps." ;
	<https://www.omg.org/spec/Commons/Designators/hasTextualName> "Exotic Negative Amortizer" ;
	<https://www.omg.org/spec/Commons/TextDatatype/hasTextValue> "NAX" ;
	<https://www.omg.org/spec/MVF/MultipleVocabularyFacility/hasNarrowerEntry> <https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSTaxonomy/AlgorithmicContractCategory-FixedIncome> .
<https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSTaxonomy/ACTUSContractType-ExoticOption> a <http://www.w3.org/2002/07/owl#NamedIndividual> , <https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSTaxonomy/ACTUSContractType> ;
	<http://www.w3.org/2000/01/rdf-schema#label> "ACTUS contract type - exotic option" ;
	<http://www.w3.org/2004/02/skos/core#definition> "cashflow classifier that applies to exotic options" ;
	<https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSTaxonomy/hasCoverageDescription> "Knock-in and Knock-out, Barrier, Ladder, Rainbow options etc." ;
	<https://www.omg.org/spec/Commons/Designators/hasDescription> "As of current, most of the exotic options which were popular before 2008 are out of favor and factually irrelevant. Which of the exotic options will be implemented will depend on the real relevance in the future." ;
	<https://www.omg.org/spec/Commons/Designators/hasTextualName> "EXOTi" ;
	<https://www.omg.org/spec/Commons/TextDatatype/hasTextValue> "EXOTi" ;
	<https://www.omg.org/spec/MVF/MultipleVocabularyFacility/hasNarrowerEntry> <https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSTaxonomy/AlgorithmicContractCategory-Options> .
<https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSTaxonomy/ACTUSContractType-ForeignExchangeOutright> a <http://www.w3.org/2002/07/owl#NamedIndividual> , <https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSTaxonomy/ACTUSContractType> ;
	<http://www.w3.org/2000/01/rdf-schema#label> "ACTUS contract type - foreign exchange outright" ;
	<http://www.w3.org/2004/02/skos/core#definition> "cashflow classifier that applies to agreements where two parties agree to exchange fixed cash flows in different currencies at a specified future date" ;
	<https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSTaxonomy/hasCoverageDescription> "Any FX-outright transaction at a future date. This is also the underlying of FX-options and FX futures." ;
	<https://www.omg.org/spec/Commons/Designators/hasDescription> "Two parties agree to exchange two fixed cash flows in different currencies at a certain point in time in future." ;
	<https://www.omg.org/spec/Commons/Designators/hasTextualName> "Foreign Ex-change Outright" ;
	<https://www.omg.org/spec/Commons/TextDatatype/hasTextValue> "FXOUT" ;
	<https://www.omg.org/spec/MVF/MultipleVocabularyFacility/hasNarrowerEntry> <https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSTaxonomy/AlgorithmicContractCategory-Symmetric> .
<https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSTaxonomy/ACTUSContractType-Future> a <http://www.w3.org/2002/07/owl#NamedIndividual> , <https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSTaxonomy/ACTUSContractType> ;
	<http://www.w3.org/2000/01/rdf-schema#label> "ACTUS contract type - future" ;
	<http://www.w3.org/2004/02/skos/core#definition> "cashflow classifier that applies to futures" ;
	<https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSTaxonomy/hasCoverageDescription> "Standard interest rate, FX, stock and commodity futures." ;
	<https://www.omg.org/spec/Commons/Designators/hasDescription> "Keeps track of value changes for any basic CT as underlying (PAM, ANN etc. but also FXOUT, STK, COM). Handles margining calls." ;
	<https://www.omg.org/spec/Commons/Designators/hasTextualName> "Future" ;
	<https://www.omg.org/spec/Commons/TextDatatype/hasTextValue> "FUTUR" ;
	<https://www.omg.org/spec/MVF/MultipleVocabularyFacility/hasNarrowerEntry> <https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSTaxonomy/AlgorithmicContractCategory-Symmetric> .
<https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSTaxonomy/ACTUSContractType-Guarantee> a <http://www.w3.org/2002/07/owl#NamedIndividual> , <https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSTaxonomy/ACTUSContractType> ;
	<http://www.w3.org/2000/01/rdf-schema#label> "ACTUS contract type - guarantee" ;
	<http://www.w3.org/2004/02/skos/core#definition> "cashflow classifier that applies to credit enhancements that create a relationship between a guarantor, an obligee and a debtor, moving the exposure from the debtor to the guarantor" ;
	<https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSTaxonomy/hasCoverageDescription> "Personal guarantee. Government guarantee. Underlyings of CDO's." ;
	<https://www.omg.org/spec/Commons/Designators/hasDescription> "Guarantee creates a relationship between a guarantor, an obligee and a debtor, moving the exposure from the debtor to the guarantor." ;
	<https://www.omg.org/spec/Commons/Designators/hasTextualName> "Guarantee" ;
	<https://www.omg.org/spec/Commons/TextDatatype/hasTextValue> "CEG" ;
	<https://www.omg.org/spec/MVF/MultipleVocabularyFacility/hasNarrowerEntry> <https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSTaxonomy/AlgorithmicContractCategory-CreditEnhancement> .
<https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSTaxonomy/ACTUSContractType-LinearAmortizer> <http://purl.org/dc/terms/source> "https://www.actusfrf.org/taxonomy" ;
	a <http://www.w3.org/2002/07/owl#NamedIndividual> , <https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSTaxonomy/ACTUSContractType> ;
	<http://www.w3.org/2000/01/rdf-schema#label> "ACTUS contract type - linear amortizer" ;
	<http://www.w3.org/2004/02/skos/core#definition> "cashflow classifier that applies to contracts whose principal is paid fully at the initial exchange date and where the principal is repaid in equal amounts until maturity, with interest payments decreasing accordingly" ;
	<https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSTaxonomy/hasCoverageDescription> "Many amortizing loans." ;
	<https://www.omg.org/spec/Commons/Designators/hasDescription> "Principal payment fully at IED. Principal repaid periodically in constant amounts till MD. Interest gets reduced accordingly. If variable rate, only interest payment is recalculated. Fixed and variable rates." ;
	<https://www.omg.org/spec/Commons/Designators/hasTextualName> "Linear Amortizer" ;
	<https://www.omg.org/spec/Commons/TextDatatype/hasTextValue> "LAM" ;
	<https://www.omg.org/spec/MVF/MultipleVocabularyFacility/hasNarrowerEntry> <https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSTaxonomy/AlgorithmicContractCategory-FixedIncome> .
<https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSTaxonomy/ACTUSContractType-Margining> a <http://www.w3.org/2002/07/owl#NamedIndividual> , <https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSTaxonomy/ACTUSContractType> ;
	<http://www.w3.org/2000/01/rdf-schema#label> "ACTUS contract type - margining" ;
	<http://www.w3.org/2004/02/skos/core#definition> "cashflow classifier that applies to margin contracts that traces the value changes and the different margin categories like inital and variation margin" ;
	<https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSTaxonomy/hasCoverageDescription> "Margin contracts as applied in central depositories for any underlying or portfolio of underlying instruments." ;
	<https://www.omg.org/spec/Commons/Designators/hasDescription> "A Margining contract traces the value changes and the different margin categories like inital and variation margin." ;
	<https://www.omg.org/spec/Commons/Designators/hasTextualName> "Margining" ;
	<https://www.omg.org/spec/Commons/TextDatatype/hasTextValue> "MAR" ;
	<https://www.omg.org/spec/MVF/MultipleVocabularyFacility/hasNarrowerEntry> <https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSTaxonomy/AlgorithmicContractCategory-CreditEnhancement> .
<https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSTaxonomy/ACTUSContractType-NegativeAmortizer> <http://purl.org/dc/terms/source> "https://www.actusfrf.org/taxonomy" ;
	a <http://www.w3.org/2002/07/owl#NamedIndividual> , <https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSTaxonomy/ACTUSContractType> ;
	<http://www.w3.org/2000/01/rdf-schema#label> "ACTUS contract type - negative amortizer" ;
	<http://www.w3.org/2004/02/skos/core#definition> "cashflow classifier that applies to contracts whose principal is paid fully at the initial exchange date and principal plus interest is repaid periodically in constant amounts until maturity, however, when resetting the rate, the total payment (principal plus interest remains constant) thus the maturity changes" ;
	<https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSTaxonomy/hasCoverageDescription> "Special class of ARMs (adjustable rate mortgages), certain other loans, with payment caps." ;
	<https://www.omg.org/spec/Commons/Designators/hasDescription> "Similar as ANN. However when resetting rate, total amount (interest plus principal) stay constant. MD shifts. Only variable rates." ;
	<https://www.omg.org/spec/Commons/Designators/hasTextualName> "Negative Amortizer" ;
	<https://www.omg.org/spec/Commons/TextDatatype/hasTextValue> "NAM" ;
	<https://www.omg.org/spec/MVF/MultipleVocabularyFacility/hasNarrowerEntry> <https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSTaxonomy/AlgorithmicContractCategory-FixedIncome> .
<https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSTaxonomy/ACTUSContractType-Option> a <http://www.w3.org/2002/07/owl#NamedIndividual> , <https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSTaxonomy/ACTUSContractType> ;
	<http://www.w3.org/2000/01/rdf-schema#label> "ACTUS contract type - option" ;
	<http://www.w3.org/2004/02/skos/core#definition> "cashflow classifier that calculates straight option pay-off for any basic contract as underlying (PAM, ANN etc.) but also SWAPS, FXOUT, STK and COM" ;
	<https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSTaxonomy/hasCoverageDescription> "European, American and Bermudan options with Interest rate, FX and stock futures as underlying instruments." ;
	<https://www.omg.org/spec/Commons/Designators/hasDescription> "Calculates straight option pay-off for any basic CT as underlying (PAM, ANN etc.) but also SWAPS, FXOUT, STK and COM. Single, periodic and continuous strike is supported." ;
	<https://www.omg.org/spec/Commons/Designators/hasTextualName> "Option" ;
	<https://www.omg.org/spec/Commons/TextDatatype/hasTextValue> "OPTNS" ;
	<https://www.omg.org/spec/MVF/MultipleVocabularyFacility/hasNarrowerEntry> <https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSTaxonomy/AlgorithmicContractCategory-Options> .
<https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSTaxonomy/ACTUSContractType-PerpetualBond> <http://purl.org/dc/terms/source> "https://www.actusfrf.org/taxonomy" ;
	a <http://www.w3.org/2002/07/owl#NamedIndividual> , <https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSTaxonomy/ACTUSContractType> ;
	<http://www.w3.org/2000/01/rdf-schema#label> "ACTUS contract type - perpetual bond" ;
	<http://www.w3.org/2004/02/skos/core#definition> "cashflow classifier that applies to bonds without any maturity date" ;
	<https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSTaxonomy/hasCoverageDescription> "Consoles, war loans." ;
	<https://www.omg.org/spec/Commons/Designators/hasDescription> "Bonds without any maturity date. Interest is paid into eternity if is not terminated." ;
	<https://www.omg.org/spec/Commons/Designators/hasTextualName> "Perpetual Bonds" ;
	<https://www.omg.org/spec/Commons/TextDatatype/hasTextValue> "PBN" ;
	<https://www.omg.org/spec/MVF/MultipleVocabularyFacility/hasNarrowerEntry> <https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSTaxonomy/AlgorithmicContractCategory-FixedIncome> .
<https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSTaxonomy/ACTUSContractType-PlainVanillaSwap> <http://purl.org/dc/terms/source> "https://www.actusfrf.org/taxonomy" ;
	a <http://www.w3.org/2002/07/owl#NamedIndividual> , <https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSTaxonomy/ACTUSContractType> ;
	<http://www.w3.org/2000/01/rdf-schema#label> "ACTUS contract type - plain vanilla swap" ;
	<http://www.w3.org/2004/02/skos/core#definition> "cashflow classifier that applies to swaps where the underlyings are always two identical PAM's however with one leg fixed and the other variable" ;
	<https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSTaxonomy/hasCoverageDescription> "More than 90% of all interest rate swaps follow this simple pattern." ;
	<https://www.omg.org/spec/Commons/Designators/hasDescription> "Plain vanilla swaps where the underlyings are always two identical PAM's however with one leg fixed and the other variable." ;
	<https://www.omg.org/spec/Commons/Designators/hasTextualName> "Plain Vanilla Swap" ;
	<https://www.omg.org/spec/Commons/TextDatatype/hasTextValue> "SWPPV" ;
	<https://www.omg.org/spec/MVF/MultipleVocabularyFacility/hasNarrowerEntry> <https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSTaxonomy/AlgorithmicContractCategory-Symmetric> .
<https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSTaxonomy/ACTUSContractType-PrincipalAtMaturity> <http://purl.org/dc/terms/source> "https://www.actusfrf.org/taxonomy" ;
	a <http://www.w3.org/2002/07/owl#NamedIndividual> , <https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSTaxonomy/ACTUSContractType> ;
	<http://www.w3.org/2000/01/rdf-schema#label> "ACTUS contract type - principal at maturity" ;
	<http://www.w3.org/2004/02/skos/core#definition> "cashflow classifier that applies to contracts whose principal is paid fully at the initial exchange date and repaid at maturity" ;
	<https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSTaxonomy/hasCoverageDescription> "all kinds of bonds, term deposits, bullet loans, and so forth" ;
	<https://www.omg.org/spec/Commons/Designators/hasDescription> "Principal payment fully at Initial Exchange Date (IED) and repaid at Maturity Date (MD). Fixed and variable rates." ;
	<https://www.omg.org/spec/Commons/Designators/hasTextualName> "Principal at Maturity" ;
	<https://www.omg.org/spec/Commons/TextDatatype/hasTextValue> "PAM" ;
	<https://www.omg.org/spec/MVF/MultipleVocabularyFacility/hasNarrowerEntry> <https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSTaxonomy/AlgorithmicContractCategory-FixedIncome> .
<https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSTaxonomy/ACTUSContractType-RepurchaseAgreement> a <http://www.w3.org/2002/07/owl#NamedIndividual> , <https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSTaxonomy/ACTUSContractType> ;
	<http://www.w3.org/2000/01/rdf-schema#label> "ACTUS contract type - repurchase agreement" ;
	<http://www.w3.org/2004/02/skos/core#definition> "cashflow classifier that applies to contracts that control and manage the sale and repurchase of assets on the books" ;
	<https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSTaxonomy/hasCoverageDescription> "Classical repo and reverse repo agreements." ;
	<https://www.omg.org/spec/Commons/Designators/hasDescription> "A Repo contract controls and manages the sale and repurchase of assets on the books." ;
	<https://www.omg.org/spec/Commons/Designators/hasTextualName> "Repurchase Agreement" ;
	<https://www.omg.org/spec/Commons/TextDatatype/hasTextValue> "REP" ;
	<https://www.omg.org/spec/MVF/MultipleVocabularyFacility/hasNarrowerEntry> <https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSTaxonomy/AlgorithmicContractCategory-CreditEnhancement> .
<https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSTaxonomy/ACTUSContractType-SecuritizationCreditRisk> <http://purl.org/dc/terms/source> "https://www.actusfrf.org/taxonomy" ;
	a <http://www.w3.org/2002/07/owl#NamedIndividual> , <https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSTaxonomy/ACTUSContractType> ;
	<http://www.w3.org/2000/01/rdf-schema#label> "ACTUS contract type - securitization credit risk" ;
	<http://www.w3.org/2004/02/skos/core#definition> "cashflow classifier that applies to securitization contracts ranked according to credit default" ;
	<https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSTaxonomy/hasCoverageDescription> "CDO's" ;
	<https://www.omg.org/spec/Commons/Designators/hasDescription> "Securitiazion contracts where contracs are ranked according to credit default. The lower ranked tranches are hit by the first defaults. Only when the lowest tranches are wiped out, the next higher tranch is hit." ;
	<https://www.omg.org/spec/Commons/Designators/hasTextualName> "Securitization Credit Risk" ;
	<https://www.omg.org/spec/Commons/TextDatatype/hasTextValue> "SCRCR" ;
	<https://www.omg.org/spec/MVF/MultipleVocabularyFacility/hasNarrowerEntry> <https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSTaxonomy/AlgorithmicContractCategory-Securitization> .
<https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSTaxonomy/ACTUSContractType-SecuritizationMarketRisk> <http://purl.org/dc/terms/source> "https://www.actusfrf.org/taxonomy" ;
	a <http://www.w3.org/2002/07/owl#NamedIndividual> , <https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSTaxonomy/ACTUSContractType> ;
	<http://www.w3.org/2000/01/rdf-schema#label> "ACTUS contract type - securitization market risk" ;
	<http://www.w3.org/2004/02/skos/core#definition> "cashflow classifier that applies to securitization contracts where all underlying contracts are treated equally" ;
	<http://www.w3.org/2004/02/skos/core#note> "The buyer of a tranche gets a part of the cash-flows." ;
	<https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSTaxonomy/hasCoverageDescription> "ABS's, MBS's of all sorts. Could be a simple tranche or more complex tranch like interest only and principal only." ;
	<https://www.omg.org/spec/Commons/Designators/hasDescription> "Securitization contracts where all underlying contracts are treated equal. The buyer of a tranche gets a part of the cash-flows." ;
	<https://www.omg.org/spec/Commons/Designators/hasTextualName> "Securitization Market Risk" ;
	<https://www.omg.org/spec/Commons/TextDatatype/hasTextValue> "SCRMR" ;
	<https://www.omg.org/spec/MVF/MultipleVocabularyFacility/hasNarrowerEntry> <https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSTaxonomy/AlgorithmicContractCategory-Securitization> .
<https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSTaxonomy/ACTUSContractType-Stock> <http://purl.org/dc/terms/source> "https://www.actusfrf.org/taxonomy" ;
	a <http://www.w3.org/2002/07/owl#NamedIndividual> , <https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSTaxonomy/ACTUSContractType> ;
	<http://www.w3.org/2000/01/rdf-schema#label> "ACTUS contract type - stock" ;
	<http://www.w3.org/2004/02/skos/core#definition> "cashflow classifier that applies to equity instruments representing ownership in a company, that is bought at a certain amount (normally market price), then follows an index" ;
	<https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSTaxonomy/hasCoverageDescription> "All straight stocks." ;
	<https://www.omg.org/spec/Commons/Designators/hasDescription> "Any instrument which is bought at a certain amount (market price normally) and then follows an index." ;
	<https://www.omg.org/spec/Commons/Designators/hasTextualName> "Stock" ;
	<https://www.omg.org/spec/Commons/TextDatatype/hasTextValue> "STK" ;
	<https://www.omg.org/spec/MVF/MultipleVocabularyFacility/hasNarrowerEntry> <https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSTaxonomy/AlgorithmicContractCategory-ExchangeTraded> .
<https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSTaxonomy/ACTUSContractType-Swap> <http://purl.org/dc/terms/source> "https://www.actusfrf.org/taxonomy" ;
	a <http://www.w3.org/2002/07/owl#NamedIndividual> , <https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSTaxonomy/ACTUSContractType> ;
	<http://www.w3.org/2000/01/rdf-schema#label> "ACTUS contract type - swap" ;
	<http://www.w3.org/2004/02/skos/core#definition> "cashflow classifier that applies to derivative contracts where two parties exchange contracts" ;
	<https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSTaxonomy/hasCoverageDescription> "All kind of swaps. The variety is defined by the underlying CT's which often are PAM and ANN in all its flavors. With each new basic CT the variety rises." ;
	<https://www.omg.org/spec/Commons/Designators/hasDescription> "Exchange of two basic CT's (PAM, ANN etc.). Normally one is fixed, the other variable. However all variants possible including different currencies for cross currency swaps, basic swaps or even different principal exchange programs." ;
	<https://www.omg.org/spec/Commons/Designators/hasTextualName> "Swap" ;
	<https://www.omg.org/spec/Commons/TextDatatype/hasTextValue> "SWAPS" ;
	<https://www.omg.org/spec/MVF/MultipleVocabularyFacility/hasNarrowerEntry> <https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSTaxonomy/AlgorithmicContractCategory-Symmetric> .
<https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSTaxonomy/ACTUSContractType-TotalReturnSwap> <http://purl.org/dc/terms/source> "https://www.actusfrf.org/taxonomy" ;
	a <http://www.w3.org/2002/07/owl#NamedIndividual> , <https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSTaxonomy/ACTUSContractType> ;
	<http://www.w3.org/2000/01/rdf-schema#label> "ACTUS contract type - total return swap" ;
	<http://www.w3.org/2004/02/skos/core#definition> "cashflow classifier that applies to swaps in which one party makes payments based on a set rate, either fixed or variable, while the other party makes payments based on the return of an underlying asset, which includes both the income it generates and any capital gains" ;
	<https://www.omg.org/spec/Commons/Designators/hasDescription> "A total return swap is a swap agreement in which one party makes payments based on a set rate, either fixed or variable, while the other party makes payments based on the return of an underlying asset, which includes both the income it generates and any capital gains." ;
	<https://www.omg.org/spec/Commons/Designators/hasTextualName> "Total Return Swap" ;
	<https://www.omg.org/spec/Commons/TextDatatype/hasTextValue> "TRSWP" ;
	<https://www.omg.org/spec/MVF/MultipleVocabularyFacility/hasNarrowerEntry> <https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSTaxonomy/AlgorithmicContractCategory-Securitization> .
<https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSTaxonomy/ACTUSContractType-UndefinedMaturityProfile> <http://purl.org/dc/terms/source> "https://www.actusfrf.org/taxonomy" ;
	a <http://www.w3.org/2002/07/owl#NamedIndividual> , <https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSTaxonomy/ACTUSContractType> ;
	<http://www.w3.org/2000/01/rdf-schema#label> "ACTUS contract type - undefined maturity profile" ;
	<http://www.w3.org/2004/02/skos/core#definition> "cashflow classifier that applies to contracts whose principal may be paid in and out at any point in time without prefixed schedule" ;
	<https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSTaxonomy/hasCoverageDescription> "Saving products of all kind, current accounts. In some countries even variable rate mortgages can be represented with this contract type." ;
	<https://www.omg.org/spec/Commons/Designators/hasDescription> "Principal paid in and out at any point in time without prefixed schedule. Interest calculated on outstanding and capitalized periodically. Needs link to a behavioral function describing expected flows." ;
	<https://www.omg.org/spec/Commons/Designators/hasTextualName> "Undefined Maturity Profile" ;
	<https://www.omg.org/spec/Commons/TextDatatype/hasTextValue> "UMP" ;
	<https://www.omg.org/spec/MVF/MultipleVocabularyFacility/hasNarrowerEntry> <https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSTaxonomy/AlgorithmicContractCategory-FixedIncome> .
<https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSTaxonomy/ACTUSContractType> a <http://www.w3.org/2002/07/owl#Class> , <http://www.w3.org/2002/07/owl#NamedIndividual> ;
	<http://www.w3.org/2000/01/rdf-schema#label> "ACTUS contract type" ;
	<http://www.w3.org/2000/01/rdf-schema#subClassOf> <https://www.omg.org/spec/Commons/Classifiers/Classifier> , <https://www.omg.org/spec/MVF/MultipleVocabularyFacility/VocabularyEntry> , _:c14n1305 , _:c14n2846 , _:c14n389 ;
	<http://www.w3.org/2004/02/skos/core#definition> "classifier for an algorithmic capability, i.e., the rules, from which the cashflows for a credit agreement, financial instrument or related contract, based on their characteristics, can be analyzed" ;
	<https://www.omg.org/spec/Commons/AnnotationVocabulary/explanatoryNote> "Cashflows in ACTUS are classified as basic, combined / derivatives, or credit enhancement, and then each of these areas breaks down into a number of subclassifications." ;
	<https://www.omg.org/spec/Commons/TextDatatype/hasTextValue> "CT" .
<https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSTaxonomy/AlgorithmicContractCategory-CreditEnhancement> <http://purl.org/dc/terms/source> "https://www.actusfrf.org/taxonomy" ;
	a <http://www.w3.org/2002/07/owl#NamedIndividual> , <https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSTaxonomy/AlgorithmicContractCategory> ;
	<http://www.w3.org/2000/01/rdf-schema#label> "algorithmic contract category - credit enhancement" ;
	<http://www.w3.org/2004/02/skos/core#definition> "cashflow category that applies to basic contracts processed as members of the credit enhancement class" ;
	<https://www.omg.org/spec/Commons/TextDatatype/hasTextValue> "Credit Enhancement" .
<https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSTaxonomy/AlgorithmicContractCategory-ExchangeTraded> <http://purl.org/dc/terms/source> "https://www.actusfrf.org/taxonomy" ;
	a <http://www.w3.org/2002/07/owl#NamedIndividual> , <https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSTaxonomy/AlgorithmicContractCategory> ;
	<http://www.w3.org/2000/01/rdf-schema#label> "algorithmic contract category - exchange traded" ;
	<http://www.w3.org/2004/02/skos/core#definition> "cashflow category that applies to basic contracts processed as members of the exchange traded class" ;
	<https://www.omg.org/spec/Commons/TextDatatype/hasTextValue> "Exchange Traded" .
<https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSTaxonomy/AlgorithmicContractCategory-FixedIncome> <http://purl.org/dc/terms/source> "https://www.actusfrf.org/taxonomy" ;
	a <http://www.w3.org/2002/07/owl#NamedIndividual> , <https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSTaxonomy/AlgorithmicContractCategory> ;
	<http://www.w3.org/2000/01/rdf-schema#label> "algorithmic contract category - fixed income" ;
	<http://www.w3.org/2004/02/skos/core#definition> "cashflow category that applies to basic contracts processed as members of the fixed-income class" ;
	<https://www.omg.org/spec/Commons/TextDatatype/hasTextValue> "Fixed Income" .
<https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSTaxonomy/AlgorithmicContractCategory-Options> <http://purl.org/dc/terms/source> "https://www.actusfrf.org/taxonomy" ;
	a <http://www.w3.org/2002/07/owl#NamedIndividual> , <https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSTaxonomy/AlgorithmicContractCategory> ;
	<http://www.w3.org/2000/01/rdf-schema#label> "algorithmic contract category - options" ;
	<http://www.w3.org/2004/02/skos/core#definition> "cashflow category that applies to combined contracts processed as members of the options class" ;
	<https://www.omg.org/spec/Commons/TextDatatype/hasTextValue> "Options" .
<https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSTaxonomy/AlgorithmicContractCategory-Securitization> <http://purl.org/dc/terms/source> "https://www.actusfrf.org/taxonomy" ;
	a <http://www.w3.org/2002/07/owl#NamedIndividual> , <https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSTaxonomy/AlgorithmicContractCategory> ;
	<http://www.w3.org/2000/01/rdf-schema#label> "algorithmic contract category - securitization" ;
	<http://www.w3.org/2004/02/skos/core#definition> "cashflow category that applies to combined contracts processed as members of the securitization class" ;
	<https://www.omg.org/spec/Commons/TextDatatype/hasTextValue> "Securitization" .
<https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSTaxonomy/AlgorithmicContractCategory-Symmetric> <http://purl.org/dc/terms/source> "https://www.actusfrf.org/taxonomy" ;
	a <http://www.w3.org/2002/07/owl#NamedIndividual> , <https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSTaxonomy/AlgorithmicContractCategory> ;
	<http://www.w3.org/2000/01/rdf-schema#label> "algorithmic contract category - symmetric" ;
	<http://www.w3.org/2004/02/skos/core#definition> "cashflow category that applies to combined contracts processed as members of the symmetric class" ;
	<https://www.omg.org/spec/Commons/TextDatatype/hasTextValue> "Symmetric" .
<https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSTaxonomy/AlgorithmicContractCategory> a <http://www.w3.org/2002/07/owl#Class> ;
	<http://www.w3.org/2000/01/rdf-schema#label> "algorithmic contract category" ;
	<http://www.w3.org/2000/01/rdf-schema#subClassOf> <https://www.omg.org/spec/Commons/Classifiers/Classifier> , <https://www.omg.org/spec/MVF/MultipleVocabularyFacility/VocabularyEntry> , _:c14n1580 , _:c14n1653 ;
	<http://www.w3.org/2004/02/skos/core#definition> "classifier for the cashflows generated by a group of credit agreements, financial instruments, or related contracts, within an ACTUS cashflow family, based on their more specific, common characteristics" .
<https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSTaxonomy/AlgorithmicContractFamily-Basic> <http://purl.org/dc/terms/source> "https://www.actusfrf.org/taxonomy" ;
	a <http://www.w3.org/2002/07/owl#NamedIndividual> , <https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSTaxonomy/AlgorithmicContractFamily> ;
	<http://www.w3.org/2000/01/rdf-schema#label> "algorithmic contract family - basic" ;
	<http://www.w3.org/2004/02/skos/core#definition> "contract family classifier that applies to single (simple) contracts" ;
	<https://www.omg.org/spec/Commons/AnnotationVocabulary/explanatoryNote> "Basic, or atomic contracts include those individual contracts that have schedules associated with them, i.e., that have traditional maturity dates and future cash flows, or that represent demand deposits, i.e., accounts that have no structured maturity term, whose cash flows or amounts depend on counterparty behavior, as well as other assets such as stocks. Such contracts and related assets are typically bilateral." ;
	<https://www.omg.org/spec/Commons/TextDatatype/hasTextValue> "Basic" .
<https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSTaxonomy/AlgorithmicContractFamily-Combined> <http://purl.org/dc/terms/source> "https://www.actusfrf.org/taxonomy" ;
	a <http://www.w3.org/2002/07/owl#NamedIndividual> , <https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSTaxonomy/AlgorithmicContractFamily> ;
	<http://www.w3.org/2000/01/rdf-schema#label> "algorithmic contract family - combined" ;
	<http://www.w3.org/2004/02/skos/core#definition> "contract family classifier that applies to combined (complex, derived) contracts, such as derivatives" ;
	<https://www.omg.org/spec/Commons/TextDatatype/hasTextValue> "Combined" .
<https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSTaxonomy/AlgorithmicContractFamily-CreditEnhancement> <http://purl.org/dc/terms/source> "https://www.actusfrf.org/taxonomy" ;
	a <http://www.w3.org/2002/07/owl#NamedIndividual> , <https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSTaxonomy/AlgorithmicContractFamily> ;
	<http://www.w3.org/2000/01/rdf-schema#label> "algorithmic contract family - credit enhancement" ;
	<http://www.w3.org/2004/02/skos/core#definition> "contract family classifier that applies to agreements that are related to other agreements or accounts, and provide credit support to existing contracts" ;
	<https://www.omg.org/spec/Commons/TextDatatype/hasTextValue> "Credit Enhancement" .
<https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSTaxonomy/AlgorithmicContractFamily> a <http://www.w3.org/2002/07/owl#Class> ;
	<http://www.w3.org/2000/01/rdf-schema#label> "algorithmic contract family" ;
	<http://www.w3.org/2000/01/rdf-schema#subClassOf> <https://www.omg.org/spec/Commons/Classifiers/Classifier> , <https://www.omg.org/spec/MVF/MultipleVocabularyFacility/VocabularyEntry> , _:c14n1332 , _:c14n170 ;
	<http://www.w3.org/2004/02/skos/core#definition> "classifier for a collection of types of contracts, such as credit agreements, financial instruments, or related kinds of contracts, based on their common characteristics from an ACTUS perspective" .
<https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSTaxonomy/AlgorithmicContractTypesClassificationScheme> a <http://www.w3.org/2002/07/owl#NamedIndividual> , <https://www.omg.org/spec/Commons/Classifiers/ClassificationScheme> , <https://www.omg.org/spec/Commons/CodesAndCodeSets/CodeSet> , <https://www.omg.org/spec/MVF/MultipleVocabularyFacility/Vocabulary> , _:c14n1257 ;
	<http://www.w3.org/2000/01/rdf-schema#label> "Algorithmic Contract Types classification scheme" ;
	<http://www.w3.org/2004/02/skos/core#definition> "classification scheme and controlled vocabulary behind the ACTUS modeling paradigm, in which standardized Contract Types (CTs) are the granular building blocks of the financial world" ;
	<https://www.omg.org/spec/Commons/AnnotationVocabulary/abbreviation> "ACTUS classification scheme" ;
	<https://www.omg.org/spec/Commons/AnnotationVocabulary/adaptedFrom> "https://www.actusfrf.org/methodology"^^<http://www.w3.org/2001/XMLSchema#anyURI> .
<https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSTaxonomy/hasCoverageDescription> a <http://www.w3.org/2002/07/owl#DatatypeProperty> ;
	<http://www.w3.org/2000/01/rdf-schema#label> "has coverage description" ;
	<http://www.w3.org/2000/01/rdf-schema#subPropertyOf> <https://www.omg.org/spec/Commons/Designators/hasDescription> ;
	<http://www.w3.org/2004/02/skos/core#definition> "describes the range of contracts that the classifier applies to" .
<https://spec.edmcouncil.org/fibo/ontology/BE/FunctionalEntities/FunctionalEntities/Association> a <http://www.w3.org/2002/07/owl#Class> ;
	<http://www.w3.org/2000/01/rdf-schema#label> "association" ;
	<http://www.w3.org/2000/01/rdf-schema#subClassOf> <https://spec.edmcouncil.org/fibo/ontology/BE/LegalEntities/FormalBusinessOrganizations/NotForProfitOrganization> , _:c14n339 ;
	<http://www.w3.org/2004/02/skos/core#definition> "not-for-profit organization that is owned by and acts on behalf of its members" ;
	<https://www.omg.org/spec/Commons/AnnotationVocabulary/explanatoryNote> "Associations include trade or business associations, industry sector-specific groups, and professional associations, among others. They also commonly include cooperative farms and markets." .
<https://spec.edmcouncil.org/fibo/ontology/BE/FunctionalEntities/FunctionalEntities/CooperativeSociety> a <http://www.w3.org/2002/07/owl#Class> ;
	<http://www.w3.org/2000/01/rdf-schema#label> "cooperative society" ;
	<http://www.w3.org/2000/01/rdf-schema#subClassOf> <https://spec.edmcouncil.org/fibo/ontology/BE/FunctionalEntities/FunctionalEntities/FunctionalBusinessEntity> ;
	<http://www.w3.org/2004/02/skos/core#definition> "organization owned by and operated for the benefit of those using its services" ;
	<http://www.w3.org/2004/02/skos/core#example> "In agriculture, there are broadly three types of cooperatives: a machinery pool, a manufacturing/marketing cooperative, and a credit union" ;
	<https://www.omg.org/spec/Commons/AnnotationVocabulary/synonym> "cooperative" .
<https://spec.edmcouncil.org/fibo/ontology/BE/FunctionalEntities/FunctionalEntities/FamilyOffice> a <http://www.w3.org/2002/07/owl#Class> ;
	<http://www.w3.org/2000/01/rdf-schema#label> "family office" ;
	<http://www.w3.org/2000/01/rdf-schema#subClassOf> <https://spec.edmcouncil.org/fibo/ontology/BE/FunctionalEntities/FunctionalEntities/FunctionalBusinessEntity> ;
	<http://www.w3.org/2004/02/skos/core#definition> "organization that assumes the day-to-day administration and management of a family's affairs" ;
	<https://www.omg.org/spec/Commons/AnnotationVocabulary/explanatoryNote> "Family offices are often privately held companies set up to handle investment and wealth management for wealthy families." .
<https://spec.edmcouncil.org/fibo/ontology/BE/FunctionalEntities/FunctionalEntities/FunctionalBusinessEntity> a <http://www.w3.org/2002/07/owl#Class> ;
	<http://www.w3.org/2000/01/rdf-schema#label> "functional business entity" ;
	<http://www.w3.org/2000/01/rdf-schema#subClassOf> <https://spec.edmcouncil.org/fibo/ontology/BE/FunctionalEntities/FunctionalEntities/FunctionalEntity> , _:c14n756 ;
	<http://www.w3.org/2004/02/skos/core#definition> "functional entity defined in terms of the nature of the commercial activity it conducts" .
<https://spec.edmcouncil.org/fibo/ontology/BE/FunctionalEntities/FunctionalEntities/FunctionalEntity> a <http://www.w3.org/2002/07/owl#Class> ;
	<http://www.w3.org/2000/01/rdf-schema#label> "functional entity" ;
	<http://www.w3.org/2000/01/rdf-schema#subClassOf> <https://www.omg.org/spec/Commons/RolesAndCompositions/FunctionalRole> , _:c14n1596 ;
	<http://www.w3.org/2004/02/skos/core#definition> "party defined in terms of a function they or it performs" .
<https://spec.edmcouncil.org/fibo/ontology/BE/FunctionalEntities/FunctionalEntities/Merchant> a <http://www.w3.org/2002/07/owl#Class> ;
	<http://www.w3.org/2000/01/rdf-schema#label> "merchant" ;
	<http://www.w3.org/2000/01/rdf-schema#subClassOf> <https://spec.edmcouncil.org/fibo/ontology/BE/FunctionalEntities/FunctionalEntities/FunctionalBusinessEntity> , _:c14n263 , _:c14n2665 ;
	<http://www.w3.org/2004/02/skos/core#definition> "party engaged in the purchase and sales of goods produced by others for profit" .
<https://spec.edmcouncil.org/fibo/ontology/BE/FunctionalEntities/FunctionalEntities/MerchantCategoryCode> a <http://www.w3.org/2002/07/owl#Class> ;
	<http://www.w3.org/2000/01/rdf-schema#label> "merchant category code" ;
	<http://www.w3.org/2000/01/rdf-schema#subClassOf> <https://spec.edmcouncil.org/fibo/ontology/FND/Arrangements/ClassificationSchemes/IndustrySectorClassifier> , <https://www.omg.org/spec/Commons/CodesAndCodeSets/CodeElement> , _:c14n1192 , _:c14n3106 , _:c14n3350 , _:c14n817 ;
	<http://www.w3.org/2004/02/skos/core#definition> "code used internationally to classify a merchant" ;
	<https://www.omg.org/spec/Commons/AnnotationVocabulary/abbreviation> "MCC" ;
	<https://www.omg.org/spec/Commons/AnnotationVocabulary/adaptedFrom> "ISO 18245:2003 Retail financial services - Merchant category codes" ;
	<https://www.omg.org/spec/Commons/AnnotationVocabulary/explanatoryNote> "Merchant categories are organized by the type of business, trade or services supplied. Certain category codes including those for very large businesses, such as airlines and some hotel chains, may be delineated to the point of identifying the business. Merchant category codes and/or the descriptions of the service categories are frequently used in credit card and other banking transactions for analysis, transaction classification, such as for use in promotional rewards, and sometimes tax-related purposes." , "Values are specified only for those merchant categories that are generally expected to originate retail financial transactions. Criteria for establishing a new category code includes (a) the merchant category is reasonable and substantially different from all other merchant categories currently represented in the list of code values; (b) the merchant category is separate and distinct from all other industries currently represented in the list of code values; (c) the proposal describes a merchant category or industry, and not a process; (d) the minimum annual sales volume of merchants included in the merchant category, taken as a whole, is USD 10 million; and (e) sufficient justification for the addition of a new code value is found." .
<https://spec.edmcouncil.org/fibo/ontology/BE/FunctionalEntities/FunctionalEntities/MerchantCategoryCodeScheme> a <http://www.w3.org/2002/07/owl#Class> ;
	<http://www.w3.org/2000/01/rdf-schema#label> "merchant category code scheme" ;
	<http://www.w3.org/2000/01/rdf-schema#subClassOf> <https://spec.edmcouncil.org/fibo/ontology/FND/Arrangements/ClassificationSchemes/IndustrySectorClassificationScheme> , _:c14n3485 ;
	<http://www.w3.org/2004/02/skos/core#definition> "scheme defining a set of codes for classifying merchant services" ;
	<https://www.omg.org/spec/Commons/AnnotationVocabulary/adaptedFrom> "ISO 18245:2003 Retail financial services - Merchant category codes" ;
	<https://www.omg.org/spec/Commons/AnnotationVocabulary/explanatoryNote> "ISO 18245 provides a set of merchant category codes that are used internationally. Some countries, regional governments, banks, and other large organizations extend the basic codes with custom additions to fit business needs." .
<https://spec.edmcouncil.org/fibo/ontology/BE/FunctionalEntities/FunctionalEntities/MerchantIdentifier> a <http://www.w3.org/2002/07/owl#Class> ;
	<http://www.w3.org/2000/01/rdf-schema#label> "merchant identifier" ;
	<http://www.w3.org/2000/01/rdf-schema#subClassOf> <https://www.omg.org/spec/Commons/Identifiers/Identifier> , _:c14n983 ;
	<http://www.w3.org/2004/02/skos/core#definition> "unique identifier for a merchant that is used, for example, for transaction interchange purposes" .
<https://spec.edmcouncil.org/fibo/ontology/BE/FunctionalEntities/FunctionalEntities/Syndicate> a <http://www.w3.org/2002/07/owl#Class> ;
	<http://www.w3.org/2000/01/rdf-schema#label> "syndicate"@en ;
	<http://www.w3.org/2000/01/rdf-schema#subClassOf> <https://www.omg.org/spec/Commons/Organizations/Organization> , _:c14n444 ;
	<http://www.w3.org/2004/02/skos/core#definition> "temporary, self-organizing group of people, companies, corporations or entities organized as an alliance whose purpose is to transact some specific business, or to pursue or promote a shared interest"@en ;
	<http://www.w3.org/2004/02/skos/core#example> "For example, when a group of investment banks work together to bring a new issue of securities to the market, they form a distributing syndicate. Other types of syndicates are created for underwriting, banking, and insurance."@en ;
	<https://www.omg.org/spec/Commons/AnnotationVocabulary/explanatoryNote> "A syndicate is a temporary alliance formed by people or businesses to handle a large transaction that would be hard to execute individually. Syndication makes it easy for businesses to pool their resources and share risks."@en .
<https://spec.edmcouncil.org/fibo/ontology/BE/FunctionalEntities/FunctionalEntities/SyndicateMember> a <http://www.w3.org/2002/07/owl#Class> ;
	<http://www.w3.org/2000/01/rdf-schema#label> "syndicate member"@en ;
	<http://www.w3.org/2000/01/rdf-schema#subClassOf> <https://www.omg.org/spec/Commons/Organizations/OrganizationMember> , _:c14n3263 ;
	<http://www.w3.org/2004/02/skos/core#definition> "role of an individual or organization that is a member of an alliance set up to pool resources and share risk with respect to a large transaction"@en ;
	<https://www.omg.org/spec/Commons/AnnotationVocabulary/synonym> "participating member"@en , "syndicate participant"@en .
<https://spec.edmcouncil.org/fibo/ontology/BE/FunctionalEntities/FunctionalEntities/hasMerchantCategoryDescription> a <http://www.w3.org/2002/07/owl#DatatypeProperty> ;
	<http://www.w3.org/2000/01/rdf-schema#domain> <https://spec.edmcouncil.org/fibo/ontology/BE/FunctionalEntities/FunctionalEntities/MerchantCategoryCode> ;
	<http://www.w3.org/2000/01/rdf-schema#label> "has merchant category description" ;
	<http://www.w3.org/2000/01/rdf-schema#range> <http://www.w3.org/2001/XMLSchema#string> ;
	<http://www.w3.org/2004/02/skos/core#definition> "provides a text description of the sector to which the code applies" .
<https://spec.edmcouncil.org/fibo/ontology/BE/FunctionalEntities/Publishers/APIFirstMarketDataProvider> a <http://www.w3.org/2002/07/owl#Class> ;
	<http://www.w3.org/2000/01/rdf-schema#label> "API-first market data provider" ;
	<http://www.w3.org/2000/01/rdf-schema#subClassOf> <https://spec.edmcouncil.org/fibo/ontology/BE/FunctionalEntities/Publishers/MarketDataProvider> ;
	<http://www.w3.org/2004/02/skos/core#definition> "market data provider that delivers financial information primarily through programmatic interfaces, offering real-time or historical data via APIs for automated consumption" .
<https://spec.edmcouncil.org/fibo/ontology/BE/FunctionalEntities/Publishers/AlternativeDataProvider> a <http://www.w3.org/2002/07/owl#Class> ;
	<http://www.w3.org/2000/01/rdf-schema#label> "alternative data provider" ;
	<http://www.w3.org/2000/01/rdf-schema#subClassOf> <https://spec.edmcouncil.org/fibo/ontology/BE/FunctionalEntities/Publishers/MarketDataProvider> ;
	<http://www.w3.org/2004/02/skos/core#definition> "market data provider that supplies non-traditional datasets derived from sources such as web activity, sentiment analysis, geospatial signals, or other alternative information channels" .
<https://spec.edmcouncil.org/fibo/ontology/BE/FunctionalEntities/Publishers/CryptoDigitalAssetDataProvider> a <http://www.w3.org/2002/07/owl#Class> ;
	<http://www.w3.org/2000/01/rdf-schema#label> "crypto and digital-asset data provider" ;
	<http://www.w3.org/2000/01/rdf-schema#subClassOf> <https://spec.edmcouncil.org/fibo/ontology/BE/FunctionalEntities/Publishers/MarketDataProvider> ;
	<http://www.w3.org/2004/02/skos/core#definition> "market data provider that supplies pricing, reference data, and analytics for digital tokens and crypto-assets" .
<https://spec.edmcouncil.org/fibo/ontology/BE/FunctionalEntities/Publishers/DerivativesVolatilityDataProvider> a <http://www.w3.org/2002/07/owl#Class> ;
	<http://www.w3.org/2000/01/rdf-schema#label> "derivatives and volatility data provider" ;
	<http://www.w3.org/2000/01/rdf-schema#subClassOf> <https://spec.edmcouncil.org/fibo/ontology/BE/FunctionalEntities/Publishers/MarketDataProvider> ;
	<http://www.w3.org/2004/02/skos/core#definition> "market data provider that supplies pricing, implied-volatility surfaces, and analytics for derivatives, including options, futures, and structured products" .
<https://spec.edmcouncil.org/fibo/ontology/BE/FunctionalEntities/Publishers/ExchangeSourcedDataProvider> a <http://www.w3.org/2002/07/owl#Class> ;
	<http://www.w3.org/2000/01/rdf-schema#label> "exchange-sourced data provider" ;
	<http://www.w3.org/2000/01/rdf-schema#subClassOf> <https://spec.edmcouncil.org/fibo/ontology/BE/FunctionalEntities/Publishers/MarketDataProvider> ;
	<http://www.w3.org/2004/02/skos/core#definition> "market data provider that distributes financial information originating directly from trading venues, including order-book data, trades, quotes, and venue-specific reference data" .
<https://spec.edmcouncil.org/fibo/ontology/BE/FunctionalEntities/Publishers/FixedIncomeSpecialistProvider> a <http://www.w3.org/2002/07/owl#Class> ;
	<http://www.w3.org/2000/01/rdf-schema#label> "fixed income specialist provider" ;
	<http://www.w3.org/2000/01/rdf-schema#subClassOf> <https://spec.edmcouncil.org/fibo/ontology/BE/FunctionalEntities/Publishers/MarketDataProvider> ;
	<http://www.w3.org/2004/02/skos/core#definition> "market data provider that focuses on pricing, reference data, and analytics for fixed-income instruments such as bonds, credit products, and money-market securities" .
<https://spec.edmcouncil.org/fibo/ontology/BE/FunctionalEntities/Publishers/InstitutionalMarketDataProvider> a <http://www.w3.org/2002/07/owl#Class> ;
	<http://www.w3.org/2000/01/rdf-schema#label> "institutional market data provider" ;
	<http://www.w3.org/2000/01/rdf-schema#subClassOf> <https://spec.edmcouncil.org/fibo/ontology/BE/FunctionalEntities/Publishers/MarketDataProvider> ;
	<http://www.w3.org/2004/02/skos/core#definition> "market data provider that supplies multi-asset financial information, analytics, and reference data to financial institutions such as banks, asset managers, and trading firms" ;
	<https://www.omg.org/spec/Commons/AnnotationVocabulary/explanatoryNote> "Institutional market data providers Offer real-time and historical market data for various asset classes. They ensure data accuracy and compliance with regulatory standards. They typically provide tools for data visualization and analysis to aid decision-making. They may also facilitate access to proprietary research and market insights. Many such firms provide APIs and other options for ease of integration with trading platforms and risk management systems" .
<https://spec.edmcouncil.org/fibo/ontology/BE/FunctionalEntities/Publishers/MarketDataProvider> a <http://www.w3.org/2002/07/owl#Class> ;
	<http://www.w3.org/2000/01/rdf-schema#label> "market data provider" ;
	<http://www.w3.org/2000/01/rdf-schema#subClassOf> <https://spec.edmcouncil.org/fibo/ontology/BE/FunctionalEntities/Publishers/Publisher> ;
	<http://www.w3.org/2004/02/skos/core#definition> "publisher that supplies financial information, reference data, analytics, or related datasets used in financial markets" ;
	<https://www.omg.org/spec/Commons/AnnotationVocabulary/explanatoryNote> "Market data providers include exchanges and independent data vendors, among others. Market valuation and related control and risk processes typically require explicit documentation of the source for a given market rate, such as an interest rate benchmark, exchange rate, stock prices, and so forth." .
<https://spec.edmcouncil.org/fibo/ontology/BE/FunctionalEntities/Publishers/Publication> a <http://www.w3.org/2002/07/owl#Class> ;
	<http://www.w3.org/2000/01/rdf-schema#label> "publication" ;
	<http://www.w3.org/2000/01/rdf-schema#subClassOf> <https://www.omg.org/spec/Commons/Documents/Document> ;
	<http://www.w3.org/2004/02/skos/core#definition> "document offered for general distribution and usually produced in multiple copies" ;
	<https://www.omg.org/spec/Commons/AnnotationVocabulary/adaptedFrom> "ISO 5127:2017, Information and documentation - Foundation and vocabulary" ;
	<https://www.omg.org/spec/Commons/AnnotationVocabulary/explanatoryNote> "A publication can be anything made public by print (such as a newspaper, magazine, pamphlet, letter, telegram, via computer modem or program, or in a poster, brochure or pamphlet), orally, or by broadcast (radio, television)." .
<https://spec.edmcouncil.org/fibo/ontology/BE/FunctionalEntities/Publishers/Publisher> a <http://www.w3.org/2002/07/owl#Class> ;
	<http://www.w3.org/2000/01/rdf-schema#label> "publisher" ;
	<http://www.w3.org/2000/01/rdf-schema#subClassOf> <https://www.omg.org/spec/Commons/PartiesAndSituations/PartyRole> , _:c14n190 ;
	<http://www.w3.org/2004/02/skos/core#definition> "role of person(s) or organization(s) responsible for the printing or distribution of an item, whether in digital or print (physical) form" ;
	<https://www.omg.org/spec/Commons/AnnotationVocabulary/adaptedFrom> "ISO 10161-1:2014(en), Information and documentation - Open Systems Interconnection - Interlibrary Loan Application Protocol Specification - Part 1: Protocol specification" ;
	<https://www.omg.org/spec/Commons/AnnotationVocabulary/explanatoryNote> "Publishers may also include banks, government agencies and the like." .
<https://spec.edmcouncil.org/fibo/ontology/BE/FunctionalEntities/Publishers/ReferenceDataSpecialistProvider> a <http://www.w3.org/2002/07/owl#Class> ;
	<http://www.w3.org/2000/01/rdf-schema#label> "reference data specialist provider" ;
	<http://www.w3.org/2000/01/rdf-schema#subClassOf> <https://spec.edmcouncil.org/fibo/ontology/BE/FunctionalEntities/Publishers/MarketDataProvider> ;
	<http://www.w3.org/2004/02/skos/core#definition> "market data provider that focuses on authoritative reference data, including corporate actions, instrument identifiers, classifications, and entity information aligned with ISO standards" .
<https://spec.edmcouncil.org/fibo/ontology/BE/FunctionalEntities/Publishers/hasPublisher> a <http://www.w3.org/2002/07/owl#ObjectProperty> ;
	<http://www.w3.org/2000/01/rdf-schema#domain> <https://spec.edmcouncil.org/fibo/ontology/BE/FunctionalEntities/Publishers/Publication> ;
	<http://www.w3.org/2000/01/rdf-schema#label> "has publisher" ;
	<http://www.w3.org/2000/01/rdf-schema#range> <https://spec.edmcouncil.org/fibo/ontology/BE/FunctionalEntities/Publishers/Publisher> ;
	<http://www.w3.org/2000/01/rdf-schema#subPropertyOf> <https://www.omg.org/spec/Commons/PartiesAndSituations/hasPartyRole> , <https://www.omg.org/spec/Commons/RolesAndCompositions/manifests> ;
	<http://www.w3.org/2002/07/owl#inverseOf> <https://spec.edmcouncil.org/fibo/ontology/BE/FunctionalEntities/Publishers/publishes> ;
	<http://www.w3.org/2004/02/skos/core#definition> "indicates the party in the role of issuing the information" .
<https://spec.edmcouncil.org/fibo/ontology/BE/FunctionalEntities/Publishers/isPublishedBy> a <http://www.w3.org/2002/07/owl#ObjectProperty> ;
	<http://www.w3.org/2000/01/rdf-schema#domain> <https://spec.edmcouncil.org/fibo/ontology/BE/FunctionalEntities/Publishers/Publication> ;
	<http://www.w3.org/2000/01/rdf-schema#label> "is published by" ;
	<http://www.w3.org/2000/01/rdf-schema#range> <https://www.omg.org/spec/Commons/PartiesAndSituations/Party> ;
	<http://www.w3.org/2000/01/rdf-schema#subPropertyOf> <https://www.omg.org/spec/Commons/PartiesAndSituations/hasParty> ;
	<http://www.w3.org/2004/02/skos/core#definition> "identifies the independent party (i.e., the individual or organization) that disseminates the material" .
<https://spec.edmcouncil.org/fibo/ontology/BE/FunctionalEntities/Publishers/publishes> a <http://www.w3.org/2002/07/owl#ObjectProperty> ;
	<http://www.w3.org/2000/01/rdf-schema#domain> <https://spec.edmcouncil.org/fibo/ontology/BE/FunctionalEntities/Publishers/Publisher> ;
	<http://www.w3.org/2000/01/rdf-schema#label> "publishes" ;
	<http://www.w3.org/2000/01/rdf-schema#range> <https://spec.edmcouncil.org/fibo/ontology/BE/FunctionalEntities/Publishers/Publication> ;
	<http://www.w3.org/2000/01/rdf-schema#subPropertyOf> <https://www.omg.org/spec/Commons/RolesAndCompositions/isManifestedIn> ;
	<http://www.w3.org/2004/02/skos/core#definition> "prepares and issues material for public consumption" .
<https://spec.edmcouncil.org/fibo/ontology/BE/GovernmentEntities/AsianJurisdiction/CentralAsiaGovernmentEntitiesAndJurisdictions/GovernmentOfTheKyrgyzRepublic> a <http://www.w3.org/2002/07/owl#NamedIndividual> , <https://spec.edmcouncil.org/fibo/ontology/BE/GovernmentEntities/GovernmentEntities/NationalGovernment> ;

	<http://www.w3.org/2000/01/rdf-schema#subPropertyOf> <https://www.omg.org/spec/Commons/DatesAndTimes/hasDatePeriod> ;
	<http://www.w3.org/2004/02/skos/core#definition> "window of time during which the lookback is effective"@en .
<https://spec.edmcouncil.org/fibo/ontology/DER/DerivativesContracts/ExoticOptions/hasMonitoringFrequency> a <http://www.w3.org/2002/07/owl#DatatypeProperty> ;
	<http://www.w3.org/2000/01/rdf-schema#domain> <https://spec.edmcouncil.org/fibo/ontology/DER/DerivativesContracts/ExoticOptions/BarrierOption> ;
	<http://www.w3.org/2000/01/rdf-schema#label> "has monitoring frequency"@en ;
	<http://www.w3.org/2000/01/rdf-schema#range> <http://www.w3.org/2001/XMLSchema#positiveInteger> ;
	<http://www.w3.org/2004/02/skos/core#definition> "has frequency with respect to how often, in days, the asset price is checked to see if the barrier has been breached"@en .

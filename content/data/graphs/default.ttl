	<http://www.w3.org/2004/02/skos/core#prefLabel> "Sweet Pepper"@en .
<http://www.co-ode.org/ontologies/pizza/pizza.owl#ThinAndCrispyBase> a <http://www.w3.org/2002/07/owl#Class> ;
	<http://www.w3.org/2000/01/rdf-schema#label> "BaseFinaEQuebradica"@pt , "ThinAndCrispyBase"@en ;
	<http://www.w3.org/2000/01/rdf-schema#subClassOf> <http://www.co-ode.org/ontologies/pizza/pizza.owl#PizzaBase> ;
	<http://www.w3.org/2004/02/skos/core#prefLabel> "Thin And Crispy Base"@en .
<http://www.co-ode.org/ontologies/pizza/pizza.owl#ThinAndCrispyPizza> a <http://www.w3.org/2002/07/owl#Class> ;
	<http://www.w3.org/2000/01/rdf-schema#label> "ThinAndCrispyPizza"@en ;
	<http://www.w3.org/2002/07/owl#equivalentClass> _:c14n148 ;
	<http://www.w3.org/2004/02/skos/core#prefLabel> "Thin And Crispy Pizza"@en .
<http://www.co-ode.org/ontologies/pizza/pizza.owl#TobascoPepperSauce> a <http://www.w3.org/2002/07/owl#Class> ;
	<http://www.w3.org/2000/01/rdf-schema#label> "MolhoTobascoPepper"@pt , "TobascoPepperSauceTopping"@en ;

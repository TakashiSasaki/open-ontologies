	a <http://www.w3.org/2002/07/owl#Class> ;
	<http://www.w3.org/2000/01/rdf-schema#isDefinedBy> <https://www.omg.org/spec/LCC/Languages/LanguageRepresentation/> ;
	<http://www.w3.org/2000/01/rdf-schema#label> "language group" ;
	<http://www.w3.org/2000/01/rdf-schema#subClassOf> <https://www.omg.org/spec/LCC/Languages/LanguageRepresentation/Collection> ;
	<http://www.w3.org/2004/02/skos/core#definition> "a collection of two or more individual languages, treated as a group for some purpose" ;
	<http://www.w3.org/2004/02/skos/core#note> "See section 4.6 in ISO 639-4 for additional explanatory material for language groups." .
<https://www.omg.org/spec/LCC/Languages/LanguageRepresentation/LanguageIdentifier> <http://purl.org/dc/terms/source> "Section 3.5, ISO 639-4" ;
	a <http://www.w3.org/2002/07/owl#Class> ;
	<http://www.w3.org/2000/01/rdf-schema#isDefinedBy> <https://www.omg.org/spec/LCC/Languages/LanguageRepresentation/> ;
	<http://www.w3.org/2000/01/rdf-schema#label> "language identifier" ;
	<http://www.w3.org/2000/01/rdf-schema#subClassOf> <https://www.omg.org/spec/LCC/Languages/LanguageRepresentation/CodeElement> , <https://www.omg.org/spec/LCC/Languages/LanguageRepresentation/Identifier> , _:c14n1523 , _:c14n612 ;
	<http://www.w3.org/2004/02/skos/core#altLabel> "language symbol" ;
	<http://www.w3.org/2004/02/skos/core#definition> "a string of characters that uniquely identifies a linguistic entity" ;
	<http://www.w3.org/2004/02/skos/core#prefLabel> "language identifier" ;
	<http://www.w3.org/2004/02/skos/core#scopeNote> "In the language codes of Parts 1, 2, 3, and 5 of ISO 639, each language identifier is composed of two or three letters." .
<https://www.omg.org/spec/LCC/Languages/LanguageRepresentation/LanguageVariant> <http://purl.org/dc/terms/source> "Section 3.14, ISO 639-4" ;
	a <http://www.w3.org/2002/07/owl#Class> ;
	<http://www.w3.org/2000/01/rdf-schema#isDefinedBy> <https://www.omg.org/spec/LCC/Languages/LanguageRepresentation/> ;
	<http://www.w3.org/2000/01/rdf-schema#label> "language variant" ;

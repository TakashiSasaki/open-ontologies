	<http://www.w3.org/2000/01/rdf-schema#comment> "A ValuePartition that describes only values from Hot, Medium or Mild. NB Subclasses can themselves be divided up into further partitions."@en ;
	<http://www.w3.org/2000/01/rdf-schema#label> "Spiciness"@en , "Tempero"@pt ;
	<http://www.w3.org/2000/01/rdf-schema#subClassOf> <http://www.co-ode.org/ontologies/pizza/pizza.owl#ValuePartition> ;
	<http://www.w3.org/2002/07/owl#equivalentClass> _:c14n209 ;
	<http://www.w3.org/2004/02/skos/core#prefLabel> "Spiciness"@en .
<http://www.co-ode.org/ontologies/pizza/pizza.owl#SpicyPizza> a <http://www.w3.org/2002/07/owl#Class> ;
	<http://www.w3.org/2000/01/rdf-schema#label> "PizzaTemperada"@pt , "SpicyPizza"@en ;
	<http://www.w3.org/2002/07/owl#equivalentClass> _:c14n208 ;
	<http://www.w3.org/2004/02/skos/core#definition> "Any pizza that has a spicy topping is a SpicyPizza"@en ;
	<http://www.w3.org/2004/02/skos/core#prefLabel> "Spicy Pizza"@en .
<http://www.co-ode.org/ontologies/pizza/pizza.owl#SpicyPizzaEquivalent> a <http://www.w3.org/2002/07/owl#Class> ;
	<http://www.w3.org/2000/01/rdf-schema#comment> "An alternative definition for the SpicyPizza which does away with needing a definition of SpicyTopping and uses a slightly more complicated restriction: Pizzas that have at least one topping that is both a PizzaTopping and has spiciness hot are members of this class."@en ;
	<http://www.w3.org/2000/01/rdf-schema#label> "PizzaTemperadaEquivalente"@pt , "SpicyPizzaEquivalent"@en ;
	<http://www.w3.org/2002/07/owl#equivalentClass> _:c14n308 ;
	<http://www.w3.org/2004/02/skos/core#prefLabel> "Spicy Pizza Equivalent"@en .
<http://www.co-ode.org/ontologies/pizza/pizza.owl#SpicyTopping> a <http://www.w3.org/2002/07/owl#Class> ;
	<http://www.w3.org/2000/01/rdf-schema#label> "CoberturaTemperada"@pt , "SpicyTopping"@en ;
	<http://www.w3.org/2002/07/owl#equivalentClass> _:c14n269 ;
	<http://www.w3.org/2004/02/skos/core#definition> "Any pizza topping that has spiciness Hot"@en ;
	<http://www.w3.org/2004/02/skos/core#prefLabel> "Spicy"@en .
<http://www.co-ode.org/ontologies/pizza/pizza.owl#SpinachTopping> a <http://www.w3.org/2002/07/owl#Class> ;
	<http://www.w3.org/2000/01/rdf-schema#label> "CoberturaDeEspinafre"@pt , "SpinachTopping"@en ;

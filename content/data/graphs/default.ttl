	<http://www.w3.org/2004/02/skos/core#definition> "an individual language or variant in use today by some speech community" .
<https://www.omg.org/spec/LCC/Languages/LanguageRepresentation/Macrolanguage> <http://purl.org/dc/terms/source> "Section 3.9, ISO 639-4" ;
	a <http://www.w3.org/2002/07/owl#Class> ;
	<http://www.w3.org/2000/01/rdf-schema#isDefinedBy> <https://www.omg.org/spec/LCC/Languages/LanguageRepresentation/> ;
	<http://www.w3.org/2000/01/rdf-schema#label> "macrolanguage" ;
	<http://www.w3.org/2000/01/rdf-schema#subClassOf> <https://www.omg.org/spec/LCC/Languages/LanguageRepresentation/Language> ;
	<http://www.w3.org/2004/02/skos/core#definition> "a language that may be viewed in some circumstances as an individual language, but actually represents two or more individual languages" ;
	<http://www.w3.org/2004/02/skos/core#note> "See sections 4.1 and 4.3 of ISO 639-4 for an extensive description of macrolanguages and how they are different from language groups." .
<https://www.omg.org/spec/LCC/Languages/LanguageRepresentation/MacrolanguageIdentifier> <http://purl.org/dc/terms/source> "Section 3.7, ISO 639-3" ;
	a <http://www.w3.org/2002/07/owl#Class> ;
	<http://www.w3.org/2000/01/rdf-schema#isDefinedBy> <https://www.omg.org/spec/LCC/Languages/LanguageRepresentation/> ;
	<http://www.w3.org/2000/01/rdf-schema#label> "macrolanguage identifier" ;

	<http://www.w3.org/2000/01/rdf-schema#subPropertyOf> <https://www.omg.org/spec/Commons/PartiesAndSituations/isAffectedBy> ;
	<http://www.w3.org/2004/02/skos/core#definition> "identifies the owner of an asset" .
<https://spec.edmcouncil.org/fibo/ontology/FND/OwnershipAndControl/Ownership/isOwnedAsset> a <http://www.w3.org/2002/07/owl#ObjectProperty> ;
	<http://www.w3.org/2000/01/rdf-schema#domain> <https://spec.edmcouncil.org/fibo/ontology/FND/OwnershipAndControl/Ownership/Asset> ;
	<http://www.w3.org/2000/01/rdf-schema#label> "is owned asset" ;
	<http://www.w3.org/2000/01/rdf-schema#range> <https://spec.edmcouncil.org/fibo/ontology/FND/OwnershipAndControl/Ownership/Ownership> ;
	<http://www.w3.org/2000/01/rdf-schema#subPropertyOf> <https://www.omg.org/spec/Commons/PartiesAndSituations/undergoes> ;
	<http://www.w3.org/2004/02/skos/core#definition> "indicates the context of ownership in which something is an asset" .

	<http://www.w3.org/2000/01/rdf-schema#label> "building"@en ;
	<http://www.w3.org/2004/02/skos/core#definition> "relatively permanent enclosed structure, that has a roof and walls and stands more or less permanently in one place" ;
	<https://spec.edmcouncil.org/fibo/ontology/FND/Places/Addresses/requiresSecondaryUnitRange> true ;
	<https://spec.edmcouncil.org/fibo/ontology/FND/Utilities/AnnotationVocabulary/preferredDesignation> "BLDG" .

	<https://www.omg.org/spec/Commons/Designators/hasDescription> "Lending agreements with fixed periodic payments consisting of an interest and principal portion. The periodic payments are adjusted for variable rate instruments such that maturity remains fixed." ;
	<https://www.omg.org/spec/Commons/Designators/hasTag> "ANN" ;
	<https://www.omg.org/spec/Commons/Designators/hasTextualName> "Annuity" .
<https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSContractTerms/ACTUSContractTerm-CT-CAPFL> a <http://www.w3.org/2002/07/owl#NamedIndividual> , <https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSContractTerms/ACTUSContractTerm> ;
	<http://www.w3.org/2000/01/rdf-schema#label> "ACTUS contract term - CT - CAPFL" ;

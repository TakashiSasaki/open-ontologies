	<http://www.w3.org/ns/prov#unqualifiedForm> <http://www.w3.org/ns/prov#wasQuotedFrom> .
<http://www.w3.org/ns/prov#qualifiedRevision> a <http://www.w3.org/2002/07/owl#ObjectProperty> ;
	<http://www.w3.org/2000/01/rdf-schema#comment> "If this Entity prov:wasRevisionOf Entity :e, then it can qualify how it was revised using prov:qualifiedRevision [ a prov:Revision;  prov:entity :e; :foo :bar ]."@en ;
	<http://www.w3.org/2000/01/rdf-schema#domain> <http://www.w3.org/ns/prov#Entity> ;

	<https://www.omg.org/spec/Commons/Designators/hasTag> "CECV" ;
	<https://www.omg.org/spec/Commons/Designators/hasTextualName> "Coverage Of Credit Enhancement" .
<https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSContractTerms/ACTUSContractTerm-CEGE> a <http://www.w3.org/2002/07/owl#NamedIndividual> , <https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSContractTerms/ACTUSContractTerm> ;
	<http://www.w3.org/2000/01/rdf-schema#label> "ACTUS contract term - CEGE" ;

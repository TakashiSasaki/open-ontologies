<http://www.co-ode.org/ontologies/pizza/pizza.owl#UnclosedPizza> a <http://www.w3.org/2002/07/owl#Class> ;
	<http://www.w3.org/2000/01/rdf-schema#comment> "An unclosed Pizza cannot be inferred to be either a VegetarianPizza or a NonVegetarianPizza, because it might have other toppings." ;
	<http://www.w3.org/2000/01/rdf-schema#label> "PizzaAberta"@pt , "UnclosedPizza"@en ;

	<http://www.w3.org/2000/01/rdf-schema#label> "preferred designation" ;
	<http://www.w3.org/2000/01/rdf-schema#subPropertyOf> <https://www.omg.org/spec/Commons/AnnotationVocabulary/synonym> ;
	<http://www.w3.org/2004/02/skos/core#definition> "recommended designation for an entity in some context" ;

	<http://www.w3.org/2000/01/rdf-schema#label> "hanger"@en ;
	<http://www.w3.org/2004/02/skos/core#definition> "shed or shelter; any relatively wide structure used for housing airplanes or airships" ;
	<https://spec.edmcouncil.org/fibo/ontology/FND/Places/Addresses/requiresSecondaryUnitRange> true ;
	<https://spec.edmcouncil.org/fibo/ontology/FND/Utilities/AnnotationVocabulary/preferredDesignation> "HNGR" .
<https://spec.edmcouncil.org/fibo/ontology/FND/Places/Addresses/Key> a <http://www.w3.org/2002/07/owl#NamedIndividual> , <https://spec.edmcouncil.org/fibo/ontology/FND/Places/Addresses/SecondaryUnitDesignator> ;
	<http://www.w3.org/2000/01/rdf-schema#label> "key"@en ;
	<http://www.w3.org/2004/02/skos/core#definition> "usually metal instrument by which the bolt of a lock is turned" ;
	<https://spec.edmcouncil.org/fibo/ontology/FND/Places/Addresses/requiresSecondaryUnitRange> true ;
	<https://spec.edmcouncil.org/fibo/ontology/FND/Utilities/AnnotationVocabulary/preferredDesignation> "KEY" .
<https://spec.edmcouncil.org/fibo/ontology/FND/Places/Addresses/Lobby> a <http://www.w3.org/2002/07/owl#NamedIndividual> , <https://spec.edmcouncil.org/fibo/ontology/FND/Places/Addresses/SecondaryUnitDesignator> ;
	<http://www.w3.org/2000/01/rdf-schema#label> "lobby"@en ;
	<http://www.w3.org/2004/02/skos/core#definition> "entrance hall, corridor, or vestibule, as in a public building, often serving as an anteroom; foyer" ;
	<https://spec.edmcouncil.org/fibo/ontology/FND/Places/Addresses/requiresSecondaryUnitRange> false ;
	<https://spec.edmcouncil.org/fibo/ontology/FND/Utilities/AnnotationVocabulary/preferredDesignation> "LBBY" .
<https://spec.edmcouncil.org/fibo/ontology/FND/Places/Addresses/Lot> a <http://www.w3.org/2002/07/owl#NamedIndividual> , <https://spec.edmcouncil.org/fibo/ontology/FND/Places/Addresses/SecondaryUnitDesignator> ;
	<http://www.w3.org/2000/01/rdf-schema#label> "lot"@en ;
	<http://www.w3.org/2004/02/skos/core#definition> "measured parcel of land having fixed boundaries and designated on a plot or survey" ;
	<https://spec.edmcouncil.org/fibo/ontology/FND/Places/Addresses/requiresSecondaryUnitRange> true ;
	<https://spec.edmcouncil.org/fibo/ontology/FND/Utilities/AnnotationVocabulary/preferredDesignation> "LOT" .
<https://spec.edmcouncil.org/fibo/ontology/FND/Places/Addresses/Lower> a <http://www.w3.org/2002/07/owl#NamedIndividual> , <https://spec.edmcouncil.org/fibo/ontology/FND/Places/Addresses/SecondaryUnitDesignator> ;
	<http://www.w3.org/2000/01/rdf-schema#label> "lower"@en ;
	<http://www.w3.org/2004/02/skos/core#definition> "floor of a building in a multistory structure that is closer to ground level" ;
	<https://spec.edmcouncil.org/fibo/ontology/FND/Places/Addresses/requiresSecondaryUnitRange> false ;
	<https://spec.edmcouncil.org/fibo/ontology/FND/Utilities/AnnotationVocabulary/preferredDesignation> "LOWR" .
<https://spec.edmcouncil.org/fibo/ontology/FND/Places/Addresses/Office> a <http://www.w3.org/2002/07/owl#NamedIndividual> , <https://spec.edmcouncil.org/fibo/ontology/FND/Places/Addresses/SecondaryUnitDesignator> ;
	<http://www.w3.org/2000/01/rdf-schema#label> "office"@en ;
	<http://www.w3.org/2004/02/skos/core#definition> "place where a particular kind of business is transacted or a service is supplied" ;
	<https://spec.edmcouncil.org/fibo/ontology/FND/Places/Addresses/requiresSecondaryUnitRange> false ;
	<https://spec.edmcouncil.org/fibo/ontology/FND/Utilities/AnnotationVocabulary/preferredDesignation> "OFC" .
<https://spec.edmcouncil.org/fibo/ontology/FND/Places/Addresses/Penthouse> a <http://www.w3.org/2002/07/owl#NamedIndividual> , <https://spec.edmcouncil.org/fibo/ontology/FND/Places/Addresses/SecondaryUnitDesignator> ;
	<http://www.w3.org/2000/01/rdf-schema#label> "penthouse"@en ;
	<http://www.w3.org/2004/02/skos/core#definition> "structure or dwelling on the roof or top floor of a building" ;
	<https://spec.edmcouncil.org/fibo/ontology/FND/Places/Addresses/requiresSecondaryUnitRange> false ;
	<https://spec.edmcouncil.org/fibo/ontology/FND/Utilities/AnnotationVocabulary/preferredDesignation> "PH" .
<https://spec.edmcouncil.org/fibo/ontology/FND/Places/Addresses/PhysicalAddress> a <http://www.w3.org/2002/07/owl#Class> ;
	<http://www.w3.org/2000/01/rdf-schema#label> "physical address"@en ;
	<http://www.w3.org/2000/01/rdf-schema#subClassOf> <https://spec.edmcouncil.org/fibo/ontology/FND/Places/Addresses/Address> , _:c14n1446 , _:c14n1492 , _:c14n1712 , _:c14n2341 , _:c14n390 , _:c14n449 , _:c14n587 ;
	<http://www.w3.org/2002/07/owl#disjointWith> <https://spec.edmcouncil.org/fibo/ontology/FND/Places/Addresses/VirtualAddress> ;
	<http://www.w3.org/2004/02/skos/core#definition> "physical address where communications can be addressed, papers served or representatives located for any kind of organization or person" ;
	<http://www.w3.org/2004/02/skos/core#scopeNote> "An address may be used as an index to the location of a building, apartment, office within an office block, or other structure or parcel of land, often using political boundaries and street names as references, along with other information such as house or building numbers or names. Some addresses also contain secondary elements such as apartment or building numbers, or special codes to aid routing of mail and packages." ;
	<https://www.omg.org/spec/Commons/AnnotationVocabulary/usageNote> "Typically, addresses will have only one postcode expressed either as a string value or individual, and only a municipality (individual) or city (string value)." .
<https://spec.edmcouncil.org/fibo/ontology/FND/Places/Addresses/PhysicalAddressIdentifier> a <http://www.w3.org/2002/07/owl#Class> ;
	<http://www.w3.org/2000/01/rdf-schema#label> "physical address identifier" ;
	<http://www.w3.org/2000/01/rdf-schema#subClassOf> <https://www.omg.org/spec/Commons/CodesAndCodeSets/CodeElement> , <https://www.omg.org/spec/Commons/Identifiers/Identifier> , _:c14n2541 , _:c14n475 ;
	<http://www.w3.org/2004/02/skos/core#definition> "unique identifier for a physical address" ;
	<http://www.w3.org/2004/02/skos/core#example> "Physical address identifiers may include bar codes, QCR codes, and +codes in a number of countries." .
<https://spec.edmcouncil.org/fibo/ontology/FND/Places/Addresses/PhysicalAddressingScheme> a <http://www.w3.org/2002/07/owl#Class> ;
	<http://www.w3.org/2000/01/rdf-schema#label> "physical addressing scheme" ;
	<http://www.w3.org/2000/01/rdf-schema#seeAlso> <https://pe.usps.com/cpim/ftp/pubs/Pub28/pub28.pdf> ;
	<http://www.w3.org/2000/01/rdf-schema#subClassOf> <https://spec.edmcouncil.org/fibo/ontology/FND/Places/Addresses/AddressingScheme> , _:c14n73 ;
	<http://www.w3.org/2004/02/skos/core#definition> "scheme for specifying physical addresses according to a country specific standard" .
<https://spec.edmcouncil.org/fibo/ontology/FND/Places/Addresses/Pier> a <http://www.w3.org/2002/07/owl#NamedIndividual> , <https://spec.edmcouncil.org/fibo/ontology/FND/Places/Addresses/SecondaryUnitDesignator> ;
	<http://www.w3.org/2000/01/rdf-schema#label> "pier"@en ;
	<http://www.w3.org/2004/02/skos/core#definition> "structure extending into navigable water for use as a landing place or promenade" ;
	<https://spec.edmcouncil.org/fibo/ontology/FND/Places/Addresses/requiresSecondaryUnitRange> true ;
	<https://spec.edmcouncil.org/fibo/ontology/FND/Utilities/AnnotationVocabulary/preferredDesignation> "PIER" .
<https://spec.edmcouncil.org/fibo/ontology/FND/Places/Addresses/PostCodeArea> a <http://www.w3.org/2002/07/owl#Class> ;
	<http://www.w3.org/2000/01/rdf-schema#label> "post code area"@en ;
	<http://www.w3.org/2000/01/rdf-schema#subClassOf> <https://www.omg.org/spec/Commons/Locations/GeographicRegion> ;
	<http://www.w3.org/2004/02/skos/core#definition> "physical area uniquely identified by some postal code" .
<https://spec.edmcouncil.org/fibo/ontology/FND/Places/Addresses/PostOfficeBox> a <http://www.w3.org/2002/07/owl#Class> ;
	<http://www.w3.org/2000/01/rdf-schema#label> "post office box" ;
	<http://www.w3.org/2000/01/rdf-schema#subClassOf> <https://spec.edmcouncil.org/fibo/ontology/FND/Places/Addresses/SupplementalAddressComponent> , _:c14n892 ;
	<http://www.w3.org/2004/02/skos/core#definition> "post office box associated with an address" ;
	<https://www.omg.org/spec/Commons/AnnotationVocabulary/explanatoryNote> "Post office box identifiers are only unique to a given jurisdiction, which may be a post office, town, or other region." .
<https://spec.edmcouncil.org/fibo/ontology/FND/Places/Addresses/PostOfficeBoxAddress> a <http://www.w3.org/2002/07/owl#Class> ;
	<http://www.w3.org/2000/01/rdf-schema#label> "post office box address" ;
	<http://www.w3.org/2000/01/rdf-schema#subClassOf> <https://spec.edmcouncil.org/fibo/ontology/FND/Places/Addresses/PhysicalAddress> , _:c14n2953 ;
	<http://www.w3.org/2004/02/skos/core#definition> "physical address used to deliver communications to a designated container at a local post office or the local equivalent for the jurisdiction, where mail is held until the recipient collects it, rather than to a given house, building, or other location" .
<https://spec.edmcouncil.org/fibo/ontology/FND/Places/Addresses/PostOfficeBoxDesignator> a <http://www.w3.org/2002/07/owl#Class> ;
	<http://www.w3.org/2000/01/rdf-schema#label> "post office box designator"@en ;
	<http://www.w3.org/2000/01/rdf-schema#subClassOf> <https://spec.edmcouncil.org/fibo/ontology/FND/Places/Addresses/SupplementalAddressDesignator> ;
	<http://www.w3.org/2004/02/skos/core#definition> "designator used, together with an identifier, for a post office box" ;
	<http://www.w3.org/2004/02/skos/core#example> "In the U.S., the preferred designator is 'PO BOX'." .
<https://spec.edmcouncil.org/fibo/ontology/FND/Places/Addresses/Postcode> a <http://www.w3.org/2002/07/owl#Class> ;
	<http://www.w3.org/2000/01/rdf-schema#label> "postcode"@en ;
	<http://www.w3.org/2000/01/rdf-schema#subClassOf> <https://www.omg.org/spec/Commons/CodesAndCodeSets/CodeElement> , <https://www.omg.org/spec/Commons/Locations/GeographicRegionIdentifier> , _:c14n3276 ;
	<http://www.w3.org/2004/02/skos/core#definition> "sequence of characters used to assist in the sorting of mail" ;
	<https://www.omg.org/spec/Commons/AnnotationVocabulary/synonym> "postal code" .
<https://spec.edmcouncil.org/fibo/ontology/FND/Places/Addresses/PostdirectionalSymbol> a <http://www.w3.org/2002/07/owl#Class> ;
	<http://www.w3.org/2000/01/rdf-schema#label> "postdirectional symbol" ;
	<http://www.w3.org/2000/01/rdf-schema#subClassOf> <https://spec.edmcouncil.org/fibo/ontology/FND/Places/Addresses/GeographicDirectionalSymbol> ;
	<http://www.w3.org/2004/02/skos/core#definition> "geographic directional symbol that follows the street name and street suffix in a street address" .
<https://spec.edmcouncil.org/fibo/ontology/FND/Places/Addresses/PredirectionalSymbol> a <http://www.w3.org/2002/07/owl#Class> ;
	<http://www.w3.org/2000/01/rdf-schema#label> "predirectional symbol" ;
	<http://www.w3.org/2000/01/rdf-schema#subClassOf> <https://spec.edmcouncil.org/fibo/ontology/FND/Places/Addresses/GeographicDirectionalSymbol> ;
	<http://www.w3.org/2004/02/skos/core#definition> "geographic directional symbol that occurs after the primary street number but before the street name in a street address" .
<https://spec.edmcouncil.org/fibo/ontology/FND/Places/Addresses/PrimaryAddressNumber> a <http://www.w3.org/2002/07/owl#Class> ;
	<http://www.w3.org/2000/01/rdf-schema#label> "primary address number" ;
	<http://www.w3.org/2000/01/rdf-schema#subClassOf> <https://spec.edmcouncil.org/fibo/ontology/FND/Places/Addresses/AddressComponent> , _:c14n3136 ;
	<http://www.w3.org/2004/02/skos/core#definition> "address component that identifies a location with respect to a given street" ;
	<https://www.omg.org/spec/Commons/AnnotationVocabulary/explanatoryNote> "Although traditionally called a 'number', the street number may consist of alphanumeric characters, for example, '221B'." ;
	<https://www.omg.org/spec/Commons/AnnotationVocabulary/synonym> "street number" .
<https://spec.edmcouncil.org/fibo/ontology/FND/Places/Addresses/Rear> a <http://www.w3.org/2002/07/owl#NamedIndividual> , <https://spec.edmcouncil.org/fibo/ontology/FND/Places/Addresses/SecondaryUnitDesignator> ;
	<http://www.w3.org/2000/01/rdf-schema#label> "rear"@en ;
	<http://www.w3.org/2004/02/skos/core#definition> "side or part of a building at the back, located opposite its front" ;
	<https://spec.edmcouncil.org/fibo/ontology/FND/Places/Addresses/requiresSecondaryUnitRange> false ;
	<https://spec.edmcouncil.org/fibo/ontology/FND/Utilities/AnnotationVocabulary/preferredDesignation> "REAR" .
<https://spec.edmcouncil.org/fibo/ontology/FND/Places/Addresses/RegionSpecificIdentifier> a <http://www.w3.org/2002/07/owl#Class> ;
	<http://www.w3.org/2000/01/rdf-schema#label> "region-specific identifier" ;
	<http://www.w3.org/2000/01/rdf-schema#subClassOf> <https://www.omg.org/spec/Commons/Locations/GeographicRegionIdentifier> , _:c14n617 ;
	<http://www.w3.org/2004/02/skos/core#definition> "geographic region or subdivision identifier used internally by a country or other region" .
<https://spec.edmcouncil.org/fibo/ontology/FND/Places/Addresses/Room> a <http://www.w3.org/2002/07/owl#NamedIndividual> , <https://spec.edmcouncil.org/fibo/ontology/FND/Places/Addresses/SecondaryUnitDesignator> ;
	<http://www.w3.org/2000/01/rdf-schema#label> "room"@en ;
	<http://www.w3.org/2004/02/skos/core#definition> "partitioned part of the inside of a building" ;
	<https://spec.edmcouncil.org/fibo/ontology/FND/Places/Addresses/requiresSecondaryUnitRange> true ;
	<https://spec.edmcouncil.org/fibo/ontology/FND/Utilities/AnnotationVocabulary/preferredDesignation> "RM" .
<https://spec.edmcouncil.org/fibo/ontology/FND/Places/Addresses/SecondaryUnit> a <http://www.w3.org/2002/07/owl#Class> ;
	<http://www.w3.org/2000/01/rdf-schema#label> "secondary unit" ;
	<http://www.w3.org/2000/01/rdf-schema#subClassOf> <https://spec.edmcouncil.org/fibo/ontology/FND/Places/Addresses/AddressComponent> , _:c14n1958 , _:c14n366 ;
	<http://www.w3.org/2004/02/skos/core#definition> "address component that identifies an individual unit within a larger structure, such as an apartment, office, hangar, slip, mailbox, and so forth, at a given street address" .
<https://spec.edmcouncil.org/fibo/ontology/FND/Places/Addresses/SecondaryUnitDesignator> a <http://www.w3.org/2002/07/owl#Class> ;
	<http://www.w3.org/2000/01/rdf-schema#label> "secondary unit designator" ;
	<http://www.w3.org/2000/01/rdf-schema#subClassOf> <https://www.omg.org/spec/Commons/Classifiers/Classifier> , _:c14n2689 ;
	<http://www.w3.org/2004/02/skos/core#definition> "classifier for a smaller structure or component within a larger facility, such as an apartment, office, mail stop, or other similar designation" ;
	<https://www.omg.org/spec/Commons/AnnotationVocabulary/explanatoryNote> "Note that only certain secondary units require a secondary range, such as an apartment number, to complete a delivery point." .
<https://spec.edmcouncil.org/fibo/ontology/FND/Places/Addresses/SecondaryUnitIndicator> a <http://www.w3.org/2002/07/owl#Class> ;
	<http://www.w3.org/2000/01/rdf-schema#label> "secondary unit indicator" ;
	<http://www.w3.org/2000/01/rdf-schema#subClassOf> <https://spec.edmcouncil.org/fibo/ontology/FND/Places/Addresses/AddressComponent> , _:c14n2852 ;
	<http://www.w3.org/2004/02/skos/core#definition> "index to the specific unit within a secondary unit, such as a building or apartment, at a particular street address" .
<https://spec.edmcouncil.org/fibo/ontology/FND/Places/Addresses/Side> a <http://www.w3.org/2002/07/owl#NamedIndividual> , <https://spec.edmcouncil.org/fibo/ontology/FND/Places/Addresses/SecondaryUnitDesignator> ;
	<http://www.w3.org/2000/01/rdf-schema#label> "side"@en ;
	<http://www.w3.org/2004/02/skos/core#definition> "place, space, or direction with respect to a center or to a line of division" ;
	<https://spec.edmcouncil.org/fibo/ontology/FND/Places/Addresses/requiresSecondaryUnitRange> false ;
	<https://spec.edmcouncil.org/fibo/ontology/FND/Utilities/AnnotationVocabulary/preferredDesignation> "SIDE" .
<https://spec.edmcouncil.org/fibo/ontology/FND/Places/Addresses/Slip> a <http://www.w3.org/2002/07/owl#NamedIndividual> , <https://spec.edmcouncil.org/fibo/ontology/FND/Places/Addresses/SecondaryUnitDesignator> ;
	<http://www.w3.org/2000/01/rdf-schema#label> "slip"@en ;
	<http://www.w3.org/2004/02/skos/core#definition> "sloping ramp extending out into the water to serve as a place for landing or repairing ships; ship's or boat's berth between two piers" ;
	<https://spec.edmcouncil.org/fibo/ontology/FND/Places/Addresses/requiresSecondaryUnitRange> true ;
	<https://spec.edmcouncil.org/fibo/ontology/FND/Utilities/AnnotationVocabulary/preferredDesignation> "SLP" .
<https://spec.edmcouncil.org/fibo/ontology/FND/Places/Addresses/Space> a <http://www.w3.org/2002/07/owl#NamedIndividual> , <https://spec.edmcouncil.org/fibo/ontology/FND/Places/Addresses/SecondaryUnitDesignator> ;
	<http://www.w3.org/2000/01/rdf-schema#label> "space"@en ;
	<http://www.w3.org/2004/02/skos/core#definition> "extent set apart or available, such as a parking or storage space" ;
	<https://spec.edmcouncil.org/fibo/ontology/FND/Places/Addresses/requiresSecondaryUnitRange> true ;
	<https://spec.edmcouncil.org/fibo/ontology/FND/Utilities/AnnotationVocabulary/preferredDesignation> "SPC" .
<https://spec.edmcouncil.org/fibo/ontology/FND/Places/Addresses/Stop> a <http://www.w3.org/2002/07/owl#NamedIndividual> , <https://spec.edmcouncil.org/fibo/ontology/FND/Places/Addresses/SecondaryUnitDesignator> ;
	<http://www.w3.org/2000/01/rdf-schema#label> "stop"@en ;
	<http://www.w3.org/2004/02/skos/core#definition> "stopping place, such as a bus or mail stop" ;
	<https://spec.edmcouncil.org/fibo/ontology/FND/Places/Addresses/requiresSecondaryUnitRange> true ;
	<https://spec.edmcouncil.org/fibo/ontology/FND/Utilities/AnnotationVocabulary/preferredDesignation> "STOP" .
<https://spec.edmcouncil.org/fibo/ontology/FND/Places/Addresses/StreetAddress> a <http://www.w3.org/2002/07/owl#Class> ;
	<http://www.w3.org/2000/01/rdf-schema#label> "street address" ;
	<http://www.w3.org/2000/01/rdf-schema#subClassOf> <https://spec.edmcouncil.org/fibo/ontology/FND/Places/Addresses/AddressComponent> , _:c14n1252 , _:c14n2020 , _:c14n2100 , _:c14n3352 , _:c14n530 , _:c14n839 ;
	<http://www.w3.org/2004/02/skos/core#definition> "index to a location that consists of a primary address number, predirectional, street name, suffix, postdirectional, and an optional secondary unit" .
<https://spec.edmcouncil.org/fibo/ontology/FND/Places/Addresses/StreetName> a <http://www.w3.org/2002/07/owl#Class> ;
	<http://www.w3.org/2000/01/rdf-schema#label> "street name" ;
	<http://www.w3.org/2000/01/rdf-schema#subClassOf> <https://spec.edmcouncil.org/fibo/ontology/FND/Places/Addresses/AddressComponent> , <https://www.omg.org/spec/Commons/Designators/Name> , _:c14n3157 ;
	<http://www.w3.org/2004/02/skos/core#definition> "identifier for a street in some context (e.g., city, municipality, geographic region)" .
<https://spec.edmcouncil.org/fibo/ontology/FND/Places/Addresses/StreetSuffix> a <http://www.w3.org/2002/07/owl#Class> ;
	<http://www.w3.org/2000/01/rdf-schema#label> "street suffix" ;
	<http://www.w3.org/2000/01/rdf-schema#subClassOf> <https://spec.edmcouncil.org/fibo/ontology/FND/Places/Addresses/AddressComponent> , <https://www.omg.org/spec/Commons/Classifiers/Classifier> ;
	<http://www.w3.org/2004/02/skos/core#definition> "classifier for a street or other delivery location, such as a dwelling located along a waterway" ;
	<https://www.omg.org/spec/Commons/AnnotationVocabulary/explanatoryNote> "The suffix may provide some insight into the size or length of the street, though not necessarily consistently. In some cities, the suffix differentiates the street from another in the same context, such as 19th Street vs. 19th Avenue in San Francisco." .
<https://spec.edmcouncil.org/fibo/ontology/FND/Places/Addresses/StructureName> a <http://www.w3.org/2002/07/owl#Class> ;
	<http://www.w3.org/2000/01/rdf-schema#label> "structure name" ;
	<http://www.w3.org/2000/01/rdf-schema#subClassOf> <https://spec.edmcouncil.org/fibo/ontology/FND/Places/Addresses/AddressComponent> , <https://www.omg.org/spec/Commons/Designators/Name> , _:c14n2335 ;
	<http://www.w3.org/2004/02/skos/core#definition> "name for a building, house, office complex, shopping center, or other structure or group of structures" ;
	<http://www.w3.org/2004/02/skos/core#example> "Examples include 'McCoy Center', which is the name of the office complex where JPMorgan Chase's Polaris facility is located, 'Apple Park', which is the name of the corporate headquarters of Apple, Inc., and 'Howells Bridge Cottage', which is the name of a very old cottage in Cornwall." .
<https://spec.edmcouncil.org/fibo/ontology/FND/Places/Addresses/Suite> a <http://www.w3.org/2002/07/owl#NamedIndividual> , <https://spec.edmcouncil.org/fibo/ontology/FND/Places/Addresses/SecondaryUnitDesignator> ;
	<http://www.w3.org/2000/01/rdf-schema#label> "suite"@en ;
	<http://www.w3.org/2004/02/skos/core#definition> "group of rooms occupied as a unit" ;
	<https://spec.edmcouncil.org/fibo/ontology/FND/Places/Addresses/requiresSecondaryUnitRange> true ;
	<https://spec.edmcouncil.org/fibo/ontology/FND/Utilities/AnnotationVocabulary/preferredDesignation> "STE" .
<https://spec.edmcouncil.org/fibo/ontology/FND/Places/Addresses/SupplementalAddressComponent> a <http://www.w3.org/2002/07/owl#Class> ;
	<http://www.w3.org/2000/01/rdf-schema#label> "supplemental address component" ;
	<http://www.w3.org/2000/01/rdf-schema#subClassOf> <https://spec.edmcouncil.org/fibo/ontology/FND/Places/Addresses/AddressComponent> , _:c14n1548 , _:c14n2733 , _:c14n28 ;
	<http://www.w3.org/2004/02/skos/core#definition> "address component that provides additional information that is important to ensuring proper delivery of communications" ;
	<https://www.omg.org/spec/Commons/AnnotationVocabulary/explanatoryNote> "Supplemental components include post office box information, rural route and highway contract route information, private mailboxes, and so forth, that are not part of a conventional street address." .
<https://spec.edmcouncil.org/fibo/ontology/FND/Places/Addresses/SupplementalAddressDesignator> a <http://www.w3.org/2002/07/owl#Class> ;
	<http://www.w3.org/2000/01/rdf-schema#label> "supplemental address designator" ;
	<http://www.w3.org/2000/01/rdf-schema#subClassOf> <https://www.omg.org/spec/Commons/Classifiers/Classifier> , _:c14n1536 ;
	<http://www.w3.org/2004/02/skos/core#definition> "classifier for supplemental address information, such as a highway contract route, rural route, building complex, shopping center, condominium complex, mail box, or other similar designation" .
<https://spec.edmcouncil.org/fibo/ontology/FND/Places/Addresses/SupplementalAddressUnit> a <http://www.w3.org/2002/07/owl#Class> ;
	<http://www.w3.org/2000/01/rdf-schema#label> "supplemental address unit" ;
	<http://www.w3.org/2000/01/rdf-schema#subClassOf> <https://spec.edmcouncil.org/fibo/ontology/FND/Places/Addresses/AddressComponent> , _:c14n2912 ;
	<http://www.w3.org/2004/02/skos/core#definition> "address component that includes a specific route, box, apartment, condominium or other indicator or unit associated with a specific address" .
<https://spec.edmcouncil.org/fibo/ontology/FND/Places/Addresses/Trailer> a <http://www.w3.org/2002/07/owl#NamedIndividual> , <https://spec.edmcouncil.org/fibo/ontology/FND/Places/Addresses/SecondaryUnitDesignator> ;
	<http://www.w3.org/2000/01/rdf-schema#label> "trailer"@en ;
	<http://www.w3.org/2004/02/skos/core#definition> "vehicle designed to serve wherever parked as a temporary dwelling or place of business" ;
	<https://spec.edmcouncil.org/fibo/ontology/FND/Places/Addresses/requiresSecondaryUnitRange> true ;
	<https://spec.edmcouncil.org/fibo/ontology/FND/Utilities/AnnotationVocabulary/preferredDesignation> "TRLR" .
<https://spec.edmcouncil.org/fibo/ontology/FND/Places/Addresses/Unit> a <http://www.w3.org/2002/07/owl#NamedIndividual> , <https://spec.edmcouncil.org/fibo/ontology/FND/Places/Addresses/SecondaryUnitDesignator> ;
	<http://www.w3.org/2000/01/rdf-schema#label> "unit"@en ;
	<http://www.w3.org/2004/02/skos/core#definition> "area in a facility, such as a medical facility or hospital that is specially staffed and equipped to provide a particular service or type of care" ;
	<https://spec.edmcouncil.org/fibo/ontology/FND/Places/Addresses/requiresSecondaryUnitRange> true ;
	<https://spec.edmcouncil.org/fibo/ontology/FND/Utilities/AnnotationVocabulary/preferredDesignation> "UNIT" .
<https://spec.edmcouncil.org/fibo/ontology/FND/Places/Addresses/Upper> a <http://www.w3.org/2002/07/owl#NamedIndividual> , <https://spec.edmcouncil.org/fibo/ontology/FND/Places/Addresses/SecondaryUnitDesignator> ;
	<http://www.w3.org/2000/01/rdf-schema#label> "upper"@en ;
	<http://www.w3.org/2004/02/skos/core#definition> "floor of a building in a multistory structure that is farther away from the ground level" ;
	<https://spec.edmcouncil.org/fibo/ontology/FND/Places/Addresses/requiresSecondaryUnitRange> false ;
	<https://spec.edmcouncil.org/fibo/ontology/FND/Utilities/AnnotationVocabulary/preferredDesignation> "UPPR" .
<https://spec.edmcouncil.org/fibo/ontology/FND/Places/Addresses/VirtualAddress> a <http://www.w3.org/2002/07/owl#Class> ;
	<http://www.w3.org/2000/01/rdf-schema#label> "virtual address" ;
	<http://www.w3.org/2000/01/rdf-schema#subClassOf> <https://spec.edmcouncil.org/fibo/ontology/FND/Places/Addresses/Address> , _:c14n760 ;
	<http://www.w3.org/2004/02/skos/core#definition> "address identifying a virtual, i.e. non-physical, location" .
<https://spec.edmcouncil.org/fibo/ontology/FND/Places/Addresses/hasAddress> a <http://www.w3.org/2002/07/owl#ObjectProperty> ;
	<http://www.w3.org/2000/01/rdf-schema#label> "has address" ;
	<http://www.w3.org/2000/01/rdf-schema#range> <https://spec.edmcouncil.org/fibo/ontology/FND/Places/Addresses/Address> ;
	<http://www.w3.org/2000/01/rdf-schema#subPropertyOf> <https://www.omg.org/spec/Commons/Classifiers/isCharacterizedBy> ;
	<http://www.w3.org/2004/02/skos/core#definition> "indicates a means by which something (in the case of a network address) or some entity may be located or contacted or may receive correspondence" .
<https://spec.edmcouncil.org/fibo/ontology/FND/Places/Addresses/hasAddressLine1> a <http://www.w3.org/2002/07/owl#DatatypeProperty> ;
	<http://www.w3.org/2000/01/rdf-schema#domain> <https://spec.edmcouncil.org/fibo/ontology/FND/Places/Addresses/PhysicalAddress> ;
	<http://www.w3.org/2000/01/rdf-schema#label> "has address line 1" ;
	<http://www.w3.org/2000/01/rdf-schema#subPropertyOf> <https://www.omg.org/spec/Commons/TextDatatype/hasTextValue> ;
	<http://www.w3.org/2004/02/skos/core#definition> "the first line of the street address" ;
	<https://www.omg.org/spec/Commons/AnnotationVocabulary/adaptedFrom> "https://www.gleif.org/en/about-lei/common-data-file-format/lei-cdf-format/lei-cdf-format-version-2-1"^^<http://www.w3.org/2001/XMLSchema#anyURI> .
<https://spec.edmcouncil.org/fibo/ontology/FND/Places/Addresses/hasAddressLine2> a <http://www.w3.org/2002/07/owl#DatatypeProperty> ;
	<http://www.w3.org/2000/01/rdf-schema#domain> <https://spec.edmcouncil.org/fibo/ontology/FND/Places/Addresses/PhysicalAddress> ;
	<http://www.w3.org/2000/01/rdf-schema#label> "has address line 2" ;
	<http://www.w3.org/2000/01/rdf-schema#subPropertyOf> <https://www.omg.org/spec/Commons/TextDatatype/hasTextValue> ;
	<http://www.w3.org/2004/02/skos/core#definition> "the second line of the street address" ;
	<https://www.omg.org/spec/Commons/AnnotationVocabulary/adaptedFrom> "https://www.gleif.org/en/about-lei/common-data-file-format/lei-cdf-format/lei-cdf-format-version-2-1"^^<http://www.w3.org/2001/XMLSchema#anyURI> .
<https://spec.edmcouncil.org/fibo/ontology/FND/Places/Addresses/hasAddressLine3> a <http://www.w3.org/2002/07/owl#DatatypeProperty> ;
	<http://www.w3.org/2000/01/rdf-schema#domain> <https://spec.edmcouncil.org/fibo/ontology/FND/Places/Addresses/PhysicalAddress> ;
	<http://www.w3.org/2000/01/rdf-schema#label> "has address line 3" ;
	<http://www.w3.org/2000/01/rdf-schema#subPropertyOf> <https://www.omg.org/spec/Commons/TextDatatype/hasTextValue> ;
	<http://www.w3.org/2004/02/skos/core#definition> "the third line of the street address" ;
	<https://www.omg.org/spec/Commons/AnnotationVocabulary/adaptedFrom> "https://www.gleif.org/en/about-lei/common-data-file-format/lei-cdf-format/lei-cdf-format-version-2-1"^^<http://www.w3.org/2001/XMLSchema#anyURI> ;
	<https://www.omg.org/spec/Commons/AnnotationVocabulary/usageNote> "This element SHALL be omitted if address line 2 is omitted." .
<https://spec.edmcouncil.org/fibo/ontology/FND/Places/Addresses/hasAttentionLine> a <http://www.w3.org/2002/07/owl#DatatypeProperty> ;
	<http://www.w3.org/2000/01/rdf-schema#domain> <https://spec.edmcouncil.org/fibo/ontology/FND/Places/Addresses/PhysicalAddress> ;
	<http://www.w3.org/2000/01/rdf-schema#label> "has attention line" ;
	<http://www.w3.org/2000/01/rdf-schema#subPropertyOf> <https://www.omg.org/spec/Commons/TextDatatype/hasTextValue> ;
	<http://www.w3.org/2004/02/skos/core#definition> "an optional, free text address line denoting the intended recipient" .
<https://spec.edmcouncil.org/fibo/ontology/FND/Places/Addresses/hasIndividualPostcode> a <http://www.w3.org/2002/07/owl#ObjectProperty> ;
	<http://www.w3.org/2000/01/rdf-schema#domain> <https://spec.edmcouncil.org/fibo/ontology/FND/Places/Addresses/PhysicalAddress> ;
	<http://www.w3.org/2000/01/rdf-schema#label> "has individual postcode" ;
	<http://www.w3.org/2000/01/rdf-schema#range> <https://spec.edmcouncil.org/fibo/ontology/FND/Places/Addresses/Postcode> ;
	<http://www.w3.org/2000/01/rdf-schema#subPropertyOf> <https://www.omg.org/spec/Commons/Collections/comprises> ;
	<http://www.w3.org/2004/02/skos/core#definition> "indicates the local or international postcode element of a delivery address as specified by the local postal service" ;
	<https://www.omg.org/spec/Commons/AnnotationVocabulary/adaptedFrom> "https://www.gleif.org/en/about-lei/common-data-file-format/lei-cdf-format/lei-cdf-format-version-2-1"^^<http://www.w3.org/2001/XMLSchema#anyURI> .
<https://spec.edmcouncil.org/fibo/ontology/FND/Places/Addresses/hasMailRouting> a <http://www.w3.org/2002/07/owl#DatatypeProperty> ;
	<http://www.w3.org/2000/01/rdf-schema#domain> <https://spec.edmcouncil.org/fibo/ontology/FND/Places/Addresses/PhysicalAddress> ;
	<http://www.w3.org/2000/01/rdf-schema#label> "has mail routing" ;
	<http://www.w3.org/2000/01/rdf-schema#subPropertyOf> <https://www.omg.org/spec/Commons/TextDatatype/hasTextValue> ;
	<http://www.w3.org/2004/02/skos/core#definition> "an optional, free text address line containing explicit routing information (this elements's presence indicates that this address is a routing / 'care of' address)" ;
	<https://www.omg.org/spec/Commons/AnnotationVocabulary/adaptedFrom> "https://www.gleif.org/en/about-lei/common-data-file-format/lei-cdf-format/lei-cdf-format-version-2-1"^^<http://www.w3.org/2001/XMLSchema#anyURI> .
<https://spec.edmcouncil.org/fibo/ontology/FND/Places/Addresses/hasPostalCode> a <http://www.w3.org/2002/07/owl#DatatypeProperty> ;
	<http://www.w3.org/2000/01/rdf-schema#domain> <https://spec.edmcouncil.org/fibo/ontology/FND/Places/Addresses/PhysicalAddress> ;
	<http://www.w3.org/2000/01/rdf-schema#label> "has postal code" ;
	<http://www.w3.org/2000/01/rdf-schema#subPropertyOf> <https://www.omg.org/spec/Commons/TextDatatype/hasTextValue> ;
	<http://www.w3.org/2004/02/skos/core#definition> "the postal code of this address as specified by the local postal service" ;
	<https://www.omg.org/spec/Commons/AnnotationVocabulary/adaptedFrom> "https://www.gleif.org/en/about-lei/common-data-file-format/lei-cdf-format/lei-cdf-format-version-2-1"^^<http://www.w3.org/2001/XMLSchema#anyURI> .
<https://spec.edmcouncil.org/fibo/ontology/FND/Places/Addresses/hasPostdirectionalSymbol> a <http://www.w3.org/2002/07/owl#ObjectProperty> ;
	<http://www.w3.org/2000/01/rdf-schema#domain> <https://spec.edmcouncil.org/fibo/ontology/FND/Places/Addresses/StreetAddress> ;
	<http://www.w3.org/2000/01/rdf-schema#label> "has postdirectional symbol" ;
	<http://www.w3.org/2000/01/rdf-schema#range> <https://spec.edmcouncil.org/fibo/ontology/FND/Places/Addresses/PostdirectionalSymbol> ;
	<http://www.w3.org/2000/01/rdf-schema#subPropertyOf> <https://www.omg.org/spec/Commons/Collections/comprises> ;
	<http://www.w3.org/2004/02/skos/core#definition> "specifies a geographic directional symbol that follows the street name and street suffix in a street address" .
<https://spec.edmcouncil.org/fibo/ontology/FND/Places/Addresses/hasPredirectionalSymbol> a <http://www.w3.org/2002/07/owl#ObjectProperty> ;
	<http://www.w3.org/2000/01/rdf-schema#domain> <https://spec.edmcouncil.org/fibo/ontology/FND/Places/Addresses/StreetAddress> ;
	<http://www.w3.org/2000/01/rdf-schema#label> "has predirectional symbol" ;
	<http://www.w3.org/2000/01/rdf-schema#range> <https://spec.edmcouncil.org/fibo/ontology/FND/Places/Addresses/PredirectionalSymbol> ;
	<http://www.w3.org/2000/01/rdf-schema#subPropertyOf> <https://www.omg.org/spec/Commons/Collections/comprises> ;
	<http://www.w3.org/2004/02/skos/core#definition> "specifies a geographic directional symbol that occurs after the primary street number but before the street name in a street address" .
<https://spec.edmcouncil.org/fibo/ontology/FND/Places/Addresses/hasPrimaryAddressNumber> a <http://www.w3.org/2002/07/owl#ObjectProperty> ;
	<http://www.w3.org/2000/01/rdf-schema#domain> <https://spec.edmcouncil.org/fibo/ontology/FND/Places/Addresses/StreetAddress> ;
	<http://www.w3.org/2000/01/rdf-schema#label> "has primary address number" ;
	<http://www.w3.org/2000/01/rdf-schema#range> <https://spec.edmcouncil.org/fibo/ontology/FND/Places/Addresses/PrimaryAddressNumber> ;
	<http://www.w3.org/2000/01/rdf-schema#subPropertyOf> <https://www.omg.org/spec/Commons/Collections/comprises> ;
	<http://www.w3.org/2004/02/skos/core#definition> "specifies a a location with respect to a given street" .
<https://spec.edmcouncil.org/fibo/ontology/FND/Places/Addresses/hasSecondaryUnit> a <http://www.w3.org/2002/07/owl#ObjectProperty> ;
	<http://www.w3.org/2000/01/rdf-schema#domain> <https://spec.edmcouncil.org/fibo/ontology/FND/Places/Addresses/StreetAddress> ;
	<http://www.w3.org/2000/01/rdf-schema#label> "has secondary unit" ;
	<http://www.w3.org/2000/01/rdf-schema#range> <https://spec.edmcouncil.org/fibo/ontology/FND/Places/Addresses/SecondaryUnit> ;
	<http://www.w3.org/2000/01/rdf-schema#subPropertyOf> <https://www.omg.org/spec/Commons/Collections/comprises> ;
	<http://www.w3.org/2004/02/skos/core#definition> "specifies an individual unit within a larger structure, such as an apartment, office, hangar, slip, mailbox, and so forth, at a given street address" .
<https://spec.edmcouncil.org/fibo/ontology/FND/Places/Addresses/hasStreetAddress> a <http://www.w3.org/2002/07/owl#ObjectProperty> ;
	<http://www.w3.org/2000/01/rdf-schema#domain> <https://spec.edmcouncil.org/fibo/ontology/FND/Places/Addresses/ConventionalStreetAddress> ;
	<http://www.w3.org/2000/01/rdf-schema#label> "has street address" ;
	<http://www.w3.org/2000/01/rdf-schema#range> <https://spec.edmcouncil.org/fibo/ontology/FND/Places/Addresses/StreetAddress> ;
	<http://www.w3.org/2000/01/rdf-schema#subPropertyOf> <https://www.omg.org/spec/Commons/Collections/comprises> ;
	<http://www.w3.org/2004/02/skos/core#definition> "indicates a fully-specified address component that consists of a primary address number, predirectional, street name, suffix, postdirectional, and an optional secondary unit" .
<https://spec.edmcouncil.org/fibo/ontology/FND/Places/Addresses/hasStreetName> a <http://www.w3.org/2002/07/owl#ObjectProperty> ;
	<http://www.w3.org/2000/01/rdf-schema#domain> <https://spec.edmcouncil.org/fibo/ontology/FND/Places/Addresses/StreetAddress> ;
	<http://www.w3.org/2000/01/rdf-schema#label> "has street name" ;
	<http://www.w3.org/2000/01/rdf-schema#range> <https://spec.edmcouncil.org/fibo/ontology/FND/Places/Addresses/StreetName> ;
	<http://www.w3.org/2000/01/rdf-schema#subPropertyOf> <https://www.omg.org/spec/Commons/Collections/comprises> ;
	<http://www.w3.org/2004/02/skos/core#definition> "specifies an identifier for a street in some context (e.g., 'Baker', 'First', 'Main')" .
<https://spec.edmcouncil.org/fibo/ontology/FND/Places/Addresses/hasStreetSuffix> a <http://www.w3.org/2002/07/owl#ObjectProperty> ;
	<http://www.w3.org/2000/01/rdf-schema#domain> <https://spec.edmcouncil.org/fibo/ontology/FND/Places/Addresses/StreetAddress> ;
	<http://www.w3.org/2000/01/rdf-schema#label> "has street suffix" ;
	<http://www.w3.org/2000/01/rdf-schema#range> <https://spec.edmcouncil.org/fibo/ontology/FND/Places/Addresses/StreetSuffix> ;
	<http://www.w3.org/2000/01/rdf-schema#subPropertyOf> <https://www.omg.org/spec/Commons/Collections/comprises> ;
	<http://www.w3.org/2004/02/skos/core#definition> "specifies an additional qualifier for a street or other delivery location, such as a dwelling located along a waterway" .
<https://spec.edmcouncil.org/fibo/ontology/FND/Places/Addresses/hasStructureName> a <http://www.w3.org/2002/07/owl#ObjectProperty> ;
	<http://www.w3.org/2000/01/rdf-schema#domain> <https://spec.edmcouncil.org/fibo/ontology/FND/Places/Addresses/PhysicalAddress> ;
	<http://www.w3.org/2000/01/rdf-schema#label> "has structure name" ;
	<http://www.w3.org/2000/01/rdf-schema#range> <https://spec.edmcouncil.org/fibo/ontology/FND/Places/Addresses/StructureName> ;
	<http://www.w3.org/2000/01/rdf-schema#subPropertyOf> <https://www.omg.org/spec/Commons/Collections/comprises> ;
	<http://www.w3.org/2004/02/skos/core#definition> "specifies an identifier for a building, house, office complex, shopping center, or other structure or group of structures" .
<https://spec.edmcouncil.org/fibo/ontology/FND/Places/Addresses/hasTransliteratedAddress> a <http://www.w3.org/2002/07/owl#ObjectProperty> ;
	<http://www.w3.org/2000/01/rdf-schema#label> "has transliterated address" ;
	<http://www.w3.org/2000/01/rdf-schema#range> <https://spec.edmcouncil.org/fibo/ontology/FND/Places/Addresses/Address> ;
	<http://www.w3.org/2000/01/rdf-schema#subPropertyOf> <https://spec.edmcouncil.org/fibo/ontology/FND/Places/Addresses/hasAddress> ;
	<http://www.w3.org/2004/02/skos/core#definition> "identifies a transliterated (i.e., in Latin or Romanized ASCII) address for the registered entity" ;
	<https://www.omg.org/spec/Commons/AnnotationVocabulary/adaptedFrom> "https://www.gleif.org/en/about-lei/common-data-file-format/lei-cdf-format/lei-cdf-format-version-2-1"^^<http://www.w3.org/2001/XMLSchema#anyURI> .
<https://spec.edmcouncil.org/fibo/ontology/FND/Places/Addresses/requiresSecondaryUnitRange> a <http://www.w3.org/2002/07/owl#DatatypeProperty> ;
	<http://www.w3.org/2000/01/rdf-schema#label> "requires secondary unit range" ;
	<http://www.w3.org/2000/01/rdf-schema#range> <http://www.w3.org/2001/XMLSchema#boolean> ;
	<http://www.w3.org/2000/01/rdf-schema#seeAlso> <https://pe.usps.com/cpim/ftp/pubs/Pub28/pub28.pdf> ;
	<http://www.w3.org/2000/01/rdf-schema#subPropertyOf> <https://www.omg.org/spec/Commons/TextDatatype/hasTextValue> ;
	<http://www.w3.org/2004/02/skos/core#definition> "if true, indicates that an additional qualifier is needed to complete the delivery point description, such as an apartment number" ;
	<https://www.omg.org/spec/Commons/AnnotationVocabulary/explanatoryNote> "Note that in some cases, such as for lobby or office, if there are multiple secondary units then a range may be needed to differentiate between them, even if the range is not always required." .
<https://spec.edmcouncil.org/fibo/ontology/FND/Places/NorthAmerica/USPostalServiceAddresses/CompleteAddress> a <http://www.w3.org/2002/07/owl#Class> ;
	<http://www.w3.org/2000/01/rdf-schema#label> "complete address" ;
	<http://www.w3.org/2000/01/rdf-schema#subClassOf> <https://spec.edmcouncil.org/fibo/ontology/FND/Places/NorthAmerica/USPostalServiceAddresses/StandardizedAddress> ;
	<http://www.w3.org/2004/02/skos/core#definition> "delivery address that has all the address elements necessary to allow an exact match with the current Postal Service ZIP+4 and City State files to obtain the finest level of ZIP+4 and delivery point codes for the delivery address" ;
	<https://www.omg.org/spec/Commons/AnnotationVocabulary/explanatoryNote> "A complete address may be required on mail at some automation rates." .
<https://spec.edmcouncil.org/fibo/ontology/FND/Places/NorthAmerica/USPostalServiceAddresses/DeliveryAddressCodeSet> a <http://www.w3.org/2002/07/owl#Class> ;
	<http://www.w3.org/2000/01/rdf-schema#label> "delivery address code set" ;
	<http://www.w3.org/2000/01/rdf-schema#seeAlso> <https://pe.usps.com/cpim/ftp/pubs/Pub28/pub28.pdf> ;
	<http://www.w3.org/2000/01/rdf-schema#subClassOf> <https://www.omg.org/spec/Commons/CodesAndCodeSets/CodeSet> , <https://www.omg.org/spec/Commons/Identifiers/IdentificationScheme> , _:c14n1109 ;
	<http://www.w3.org/2004/02/skos/core#definition> "system of numeric codes that substitute for specified delivery point details according to the U.S. Postal Service Publication 28" .
<https://spec.edmcouncil.org/fibo/ontology/FND/Places/NorthAmerica/USPostalServiceAddresses/DeliveryPointCode> a <http://www.w3.org/2002/07/owl#Class> ;
	<http://www.w3.org/2000/01/rdf-schema#label> "delivery point code" ;
	<http://www.w3.org/2000/01/rdf-schema#seeAlso> <https://pe.usps.com/cpim/ftp/pubs/Pub28/pub28.pdf> ;
	<http://www.w3.org/2000/01/rdf-schema#subClassOf> <https://www.omg.org/spec/Commons/CodesAndCodeSets/CodeElement> , _:c14n1017 , _:c14n2087 ;
	<http://www.w3.org/2004/02/skos/core#definition> "specific set of digits between 00 and 99 assigned to a delivery point" ;
	<https://www.omg.org/spec/Commons/AnnotationVocabulary/explanatoryNote> "When combined with the ZIP + 4 code, the delivery point code provides a unique identifier for every deliverable address served by the USPS. The delivery point digits are almost never printed on mail in human-readable form; instead they are encoded in the POSTNET delivery point barcode (DPBC) or as part of the newer Intelligent Mail Barcode (IMB)." .
<https://spec.edmcouncil.org/fibo/ontology/FND/Places/NorthAmerica/USPostalServiceAddresses/DeliveryPointCodeSet> a <http://www.w3.org/2002/07/owl#Class> ;
	<http://www.w3.org/2000/01/rdf-schema#label> "delivery point code set" ;
	<http://www.w3.org/2000/01/rdf-schema#seeAlso> <https://pe.usps.com/cpim/ftp/pubs/Pub28/pub28.pdf> ;
	<http://www.w3.org/2000/01/rdf-schema#subClassOf> <https://www.omg.org/spec/Commons/CodesAndCodeSets/CodeSet> , _:c14n3373 ;
	<http://www.w3.org/2004/02/skos/core#definition> "system of numeric codes that substitute for specified delivery point details according to the U.S. Postal Service Publication 28" .
<https://spec.edmcouncil.org/fibo/ontology/FND/Places/NorthAmerica/USPostalServiceAddresses/DepartmentOfStateAddress> a <http://www.w3.org/2002/07/owl#Class> ;
	<http://www.w3.org/2000/01/rdf-schema#label> "Department of State address" ;
	<http://www.w3.org/2000/01/rdf-schema#subClassOf> <https://spec.edmcouncil.org/fibo/ontology/FND/Places/Addresses/PhysicalAddress> , _:c14n1020 , _:c14n3361 , _:c14n337 ;
	<http://www.w3.org/2004/02/skos/core#definition> "delivery address whose delivery address line uses 'UNIT' followed by the unit identifier, followed by 'BOX' followed by box number, in place of a street address, 'DPO' as the literal value for the city, and the appropriate armed forces subdivision code in place of a subdivision (state) code" .
<https://spec.edmcouncil.org/fibo/ontology/FND/Places/NorthAmerica/USPostalServiceAddresses/DepartmentOfStateUnitComponent> a <http://www.w3.org/2002/07/owl#Class> ;
	<http://www.w3.org/2000/01/rdf-schema#label> "Department of State unit component" ;
	<http://www.w3.org/2000/01/rdf-schema#subClassOf> <https://spec.edmcouncil.org/fibo/ontology/FND/Places/Addresses/SupplementalAddressComponent> , _:c14n199 ;
	<http://www.w3.org/2004/02/skos/core#definition> "component of a Department of State address that includes 'UNIT' followed by the unit identifier" .
<https://spec.edmcouncil.org/fibo/ontology/FND/Places/NorthAmerica/USPostalServiceAddresses/East> a <http://www.w3.org/2002/07/owl#NamedIndividual> , <https://spec.edmcouncil.org/fibo/ontology/FND/Places/Addresses/GeographicDirectionalSymbol> ;
	<http://www.w3.org/2000/01/rdf-schema#label> "East"@en , "Este"@es ;
	<http://www.w3.org/2004/02/skos/core#definition> "geographic directional symbol for East" ;
	<https://www.omg.org/spec/Commons/Designators/hasTag> "E" .
<https://spec.edmcouncil.org/fibo/ontology/FND/Places/NorthAmerica/USPostalServiceAddresses/GeneralDeliveryAddress> a <http://www.w3.org/2002/07/owl#Class> ;
	<http://www.w3.org/2000/01/rdf-schema#label> "general delivery address" ;
	<http://www.w3.org/2000/01/rdf-schema#subClassOf> <https://spec.edmcouncil.org/fibo/ontology/FND/Places/Addresses/PhysicalAddress> , _:c14n2610 ;
	<http://www.w3.org/2004/02/skos/core#definition> "delivery address that uses the words 'GENERAL DELIVERY', uppercase preferred, spelled out (no abbreviation), in place of a street address" ;
	<https://www.omg.org/spec/Commons/AnnotationVocabulary/explanatoryNote> "The value of the +4 component of a ZIP+4 code should be '9999'." .
<https://spec.edmcouncil.org/fibo/ontology/FND/Places/NorthAmerica/USPostalServiceAddresses/HighwayContractRoute> a <http://www.w3.org/2002/07/owl#Class> ;
	<http://www.w3.org/2000/01/rdf-schema#label> "highway contract route" ;
	<http://www.w3.org/2000/01/rdf-schema#subClassOf> <https://spec.edmcouncil.org/fibo/ontology/FND/Places/Addresses/SupplementalAddressComponent> , _:c14n2129 ;
	<http://www.w3.org/2004/02/skos/core#definition> "highway contract route associated with an address" .
<https://spec.edmcouncil.org/fibo/ontology/FND/Places/NorthAmerica/USPostalServiceAddresses/HighwayContractRouteAddress> a <http://www.w3.org/2002/07/owl#Class> ;
	<http://www.w3.org/2000/01/rdf-schema#label> "highway contract address" ;
	<http://www.w3.org/2000/01/rdf-schema#subClassOf> <https://spec.edmcouncil.org/fibo/ontology/FND/Places/Addresses/PhysicalAddress> , _:c14n2146 , _:c14n93 ;
	<http://www.w3.org/2004/02/skos/core#definition> "delivery address whose delivery address line uses the abbreviation 'HC', followed by the route identifier, followed by 'BOX' followed by box number, in place of a street address" .
<https://spec.edmcouncil.org/fibo/ontology/FND/Places/NorthAmerica/USPostalServiceAddresses/HighwayContractRouteDesignator> a <http://www.w3.org/2002/07/owl#NamedIndividual> , <https://spec.edmcouncil.org/fibo/ontology/FND/Places/Addresses/SupplementalAddressDesignator> ;
	<http://www.w3.org/2000/01/rdf-schema#label> "highway contract route designator" ;
	<http://www.w3.org/2004/02/skos/core#definition> "designator for a route served by an independent contractor rather than directly by the U.S. Postal Service" ;
	<https://spec.edmcouncil.org/fibo/ontology/FND/Utilities/AnnotationVocabulary/preferredDesignation> "HC" .
<https://spec.edmcouncil.org/fibo/ontology/FND/Places/NorthAmerica/USPostalServiceAddresses/InternationalAddress> a <http://www.w3.org/2002/07/owl#Class> ;
	<http://www.w3.org/2000/01/rdf-schema#label> "international address" ;
	<http://www.w3.org/2000/01/rdf-schema#subClassOf> <https://spec.edmcouncil.org/fibo/ontology/FND/Places/Addresses/PhysicalAddress> ;
	<http://www.w3.org/2002/07/owl#equivalentClass> _:c14n309 ;
	<http://www.w3.org/2004/02/skos/core#definition> "physical address that explicitly includes a country" .
<https://spec.edmcouncil.org/fibo/ontology/FND/Places/NorthAmerica/USPostalServiceAddresses/Mailbox> a <http://www.w3.org/2002/07/owl#Class> ;
	<http://www.w3.org/2000/01/rdf-schema#label> "mailbox" ;
	<http://www.w3.org/2000/01/rdf-schema#subClassOf> <https://spec.edmcouncil.org/fibo/ontology/FND/Places/Addresses/SupplementalAddressComponent> , _:c14n2195 ;
	<http://www.w3.org/2004/02/skos/core#definition> "mailbox, other than a U.S. Post Office box, associated with an address" .
<https://spec.edmcouncil.org/fibo/ontology/FND/Places/NorthAmerica/USPostalServiceAddresses/MailboxDesignator> a <http://www.w3.org/2002/07/owl#NamedIndividual> , <https://spec.edmcouncil.org/fibo/ontology/FND/Places/Addresses/SupplementalAddressDesignator> ;
	<http://www.w3.org/2000/01/rdf-schema#label> "mailbox designator" ;

<http://www.w3.org/ns/prov#qualifiedStart> a <http://www.w3.org/2002/07/owl#ObjectProperty> ;
	<http://www.w3.org/2000/01/rdf-schema#comment> "If this Activity prov:wasStartedBy Entity :e1, then it can qualify how it was started using prov:qualifiedStart [ a prov:Start;  prov:entity :e1; :foo :bar ]."@en ;
	<http://www.w3.org/2000/01/rdf-schema#domain> <http://www.w3.org/ns/prov#Activity> ;
	<http://www.w3.org/2000/01/rdf-schema#isDefinedBy> <http://www.w3.org/ns/prov-o#> ;
	<http://www.w3.org/2000/01/rdf-schema#label> "qualifiedStart" ;
	<http://www.w3.org/2000/01/rdf-schema#range> <http://www.w3.org/ns/prov#Start> ;
	<http://www.w3.org/2000/01/rdf-schema#subPropertyOf> <http://www.w3.org/ns/prov#qualifiedInfluence> ;

	<http://www.w3.org/2004/02/skos/core#prefLabel> "Tobasco Pepper Sauce"@en .
<http://www.co-ode.org/ontologies/pizza/pizza.owl#TomatoTopping> a <http://www.w3.org/2002/07/owl#Class> ;
	<http://www.w3.org/2000/01/rdf-schema#label> "CoberturaDeTomate"@pt , "TomatoTopping"@en ;

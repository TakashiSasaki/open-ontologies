	<https://www.omg.org/spec/Commons/Designators/denotes> <https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSTaxonomy/ACTUSContractType-Collateral> ;
	<https://www.omg.org/spec/Commons/Designators/hasDescription> "A collateral securing the scheduled payment obligations of an underlying instrument" ;
	<https://www.omg.org/spec/Commons/Designators/hasTag> "CEC" ;
	<https://www.omg.org/spec/Commons/Designators/hasTextualName> "Credit Enhancement Collateral" .

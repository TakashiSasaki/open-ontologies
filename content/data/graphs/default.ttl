	<http://www.w3.org/2000/01/rdf-schema#label> "has reference period" ;
	<http://www.w3.org/2000/01/rdf-schema#range> <https://spec.edmcouncil.org/fibo/ontology/FND/DatesAndTimes/FinancialDates/RecurrenceInterval> ;
	<http://www.w3.org/2000/01/rdf-schema#subPropertyOf> <https://spec.edmcouncil.org/fibo/ontology/FND/DatesAndTimes/FinancialDates/hasRecurrenceInterval> ;
	<http://www.w3.org/2004/02/skos/core#definition> "specifies a reference (baseline) recurrence interval for which a given measure applies" .
<https://spec.edmcouncil.org/fibo/ontology/FND/Utilities/Analytics/hasRelativeComparativeDate> a <http://www.w3.org/2002/07/owl#ObjectProperty> ;
	<http://www.w3.org/2000/01/rdf-schema#label> "has relative comparative date" ;

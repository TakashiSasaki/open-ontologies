	<https://www.omg.org/spec/Commons/Designators/hasTag> "CSP" ;
	<https://www.omg.org/spec/Commons/Designators/hasTextualName> "Calculate/Shift preceding" .
<https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSContractTerms/ACTUSBusinessDayConvention-NOS> a <http://www.w3.org/2002/07/owl#NamedIndividual> , <https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSContractTerms/ACTUSBusinessDayConvention> ;
	<http://www.w3.org/2000/01/rdf-schema#label> "ACTUS business day convention - NOS" ;

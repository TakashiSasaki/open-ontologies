<https://spec.edmcouncil.org/fibo/ontology/BE/GovernmentEntities/LatinAmericanJurisdiction/CentralAmericanGovernmentEntitiesAndJurisdictions/GovernmentOfTheRepublicOfGuatemala> a <http://www.w3.org/2002/07/owl#NamedIndividual> , <https://spec.edmcouncil.org/fibo/ontology/BE/GovernmentEntities/GovernmentEntities/NationalGovernment> ;
	<http://www.w3.org/2000/01/rdf-schema#label> "Government of the Republic of Guatemala"@en , "República de Guatemala"@es ;
	<http://www.w3.org/2004/02/skos/core#definition> "unitary presidential and democratic republic that is the most populous country in Central America" ;
	<https://www.omg.org/spec/Commons/RegulatoryAgencies/governs> <https://www.omg.org/spec/LCC/Countries/ISO3166-1-CountryCodes/Guatemala> ;

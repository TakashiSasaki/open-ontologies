	<http://www.w3.org/2004/02/skos/core#prefLabel> "Spinach"@en .
<http://www.co-ode.org/ontologies/pizza/pizza.owl#SultanaTopping> a <http://www.w3.org/2002/07/owl#Class> ;
	<http://www.w3.org/2000/01/rdf-schema#label> "CoberturaSultana"@pt , "SultanaTopping"@en ;
	<http://www.w3.org/2000/01/rdf-schema#subClassOf> <http://www.co-ode.org/ontologies/pizza/pizza.owl#FruitTopping> , _:c14n220 ;

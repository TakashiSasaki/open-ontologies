	<http://www.w3.org/2000/01/rdf-schema#comment> "The _optional_ Generation involved in an Entity's Derivation."@en ;
	<http://www.w3.org/2000/01/rdf-schema#domain> <http://www.w3.org/ns/prov#Derivation> ;
	<http://www.w3.org/2000/01/rdf-schema#isDefinedBy> <http://www.w3.org/ns/prov-o#> ;
	<http://www.w3.org/2000/01/rdf-schema#label> "hadGeneration" ;
	<http://www.w3.org/2000/01/rdf-schema#range> <http://www.w3.org/ns/prov#Generation> ;

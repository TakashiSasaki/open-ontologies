	<http://www.w3.org/2000/01/rdf-schema#label> "ownership control situation" ;
	<http://www.w3.org/2000/01/rdf-schema#subClassOf> <https://www.omg.org/spec/Commons/PartiesAndSituations/Situation> ;
	<http://www.w3.org/2002/07/owl#equivalentClass> _:c14n1260 ;
	<http://www.w3.org/2004/02/skos/core#definition> "situation in which some party owns and controls something" .
<https://spec.edmcouncil.org/fibo/ontology/FND/OwnershipAndControl/OwnershipAndControl/isOwnedAndControlledBy> a <http://www.w3.org/2002/07/owl#ObjectProperty> ;
	<http://www.w3.org/2000/01/rdf-schema#label> "is owned and controlled by" ;
	<http://www.w3.org/2000/01/rdf-schema#range> <https://www.omg.org/spec/Commons/PartiesAndSituations/Party> ;
	<http://www.w3.org/2000/01/rdf-schema#subPropertyOf> <https://spec.edmcouncil.org/fibo/ontology/FND/OwnershipAndControl/Ownership/isOwnedBy> , <https://spec.edmcouncil.org/fibo/ontology/FND/Relations/Relations/isControlledBy> ;
	<http://www.w3.org/2004/02/skos/core#definition> "relates something to the party that owns, influences, manages and directs it" .
<https://spec.edmcouncil.org/fibo/ontology/FND/OwnershipAndControl/OwnershipAndControl/ownsAndControls> a <http://www.w3.org/2002/07/owl#ObjectProperty> ;
	<http://www.w3.org/2000/01/rdf-schema#domain> <https://www.omg.org/spec/Commons/PartiesAndSituations/Party> ;
	<http://www.w3.org/2000/01/rdf-schema#label> "owns and controls" ;
	<http://www.w3.org/2000/01/rdf-schema#subPropertyOf> <https://spec.edmcouncil.org/fibo/ontology/FND/OwnershipAndControl/Ownership/owns> , <https://spec.edmcouncil.org/fibo/ontology/FND/Relations/Relations/controls> ;
	<http://www.w3.org/2002/07/owl#inverseOf> <https://spec.edmcouncil.org/fibo/ontology/FND/OwnershipAndControl/OwnershipAndControl/isOwnedAndControlledBy> ;
	<http://www.w3.org/2004/02/skos/core#definition> "directs and exercises authoritative or dominating influence over some thing that is also owned" ;
	<http://www.w3.org/2004/02/skos/core#editorialNote> "basic rule: if x controls y and x owns y then x owns and controls y\nSWRL rule: controls(?x, ?y), owns(?x, ?y) -> ownsAndControls(?x, ?y)" .
<https://spec.edmcouncil.org/fibo/ontology/FND/Parties/Parties/PartyRoleIdentificationScheme> a <http://www.w3.org/2002/07/owl#Class> ;
	<http://www.w3.org/2000/01/rdf-schema#label> "party role identification scheme" ;

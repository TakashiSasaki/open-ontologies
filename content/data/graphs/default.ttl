	<http://www.w3.org/2000/01/rdf-schema#domain> <https://spec.edmcouncil.org/fibo/ontology/FND/OwnershipAndControl/Ownership/Asset> ;
	<http://www.w3.org/2000/01/rdf-schema#label> "is asset of" ;

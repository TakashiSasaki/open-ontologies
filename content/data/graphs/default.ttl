	a <http://www.w3.org/2002/07/owl#Class> ;
	<http://www.w3.org/2000/01/rdf-schema#isDefinedBy> <https://www.omg.org/spec/LCC/Languages/LanguageRepresentation/> ;
	<http://www.w3.org/2000/01/rdf-schema#label> "script" ;
	<http://www.w3.org/2000/01/rdf-schema#subClassOf> <https://www.omg.org/spec/LCC/Languages/LanguageRepresentation/Collection> ;
	<http://www.w3.org/2004/02/skos/core#definition> "a set of graphic characters used to represent one or more languages in writing" ;
	<http://www.w3.org/2004/02/skos/core#note> "Use of multiple writing systems does not mean that multiple language identifiers are necessary for a language. ISO 639 language identifiers may be combined with script identifiers from ISO 15924 (e.g., BCP 47)." .
<https://www.omg.org/spec/LCC/Languages/LanguageRepresentation/SpecialPurposeCode> <http://purl.org/dc/terms/source> "Section 3.7, ISO 639-3" ;
	a <http://www.w3.org/2002/07/owl#Class> ;

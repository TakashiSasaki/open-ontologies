	<http://www.w3.org/2000/01/rdf-schema#label> "apartment"@en , "apartmento"@es ;
	<http://www.w3.org/2004/02/skos/core#definition> "room or a group of related rooms, among similar sets in one building, designed for use as a dwelling" ;

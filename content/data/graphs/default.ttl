	<http://www.w3.org/2000/01/rdf-schema#label> "basement"@en ;
	<http://www.w3.org/2004/02/skos/core#definition> "part of a building consisting of rooms that are partly or entirely below ground" ;
	<https://spec.edmcouncil.org/fibo/ontology/FND/Places/Addresses/requiresSecondaryUnitRange> false ;
	<https://spec.edmcouncil.org/fibo/ontology/FND/Utilities/AnnotationVocabulary/preferredDesignation> "BSMT" .

	<http://www.w3.org/2000/01/rdf-schema#comment> "The time at which an entity was completely created and is available for use."@en ;
	<http://www.w3.org/2000/01/rdf-schema#domain> <http://www.w3.org/ns/prov#Entity> ;
	<http://www.w3.org/2000/01/rdf-schema#isDefinedBy> <http://www.w3.org/ns/prov-o#> ;
	<http://www.w3.org/2000/01/rdf-schema#label> "generatedAtTime" ;

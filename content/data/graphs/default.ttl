	<http://www.w3.org/2000/01/rdf-schema#label> "Soho"@en , "Soho"@pt ;
	<http://www.w3.org/2000/01/rdf-schema#subClassOf> <http://www.co-ode.org/ontologies/pizza/pizza.owl#NamedPizza> , _:c14n210 , _:c14n211 , _:c14n228 , _:c14n257 , _:c14n26 , _:c14n293 , _:c14n36 ;

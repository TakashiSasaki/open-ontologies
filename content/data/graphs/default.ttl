	<http://www.w3.org/2004/02/skos/core#definition> "a system for writing a language, including the requisite script and character set" .
<https://www.omg.org/spec/LCC/Languages/LanguageRepresentation/WrittenLanguage> <http://purl.org/dc/terms/source> "Section 3.21, ISO 639-4" ;
	a <http://www.w3.org/2002/07/owl#Class> ;
	<http://www.w3.org/2000/01/rdf-schema#isDefinedBy> <https://www.omg.org/spec/LCC/Languages/LanguageRepresentation/> ;
	<http://www.w3.org/2000/01/rdf-schema#label> "written language" ;
	<http://www.w3.org/2000/01/rdf-schema#subClassOf> <https://www.omg.org/spec/LCC/Languages/LanguageRepresentation/Language> ;
	<http://www.w3.org/2004/02/skos/core#definition> "the representation of a language via a writing system, with a relatively normalized orthography" .
<https://www.omg.org/spec/LCC/Languages/LanguageRepresentation/denotes> a <http://www.w3.org/2002/07/owl#ObjectProperty> ;
	<http://www.w3.org/2000/01/rdf-schema#isDefinedBy> <https://www.omg.org/spec/LCC/Languages/LanguageRepresentation/> ;
	<http://www.w3.org/2000/01/rdf-schema#label> "denotes" ;
	<http://www.w3.org/2004/02/skos/core#definition> "serves as a linguistic expression of the notion of, means" .
<https://www.omg.org/spec/LCC/Languages/LanguageRepresentation/has> a <http://www.w3.org/2002/07/owl#ObjectProperty> ;
	<http://www.w3.org/2000/01/rdf-schema#isDefinedBy> <https://www.omg.org/spec/LCC/Languages/LanguageRepresentation/> ;
	<http://www.w3.org/2000/01/rdf-schema#label> "has" ;
	<http://www.w3.org/2004/02/skos/core#definition> "indicates that someone (or something) possesses something, such as a characteristic, attribute, feature, or capability" .
<https://www.omg.org/spec/LCC/Languages/LanguageRepresentation/hasDenotation> a <http://www.w3.org/2002/07/owl#ObjectProperty> ;
	<http://www.w3.org/2000/01/rdf-schema#isDefinedBy> <https://www.omg.org/spec/LCC/Languages/LanguageRepresentation/> ;
	<http://www.w3.org/2000/01/rdf-schema#label> "has denotation" ;
	<http://www.w3.org/2000/01/rdf-schema#subPropertyOf> <https://www.omg.org/spec/LCC/Languages/LanguageRepresentation/has> ;
	<http://www.w3.org/2002/07/owl#inverseOf> <https://www.omg.org/spec/LCC/Languages/LanguageRepresentation/denotes> ;
	<http://www.w3.org/2004/02/skos/core#definition> "has meaning, expresses" .
<https://www.omg.org/spec/LCC/Languages/LanguageRepresentation/hasEarlierForm> a <http://www.w3.org/2002/07/owl#ObjectProperty> ;
	<http://www.w3.org/2000/01/rdf-schema#domain> <https://www.omg.org/spec/LCC/Languages/LanguageRepresentation/Language> ;
	<http://www.w3.org/2000/01/rdf-schema#isDefinedBy> <https://www.omg.org/spec/LCC/Languages/LanguageRepresentation/> ;
	<http://www.w3.org/2000/01/rdf-schema#label> "has earlier form" ;
	<http://www.w3.org/2000/01/rdf-schema#range> <https://www.omg.org/spec/LCC/Languages/LanguageRepresentation/Language> ;
	<http://www.w3.org/2000/01/rdf-schema#subPropertyOf> <https://www.omg.org/spec/LCC/Languages/LanguageRepresentation/has> ;
	<http://www.w3.org/2004/02/skos/core#definition> "relates a language to an earlier form (historically significant) of that same language" .
<https://www.omg.org/spec/LCC/Languages/LanguageRepresentation/hasEnglishName> <http://purl.org/dc/terms/source> "Section 3.4, ISO 639-3" ;
	a <http://www.w3.org/2002/07/owl#DatatypeProperty> ;
	<http://www.w3.org/2000/01/rdf-schema#isDefinedBy> <https://www.omg.org/spec/LCC/Languages/LanguageRepresentation/> ;
	<http://www.w3.org/2000/01/rdf-schema#label> "has English name" ;
	<http://www.w3.org/2000/01/rdf-schema#subPropertyOf> <https://www.omg.org/spec/LCC/Languages/LanguageRepresentation/hasName> ;
	<http://www.w3.org/2004/02/skos/core#definition> "associates a name in English with an individual concept" .
<https://www.omg.org/spec/LCC/Languages/LanguageRepresentation/hasFrenchName> <http://purl.org/dc/terms/source> "Section 3.4, ISO 639-3" ;
	a <http://www.w3.org/2002/07/owl#DatatypeProperty> ;
	<http://www.w3.org/2000/01/rdf-schema#isDefinedBy> <https://www.omg.org/spec/LCC/Languages/LanguageRepresentation/> ;
	<http://www.w3.org/2000/01/rdf-schema#label> "has French name" ;
	<http://www.w3.org/2000/01/rdf-schema#subPropertyOf> <https://www.omg.org/spec/LCC/Languages/LanguageRepresentation/hasName> ;
	<http://www.w3.org/2004/02/skos/core#definition> "associates a name in French with an individual concept" .
<https://www.omg.org/spec/LCC/Languages/LanguageRepresentation/hasGermanName> a <http://www.w3.org/2002/07/owl#DatatypeProperty> ;
	<http://www.w3.org/2000/01/rdf-schema#isDefinedBy> <https://www.omg.org/spec/LCC/Languages/LanguageRepresentation/> ;
	<http://www.w3.org/2000/01/rdf-schema#label> "has German name" ;
	<http://www.w3.org/2000/01/rdf-schema#subPropertyOf> <https://www.omg.org/spec/LCC/Languages/LanguageRepresentation/hasName> ;
	<http://www.w3.org/2004/02/skos/core#definition> "associates a name in German with an individual concept" .
<https://www.omg.org/spec/LCC/Languages/LanguageRepresentation/hasIndigenousName> <http://purl.org/dc/terms/source> "Section 3.4, ISO 639-3" ;
	a <http://www.w3.org/2002/07/owl#DatatypeProperty> ;
	<http://www.w3.org/2000/01/rdf-schema#isDefinedBy> <https://www.omg.org/spec/LCC/Languages/LanguageRepresentation/> ;
	<http://www.w3.org/2000/01/rdf-schema#label> "has indigenous name" ;
	<http://www.w3.org/2000/01/rdf-schema#subPropertyOf> <https://www.omg.org/spec/LCC/Languages/LanguageRepresentation/hasName> ;
	<http://www.w3.org/2004/02/skos/core#definition> "associates a local regional or cultural name with an individual concept" .
<https://www.omg.org/spec/LCC/Languages/LanguageRepresentation/hasMember> a <http://www.w3.org/2002/07/owl#ObjectProperty> ;
	<http://www.w3.org/2000/01/rdf-schema#isDefinedBy> <https://www.omg.org/spec/LCC/Languages/LanguageRepresentation/> ;
	<http://www.w3.org/2000/01/rdf-schema#label> "has member" ;
	<http://www.w3.org/2002/07/owl#inverseOf> <https://www.omg.org/spec/LCC/Languages/LanguageRepresentation/isMemberOf> ;
	<http://www.w3.org/2004/02/skos/core#definition> "relates something, typically a collection, group or organization, to some discrete thing identified as a member of it" .
<https://www.omg.org/spec/LCC/Languages/LanguageRepresentation/hasName> <http://purl.org/dc/terms/source> "Section 3.4, ISO 639-3" ;
	a <http://www.w3.org/2002/07/owl#DatatypeProperty> ;
	<http://www.w3.org/2000/01/rdf-schema#isDefinedBy> <https://www.omg.org/spec/LCC/Languages/LanguageRepresentation/> ;
	<http://www.w3.org/2000/01/rdf-schema#label> "has name" ;
	<http://www.w3.org/2004/02/skos/core#definition> "associates a name, reference name, or appellation with an individual concept" ;
	<http://www.w3.org/2004/02/skos/core#note> "Note that the hasName properties defined herein have an implicit range of rdfs:Literal.  This is purposeful, so that users can specify any element that has a name with or without a language tag without concern for conflicting datatypes (i.e., xsd:string vs. rdf:langString, which are logically disjoint)." .
<https://www.omg.org/spec/LCC/Languages/LanguageRepresentation/hasTag> a <http://www.w3.org/2002/07/owl#DatatypeProperty> ;
	<http://www.w3.org/2000/01/rdf-schema#isDefinedBy> <https://www.omg.org/spec/LCC/Languages/LanguageRepresentation/> ;
	<http://www.w3.org/2000/01/rdf-schema#label> "has tag" ;
	<http://www.w3.org/2000/01/rdf-schema#range> <http://www.w3.org/2001/XMLSchema#string> ;
	<http://www.w3.org/2004/02/skos/core#definition> "a unique combination of alphanumeric characters corresponding to the identifier" ;
	<http://www.w3.org/2004/02/skos/core#note> "Text-valued tags are included here as they may be useful for automated transformation or encoding systems, such as those used to produce IETF compliant language tags in XML." .
<https://www.omg.org/spec/LCC/Languages/LanguageRepresentation/identifies> a <http://www.w3.org/2002/07/owl#ObjectProperty> ;
	<http://www.w3.org/2000/01/rdf-schema#isDefinedBy> <https://www.omg.org/spec/LCC/Languages/LanguageRepresentation/> ;
	<http://www.w3.org/2000/01/rdf-schema#label> "identifies" ;
	<http://www.w3.org/2004/02/skos/core#definition> "recognizes or establishes within some context" .
<https://www.omg.org/spec/LCC/Languages/LanguageRepresentation/isIdentifiedBy> a <http://www.w3.org/2002/07/owl#ObjectProperty> ;
	<http://www.w3.org/2000/01/rdf-schema#isDefinedBy> <https://www.omg.org/spec/LCC/Languages/LanguageRepresentation/> ;
	<http://www.w3.org/2000/01/rdf-schema#label> "is identified by" ;
	<http://www.w3.org/2002/07/owl#inverseOf> <https://www.omg.org/spec/LCC/Languages/LanguageRepresentation/identifies> ;
	<http://www.w3.org/2004/02/skos/core#definition> "has an indicator or label, that is unique within some context" .
<https://www.omg.org/spec/LCC/Languages/LanguageRepresentation/isMemberOf> a <http://www.w3.org/2002/07/owl#ObjectProperty> ;
	<http://www.w3.org/2000/01/rdf-schema#isDefinedBy> <https://www.omg.org/spec/LCC/Languages/LanguageRepresentation/> ;
	<http://www.w3.org/2000/01/rdf-schema#label> "is member of" ;
	<http://www.w3.org/2004/02/skos/core#definition> "belongs, either individually or collectively, to a group" .
<https://www.omg.org/spec/MVF/MultipleVocabularyFacility/Abbreviation> a <http://www.w3.org/2002/07/owl#Class> ;
	<http://www.w3.org/2002/07/owl#deprecated> true ;
	<http://www.w3.org/2002/07/owl#equivalentClass> <https://www.omg.org/spec/MVF/MultipleVocabularyFacility/VocabularyEntry> .
<https://www.omg.org/spec/MVF/MultipleVocabularyFacility/Community> a <http://www.w3.org/2002/07/owl#Class> ;
	<http://www.w3.org/2000/01/rdf-schema#label> "community" ;
	<http://www.w3.org/2000/01/rdf-schema#subClassOf> <https://www.omg.org/spec/MVF/MultipleVocabularyFacility/MVFElement> , _:c14n1847 ;
	<http://www.w3.org/2004/02/skos/core#definition> "group of individuals that share a natural language and have a shared set of terms used to express concepts in their domain of interest" ;
	<http://www.w3.org/2004/02/skos/core#note> "We refer to a set of terms that is distinguished from general use of the natural language as a vernacular. The community may include people that share a profession, are members of the same enterprise or organization or are collaborating on a particular technology." .
<https://www.omg.org/spec/MVF/MultipleVocabularyFacility/MVFDictionary> a <http://www.w3.org/2002/07/owl#Class> ;
	<http://www.w3.org/2000/01/rdf-schema#label> "MVF dictionary" ;
	<http://www.w3.org/2000/01/rdf-schema#subClassOf> <https://www.omg.org/spec/Commons/Collections/StructuredCollection> , <https://www.omg.org/spec/MVF/MultipleVocabularyFacility/MVFElement> , _:c14n2227 , _:c14n250 ;
	<http://www.w3.org/2004/02/skos/core#definition> "collection (by reference, or possibly inclusion) of vocabularies that share a set of MVFEntries" ;
	<http://www.w3.org/2004/02/skos/core#note> "Each vocabulary is a container for vocabulary entries that each represent the association of a term in that vocabulary with one of the MVFEntries identified in that dictionary. A modeling environment may include multiple dictionaries, but they must address mutually exclusive concepts. Typically, one dictionary will address concepts of the modeling language metamodel, and another dictionary will address concepts of user-defined modeling elements." .
<https://www.omg.org/spec/MVF/MultipleVocabularyFacility/MVFElement> a <http://www.w3.org/2002/07/owl#Class> ;
	<http://www.w3.org/2000/01/rdf-schema#label> "MVF element" ;
	<http://www.w3.org/2000/01/rdf-schema#subClassOf> _:c14n2452 , _:c14n271 , _:c14n3491 , _:c14n742 ;
	<http://www.w3.org/2004/02/skos/core#definition> "abstract entity in a multiple vocabulary facility model or ontology" ;
	<https://www.omg.org/spec/Commons/AnnotationVocabulary/explanatoryNote> "An MVF element corresponds roughly to an element in category theory, namely one that can be an object of any category, and to 'entity' in many top level ontologies." ;
	<https://www.omg.org/spec/Commons/AnnotationVocabulary/usageNote> "Typically there will be exactly one URI, description, and name for a term, but issues arise when the same term is intentionally duplicated across controlled vocabularies, which happens from time to time in bioinformatics, for example." , "Use the Dublin Core 'references' annotation for any relevant citations or other references, corresponding to the 'reference' property in the MVF metamodel." .
<https://www.omg.org/spec/MVF/MultipleVocabularyFacility/MVFEntry> <http://purl.org/dc/terms/source> "ISO 1087 Terminology work and terminology science - Vocabulary, Second edition, 2019-09, clause 3.2.7" ;
	a <http://www.w3.org/2002/07/owl#Class> ;
	<http://www.w3.org/2000/01/rdf-schema#label> "MVF entry" ;
	<http://www.w3.org/2000/01/rdf-schema#subClassOf> <https://www.omg.org/spec/MVF/MultipleVocabularyFacility/MVFElement> , _:c14n1009 , _:c14n1373 , _:c14n20 , _:c14n2284 , _:c14n293 ;
	<http://www.w3.org/2004/02/skos/core#definition> "unit of knowledge created by a unique combination of characteristics" ;
	<http://www.w3.org/2004/02/skos/core#note> "An MVF entry is linked to one or more model elements that represent that concept in the modeling environment." , "Concepts [MVF entries] are not necessarily bound to particular natural languages. They are, however, influenced by the social or cultural background which often leads to different categorizations." , "From an ISO 1087 perspective, this is the concept 'concept' as used and designated by the term 'concept' in terminology work. It is a very different concept from that designated by other domains such as industrial automation or marketing." , "Note that instances of a class will all reference the same class name and will all have attributes and associations with the same names. It is possible that not every concept is mapped to an entry in every vocabulary, or that not all of the terms and definitions are associated with model elements in the active modeling environment." .
<https://www.omg.org/spec/MVF/MultipleVocabularyFacility/TermStatus> a <http://www.w3.org/2002/07/owl#Class> ;
	<http://www.w3.org/2000/01/rdf-schema#label> "term status" ;
	<http://www.w3.org/2000/01/rdf-schema#subClassOf> <https://www.omg.org/spec/Commons/Classifiers/Classifier> , <https://www.omg.org/spec/MVF/MultipleVocabularyFacility/MVFElement> ;
	<http://www.w3.org/2004/02/skos/core#definition> "classifier for the standing of a term within its vocabulary" .
<https://www.omg.org/spec/MVF/MultipleVocabularyFacility/Vocabulary> a <http://www.w3.org/2002/07/owl#Class> ;
	<http://www.w3.org/2000/01/rdf-schema#label> "vocabulary" ;
	<http://www.w3.org/2000/01/rdf-schema#subClassOf> <https://www.omg.org/spec/Commons/Collections/StructuredCollection> , <https://www.omg.org/spec/MVF/MultipleVocabularyFacility/MVFElement> , _:c14n1591 , _:c14n2 , _:c14n2598 , _:c14n479 ;
	<http://www.w3.org/2004/02/skos/core#definition> "set of representations of concepts (terms and definitions) for the language of a particular speech community that is expressed in a specified natural language" ;
	<http://www.w3.org/2004/02/skos/core#editorialNote> "This representation does not address the ordering of imports, which may require an intervening class that has an attribute that is an ordinal number representing the ordering." ;
	<http://www.w3.org/2004/02/skos/core#note> "A speech community may create a vocabulary by specializing an existing vocabulary and overriding selected terms, adding terms for new concepts and incorporating the remaining terms and definitions of the existing vocabulary. This mechanism may be employed to introduce synonyms as the primary terms of the specializing community. Both vocabularies should be in the same natural language so that definitions remain meaningful." .
<https://www.omg.org/spec/MVF/MultipleVocabularyFacility/VocabularyEntry> a <http://www.w3.org/2002/07/owl#Class> ;
	<http://www.w3.org/2000/01/rdf-schema#label> "vocabulary entry" ;
	<http://www.w3.org/2000/01/rdf-schema#subClassOf> <https://www.omg.org/spec/Commons/Designators/Designation> , <https://www.omg.org/spec/MVF/MultipleVocabularyFacility/MVFElement> , _:c14n1177 , _:c14n1234 , _:c14n2832 , _:c14n3044 , _:c14n508 , _:c14n594 , _:c14n64 ;
	<http://www.w3.org/2004/02/skos/core#definition> "element of a vocabulary (designation) that denotes at most one concept (MVF entry) in the context of that vocabulary" ;
	<http://www.w3.org/2004/02/skos/core#note> "The definition and term(s) are expressed in the natural language associated with that vocabulary and the associated user community." .
<https://www.omg.org/spec/MVF/MultipleVocabularyFacility/Workspace> a <http://www.w3.org/2002/07/owl#Class> ;
	<http://www.w3.org/2000/01/rdf-schema#label> "workspace" ;
	<http://www.w3.org/2000/01/rdf-schema#subClassOf> <https://www.omg.org/spec/Commons/Collections/Collection> , <https://www.omg.org/spec/MVF/MultipleVocabularyFacility/MVFElement> , _:c14n2479 , _:c14n634 ;
	<http://www.w3.org/2004/02/skos/core#definition> "a set of consistent MVF dictionaries and vocabularies which can be activated in a modeling environment" .
<https://www.omg.org/spec/MVF/MultipleVocabularyFacility/abbreviates> a <http://www.w3.org/2002/07/owl#ObjectProperty> ;
	<http://www.w3.org/2000/01/rdf-schema#domain> _:c14n1559 ;
	<http://www.w3.org/2000/01/rdf-schema#label> "abbreviates" ;
	<http://www.w3.org/2000/01/rdf-schema#subPropertyOf> <https://www.omg.org/spec/Commons/Designators/denotes> ;
	<http://www.w3.org/2004/02/skos/core#definition> "is a shortened designation for a term that is used synonymously with that term in the context of a given vocabulary or dictionary" .
<https://www.omg.org/spec/MVF/MultipleVocabularyFacility/hasAbbreviation> a <http://www.w3.org/2002/07/owl#ObjectProperty> ;
	<http://www.w3.org/2000/01/rdf-schema#label> "has abbreviation" ;
	<http://www.w3.org/2000/01/rdf-schema#range> _:c14n2898 ;
	<http://www.w3.org/2000/01/rdf-schema#subPropertyOf> <https://www.omg.org/spec/Commons/Designators/isSignifiedBy> ;
	<http://www.w3.org/2002/07/owl#inverseOf> <https://www.omg.org/spec/MVF/MultipleVocabularyFacility/abbreviates> ;
	<http://www.w3.org/2004/02/skos/core#definition> "has a shortened designation used synonymously in the context of the given vocabulary or dictionary" .
<https://www.omg.org/spec/MVF/MultipleVocabularyFacility/hasBroaderEntry> a <http://www.w3.org/2002/07/owl#ObjectProperty> ;
	<http://www.w3.org/2000/01/rdf-schema#label> "has broader entry" ;
	<http://www.w3.org/2004/02/skos/core#definition> "has a more general MVF entry than the subject" .
<https://www.omg.org/spec/MVF/MultipleVocabularyFacility/hasContextualEntry> a <http://www.w3.org/2002/07/owl#ObjectProperty> ;
	<http://www.w3.org/2000/01/rdf-schema#label> "has contextual entry" ;
	<http://www.w3.org/2000/01/rdf-schema#range> <https://www.omg.org/spec/MVF/MultipleVocabularyFacility/MVFEntry> ;
	<http://www.w3.org/2000/01/rdf-schema#subPropertyOf> <https://www.omg.org/spec/Commons/ContextualDesignators/isApplicableIn> ;
	<http://www.w3.org/2004/02/skos/core#definition> "scopes in the context of" .
<https://www.omg.org/spec/MVF/MultipleVocabularyFacility/hasCurrentMVFEntry> a <http://www.w3.org/2002/07/owl#ObjectProperty> ;
	<http://www.w3.org/2000/01/rdf-schema#label> "has current MVF entry" ;
	<http://www.w3.org/2000/01/rdf-schema#range> <https://www.omg.org/spec/MVF/MultipleVocabularyFacility/MVFEntry> ;
	<http://www.w3.org/2000/01/rdf-schema#subPropertyOf> <https://www.omg.org/spec/MVF/MultipleVocabularyFacility/hasMVFEntry> ;
	<http://www.w3.org/2004/02/skos/core#definition> "indicates the applicable MVF entry from the active MVF workspace" ;
	<http://www.w3.org/2004/02/skos/core#note> "This property will be implicitly updated when the current workspace changes." .
<https://www.omg.org/spec/MVF/MultipleVocabularyFacility/hasDescriptiveReference> a <http://www.w3.org/2002/07/owl#DatatypeProperty> ;
	<http://www.w3.org/2000/01/rdf-schema#label> "has descriptive reference" ;
	<http://www.w3.org/2000/01/rdf-schema#range> <http://www.w3.org/2001/XMLSchema#anyURI> ;
	<http://www.w3.org/2000/01/rdf-schema#subPropertyOf> <https://www.omg.org/spec/Commons/Organizations/hasURL> ;
	<http://www.w3.org/2004/02/skos/core#definition> "links to any relevant resources that provide further information about the element" .
<https://www.omg.org/spec/MVF/MultipleVocabularyFacility/hasLanguage> a <http://www.w3.org/2002/07/owl#ObjectProperty> ;
	<http://www.w3.org/2002/07/owl#deprecated> true .
<https://www.omg.org/spec/MVF/MultipleVocabularyFacility/hasMVFEntry> a <http://www.w3.org/2002/07/owl#ObjectProperty> ;
	<http://www.w3.org/2000/01/rdf-schema#label> "has MVF entry" ;
	<http://www.w3.org/2000/01/rdf-schema#range> <https://www.omg.org/spec/MVF/MultipleVocabularyFacility/MVFEntry> ;
	<http://www.w3.org/2004/02/skos/core#altLabel> "has multiple vocabulary facility entry" ;
	<http://www.w3.org/2004/02/skos/core#definition> "links a model element to the corresponding MVF entry (concept), providing a name and definition for that model element" ;
	<http://www.w3.org/2004/02/skos/core#note> "There could be many of these in different dictionaries." ;
	<https://www.omg.org/spec/Commons/AnnotationVocabulary/explanatoryNote> "hasMVFEntry is a property used to relate an element in any model to a corresponding MVF entry. It corresponds to the property ElementEntry in the metamodel. That property has a UML Element in its domain, which cannot be modeled in the ontology." .
<https://www.omg.org/spec/MVF/MultipleVocabularyFacility/hasNarrowerEntry> a <http://www.w3.org/2002/07/owl#ObjectProperty> ;
	<http://www.w3.org/2000/01/rdf-schema#label> "has narrower entry" ;
	<http://www.w3.org/2002/07/owl#inverseOf> <https://www.omg.org/spec/MVF/MultipleVocabularyFacility/hasBroaderEntry> ;
	<http://www.w3.org/2004/02/skos/core#definition> "has a more specialized MVF entry than the subject" .
<https://www.omg.org/spec/MVF/MultipleVocabularyFacility/hasSemanticReference> a <http://www.w3.org/2002/07/owl#DatatypeProperty> ;
	<http://www.w3.org/2000/01/rdf-schema#label> "has semantic reference" ;
	<http://www.w3.org/2000/01/rdf-schema#range> <http://www.w3.org/2001/XMLSchema#string> ;
	<http://www.w3.org/2000/01/rdf-schema#subPropertyOf> <https://www.omg.org/spec/Commons/TextDatatype/hasTextValue> ;
	<http://www.w3.org/2004/02/skos/core#definition> "has relevant reference that provides meaning but is not explicitly part of the vocabulary (i.e., document, web site, or other resource)" ;

	<http://www.w3.org/2000/01/rdf-schema#label> "CoberturaDeTomateRessecadoAoSol"@pt , "SundriedTomatoTopping"@en ;
	<http://www.w3.org/2000/01/rdf-schema#subClassOf> <http://www.co-ode.org/ontologies/pizza/pizza.owl#TomatoTopping> , _:c14n154 ;
	<http://www.w3.org/2004/02/skos/core#prefLabel> "Sundried Tomato"@en .
<http://www.co-ode.org/ontologies/pizza/pizza.owl#SweetPepperTopping> a <http://www.w3.org/2002/07/owl#Class> ;
	<http://www.w3.org/2000/01/rdf-schema#label> "CoberturaDePimentaoDoce"@pt , "SweetPepperTopping"@en ;

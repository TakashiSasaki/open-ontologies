	<http://www.w3.org/2000/01/rdf-schema#domain> <https://spec.edmcouncil.org/fibo/ontology/DER/DerivativesContracts/ExoticOptions/BarrierOption> ;
	<http://www.w3.org/2000/01/rdf-schema#label> "has monitoring period"@en ;

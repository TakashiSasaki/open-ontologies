	<http://www.w3.org/2002/07/owl#disjointWith> <https://www.omg.org/spec/LCC/Languages/LanguageRepresentation/SpecialPurposeCode> ;
	<http://www.w3.org/2004/02/skos/core#definition> "a language identifier whose scope is that of a macrolanguage" .
<https://www.omg.org/spec/LCC/Languages/LanguageRepresentation/NaturalLanguage> <http://purl.org/dc/terms/source> "Section 3.27, ISO 639-4" ;
	a <http://www.w3.org/2002/07/owl#Class> ;
	<http://www.w3.org/2000/01/rdf-schema#isDefinedBy> <https://www.omg.org/spec/LCC/Languages/LanguageRepresentation/> ;
	<http://www.w3.org/2000/01/rdf-schema#label> "natural language" ;
	<http://www.w3.org/2000/01/rdf-schema#subClassOf> <https://www.omg.org/spec/LCC/Languages/LanguageRepresentation/Language> ;
	<http://www.w3.org/2004/02/skos/core#definition> "a language used in human communications that is not artificial in nature" .
<https://www.omg.org/spec/LCC/Languages/LanguageRepresentation/Orthography> <http://purl.org/dc/terms/source> "Section 3.27, ISO 639-4" ;
	a <http://www.w3.org/2002/07/owl#Class> ;
	<http://www.w3.org/2000/01/rdf-schema#isDefinedBy> <https://www.omg.org/spec/LCC/Languages/LanguageRepresentation/> ;
	<http://www.w3.org/2000/01/rdf-schema#label> "orthography" ;
